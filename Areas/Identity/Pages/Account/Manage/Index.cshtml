@page
@model IndexModel
@{
    ViewData["Title"] = "Profile";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    var alertClass = Model.StatusMessage.StartsWith("Error") ? "alert-danger" : "alert-success";
    var icon = Model.StatusMessage.StartsWith("Error") ? "bi-exclamation-circle" : "bi-check-circle";
    <div class="alert @alertClass manage-status-msg d-flex align-items-center" role="alert">
        <i class="bi @icon me-2"></i> @Model.StatusMessage
    </div>
}

<h5><i class="bi bi-person me-2" style="opacity:.5"></i>Profile Information</h5>
<p class="section-desc">Update your display name and phone number. Your email address is used for sign-in and cannot be changed here.</p>

<form id="profile-form" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" style="font-size:.85rem;"></div>

    <div class="row g-3">
        <div class="col-md-6">
            <label asp-for="Input.UserName" class="form-label">Display Name</label>
            <div class="input-group">
                <span class="input-group-text border-end-0" style="background:#f8fafc;border-radius:10px 0 0 10px;border:1.5px solid #e2e8f0;border-right:none;">
                    <i class="bi bi-person text-muted"></i>
                </span>
                <input asp-for="Input.UserName" class="form-control border-start-0" style="border-radius:0 10px 10px 0;" placeholder="e.g. John Doe" />
            </div>
            <span asp-validation-for="Input.UserName" class="text-danger" style="font-size:.8rem;"></span>
        </div>

        <div class="col-md-6">
            <label class="form-label">Email</label>
            <div class="input-group">
                <span class="input-group-text border-end-0" style="background:#f8fafc;border-radius:10px 0 0 10px;border:1.5px solid #e2e8f0;border-right:none;">
                    <i class="bi bi-envelope text-muted"></i>
                </span>
                <input class="form-control border-start-0" style="border-radius:0 10px 10px 0;" value="@Model.Email" readonly />
            </div>
            <small class="text-muted" style="font-size:.75rem;">Managed under the Email tab</small>
        </div>

        <div class="col-md-6">
            <label asp-for="Input.PhoneNumber" class="form-label">Phone Number</label>
            <div class="input-group">
                <span class="input-group-text border-end-0" style="background:#f8fafc;border-radius:10px 0 0 10px;border:1.5px solid #e2e8f0;border-right:none;">
                    <i class="bi bi-telephone text-muted"></i>
                </span>
                <input asp-for="Input.PhoneNumber" class="form-control border-start-0" style="border-radius:0 10px 10px 0;" placeholder="e.g. +63 912 345 6789" />
            </div>
            <span asp-validation-for="Input.PhoneNumber" class="text-danger" style="font-size:.8rem;"></span>
        </div>
    </div>

    <hr class="my-4" style="border-color:#e2e8f0;" />

    <div class="d-flex justify-content-end">
        <button id="update-profile-button" type="submit" class="btn btn-manage-save">
            <i class="bi bi-check2 me-1"></i>Save Changes
        </button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
