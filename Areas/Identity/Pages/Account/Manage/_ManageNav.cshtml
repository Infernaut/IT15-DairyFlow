@using IT15_DairyFlow.Models
@inject SignInManager<ApplicationUser> SignInManager
@{
    var hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
}
<nav>
    <a class="manage-nav-link @(ManageNavPages.IndexNavClass(ViewContext) == "active" ? "active" : "")" asp-page="./Index">
        <i class="bi bi-person"></i> Profile
    </a>
    <a class="manage-nav-link @(ManageNavPages.EmailNavClass(ViewContext) == "active" ? "active" : "")" asp-page="./Email">
        <i class="bi bi-envelope"></i> Email
    </a>
    <a class="manage-nav-link @(ManageNavPages.ChangePasswordNavClass(ViewContext) == "active" ? "active" : "")" asp-page="./ChangePassword">
        <i class="bi bi-key"></i> Password
    </a>
    @if (hasExternalLogins)
    {
        <a class="manage-nav-link @(ManageNavPages.ExternalLoginsNavClass(ViewContext) == "active" ? "active" : "")" asp-page="./ExternalLogins">
            <i class="bi bi-link-45deg"></i> External Logins
        </a>
    }
    <a class="manage-nav-link @(ManageNavPages.TwoFactorAuthenticationNavClass(ViewContext) == "active" ? "active" : "")" asp-page="./TwoFactorAuthentication">
        <i class="bi bi-shield-lock"></i> Two-factor Auth
    </a>
    <a class="manage-nav-link @(ManageNavPages.PersonalDataNavClass(ViewContext) == "active" ? "active" : "")" asp-page="./PersonalData">
        <i class="bi bi-database"></i> Personal Data
    </a>
</nav>
