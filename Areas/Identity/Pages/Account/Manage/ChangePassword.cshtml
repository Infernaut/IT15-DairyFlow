@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Change Password";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    var alertClass = Model.StatusMessage.StartsWith("Error") ? "alert-danger" : "alert-success";
    var icon = Model.StatusMessage.StartsWith("Error") ? "bi-exclamation-circle" : "bi-check-circle";
    <div class="alert @alertClass manage-status-msg d-flex align-items-center" role="alert">
        <i class="bi @icon me-2"></i> @Model.StatusMessage
    </div>
}

<h5><i class="bi bi-key me-2" style="opacity:.5"></i>Change Password</h5>
<p class="section-desc">Update your password to keep your account secure. Use a strong mix of letters, numbers, and symbols.</p>

<form id="change-password-form" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" style="font-size:.85rem;"></div>

    <div class="row g-3">
        <div class="col-md-8">
            <label asp-for="Input.OldPassword" class="form-label">Current Password</label>
            <div class="input-group">
                <span class="input-group-text border-end-0" style="background:#f8fafc;border-radius:10px 0 0 10px;border:1.5px solid #e2e8f0;border-right:none;">
                    <i class="bi bi-lock text-muted"></i>
                </span>
                <input asp-for="Input.OldPassword" class="form-control border-start-0" style="border-radius:0 10px 10px 0;" autocomplete="current-password" />
            </div>
            <span asp-validation-for="Input.OldPassword" class="text-danger" style="font-size:.8rem;"></span>
        </div>

        <div class="col-md-8">
            <label asp-for="Input.NewPassword" class="form-label">New Password</label>
            <div class="input-group">
                <span class="input-group-text border-end-0" style="background:#f8fafc;border-radius:10px 0 0 10px;border:1.5px solid #e2e8f0;border-right:none;">
                    <i class="bi bi-lock-fill text-muted"></i>
                </span>
                <input asp-for="Input.NewPassword" class="form-control border-start-0" style="border-radius:0 10px 10px 0;" autocomplete="new-password" />
            </div>
            <span asp-validation-for="Input.NewPassword" class="text-danger" style="font-size:.8rem;"></span>
        </div>

        <div class="col-md-8">
            <label asp-for="Input.ConfirmPassword" class="form-label">Confirm New Password</label>
            <div class="input-group">
                <span class="input-group-text border-end-0" style="background:#f8fafc;border-radius:10px 0 0 10px;border:1.5px solid #e2e8f0;border-right:none;">
                    <i class="bi bi-check-circle text-muted"></i>
                </span>
                <input asp-for="Input.ConfirmPassword" class="form-control border-start-0" style="border-radius:0 10px 10px 0;" autocomplete="new-password" />
            </div>
            <span asp-validation-for="Input.ConfirmPassword" class="text-danger" style="font-size:.8rem;"></span>
        </div>
    </div>

    <hr class="my-4" style="border-color:#e2e8f0;" />

    <div class="d-flex justify-content-end">
        <button type="submit" class="btn btn-manage-save">
            <i class="bi bi-shield-check me-1"></i>Update Password
        </button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
