@page
@model LoginModel

@{
    ViewData["Title"] = "System Access";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>
    :root {
        --blue-main: #0d6efd;
        --blue-soft: #4dabf7;
        --blue-sky: #e7f3ff;
        --blue-deep: #0b5ed7;
        --green-accent: #20c997; /* Matches Register side theme */
        --border-soft: #dbe7f3;
    }

    body {
        background: linear-gradient(180deg, #f8fbff, #eef6ff);
        min-height: 100vh;
    }

    .login-container {
        max-width: 900px;
        margin-top: 5rem;
    }

    .login-card {
        background: #ffffff;
        border-radius: 24px;
        border: 1px solid var(--border-soft);
        overflow: hidden;
        box-shadow: 0 20px 40px rgba(13, 110, 253, 0.08);
    }

    .login-brand-side {
        /* Gradient updated to include a hint of the register page's green for brand unity */
        background: linear-gradient(135deg, var(--blue-main), var(--blue-deep), var(--green-accent));
        padding: 3rem;
        color: white;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        position: relative;
    }

        /* Decorative glass circles for an "on-par" modern feel */
        .login-brand-side::before {
            content: "";
            position: absolute;
            width: 150px;
            height: 150px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 50%;
            top: -50px;
            left: -50px;
        }

    .brand-icon {
        font-size: 5rem;
        margin-bottom: 1rem;
        filter: drop-shadow(0 4px 10px rgba(0,0,0,0.2));
        z-index: 2;
    }

    .float-icon {
        animation: floatIcon 4s ease-in-out infinite;
    }

    @@keyframes floatIcon {
        0%, 100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-10px);
        }
    }

    .form-section {
        padding: 3rem;
    }

    .btn-login {
        background: linear-gradient(135deg, var(--blue-soft), var(--blue-main));
        border: none;
        padding: 0.8rem;
        font-weight: 600;
        transition: all 0.3s ease;
    }

        .btn-login:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(13, 110, 253, 0.3);
        }

    .form-floating > .form-control:focus {
        border-color: var(--blue-soft);
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.1);
    }

    .links-area a {
        text-decoration: none;
        font-size: 0.85rem;
        color: var(--blue-main);
        transition: color 0.2s;
        font-weight: 500;
    }

        .links-area a:hover {
            color: var(--blue-deep);
            text-decoration: underline;
        }

    /* Standardizes the blue square fix across all pages */
    .bi {
        display: inline-block !important;
        line-height: 1;
    }
</style>

<div class="container login-container">
    <div class="login-card shadow-lg">
        <div class="row g-0">
            <div class="col-lg-5 login-brand-side text-center">
                <div class="float-icon">
                    <i class="bi bi-droplet-half brand-icon"></i>
                </div>
                <h2 class="fw-bold">DairyFlow</h2>
                <p class="opacity-75">Secure ERP Gateway</p>
                <div class="mt-4 p-2 bg-white bg-opacity-10 rounded-pill small">
                    <i class="bi bi-shield-lock-fill me-1"></i> Personnel Access Only
                </div>
                <div class="mt-auto pt-4 small opacity-50">
                    v3.0.26 <br />
                    Full Traceability Guaranteed
                </div>
            </div>

            <div class="col-lg-7 form-section">
                <h3 class="fw-bold text-primary mb-2">Welcome Back</h3>
                <p class="text-muted mb-4">Please enter your credentials to access the system.</p>

                <form id="account" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3" role="alert"></div>

                    <div class="form-floating mb-3">
                        <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                        <label asp-for="Input.Email" class="text-muted">Email Address</label>
                        <span asp-validation-for="Input.Email" class="text-danger small"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="password" />
                        <label asp-for="Input.Password" class="text-muted">Password</label>
                        <span asp-validation-for="Input.Password" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="form-check">
                            <input class="form-check-input" asp-for="Input.RememberMe" />
                            <label asp-for="Input.RememberMe" class="form-check-label text-muted small">
                                @Html.DisplayNameFor(m => m.Input.RememberMe)
                            </label>
                        </div>
                        <a id="forgot-password" asp-page="./ForgotPassword" class="small text-primary text-decoration-none fw-medium">Forgot Password?</a>
                    </div>

                    <button id="login-submit" type="submit" class="w-100 btn btn-lg btn-primary btn-login mb-4">
                        <i class="bi bi-unlock-fill me-2"></i> Secure Login
                    </button>

                    <div class="links-area text-center border-top pt-3">
                        <p class="mb-1 text-muted small">New to DairyFlow?</p>
                        <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="fw-bold">Request Staff Registration</a>
                        <div class="mt-2">
                            <a id="resend-confirmation" asp-page="./ResendEmailConfirmation" class="opacity-75">Resend email confirmation</a>
                        </div>
                    </div>
                </form>

                @if ((Model.ExternalLogins?.Count ?? 0) > 0)
                {
                    <div class="mt-4 pt-3 border-top">
                        <p class="text-center text-muted small mb-3">Or sign in with SSO</p>
                        <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                            <div class="d-flex justify-content-center gap-2">
                                @foreach (var provider in Model.ExternalLogins!)
                                {
                                    <button type="submit" class="btn btn-outline-secondary w-100 py-2" name="provider" value="@provider.Name">
                                        @provider.DisplayName
                                    </button>
                                }
                            </div>
                        </form>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}