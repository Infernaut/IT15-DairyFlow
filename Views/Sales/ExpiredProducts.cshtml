@model IT15_DairyFlow.Models.Sales.ExpiredProductsPageViewModel

@{
    ViewData["Title"] = "Expired Products";
}

<div class="container-fluid p-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1 fw-bold">Expired Products</h2>
            <p class="text-muted mb-0">Manage and deduct expired inventory items.</p>
        </div>
    </div>

    <!-- Summary -->
    <div class="row g-4 mb-4">
        <div class="col-lg-4 col-md-6">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="rounded-circle bg-danger bg-opacity-10 p-3 me-3">
                            <i class="bi bi-exclamation-triangle text-danger fs-4"></i>
                        </div>
                        <div>
                            <h6 class="text-muted mb-1 small text-uppercase">Expired Items</h6>
                            <h3 class="mb-0 fw-bold text-danger">@Model.TotalExpiredItems</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-4 col-md-6">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="rounded-circle bg-warning bg-opacity-10 p-3 me-3">
                            <i class="bi bi-box-seam text-warning fs-4"></i>
                        </div>
                        <div>
                            <h6 class="text-muted mb-1 small text-uppercase">Total Expired Qty</h6>
                            <h3 class="mb-0 fw-bold text-warning">@Model.TotalExpiredQuantity</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Expired Products Table -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            @if (Model.Items.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="px-4">Product</th>
                                <th>Type</th>
                                <th>Qty on Hand</th>
                                <th>Expiry Date</th>
                                <th>Days Expired</th>
                                <th>Added By</th>
                                @if (User.IsInRole("Admin") || User.IsInRole("ProductManager"))
                                {
                                    <th class="text-end px-4">Actions</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td class="px-4 fw-semibold">@item.ProductName</td>
                                    <td><span class="badge bg-secondary">@item.ProductType</span></td>
                                    <td>
                                        <span class="fw-semibold text-danger">@item.Quantity</span>
                                    </td>
                                    <td>@(item.Expiry?.ToString("MMM dd, yyyy") ?? "N/A")</td>
                                    <td>
                                        <span class="badge bg-danger">@item.DaysExpired day@(item.DaysExpired != 1 ? "s" : "")</span>
                                    </td>
                                    <td>@item.UserName</td>
                                    @if (User.IsInRole("Admin") || User.IsInRole("ProductManager"))
                                    {
                                        <td class="text-end px-4">
                                            <button class="btn btn-sm btn-outline-danger"
                                                    onclick="openDeductModal(@item.InventoryID, '@item.ProductName', @item.Quantity)"
                                                    title="Deduct Expired Stock">
                                                <i class="bi bi-dash-circle me-1"></i> Deduct
                                            </button>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center text-muted py-5">
                    <i class="bi bi-check-circle display-4 d-block mb-3 opacity-25 text-success"></i>
                    <p class="mb-0">No expired products found. Great job!</p>
                </div>
            }
        </div>
    </div>
</div>

<!-- Deduct Expired Modal -->
<div class="modal fade" id="deductModal" tabindex="-1">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-dash-circle me-2 text-danger"></i>Deduct Expired</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="deductForm" novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="deductInventoryId" />
                    <p class="mb-2">Product: <strong id="deductProductName"></strong></p>
                    <p class="mb-3 text-muted">On-hand: <span id="deductOnHand" class="fw-bold text-danger"></span></p>
                    <div class="mb-3">
                        <label class="form-label">Quantity to Deduct <span class="text-danger">*</span></label>
                        <input type="number" id="deductQuantity" class="form-control" min="1" required />
                        <div class="invalid-feedback">Enter a valid quantity.</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Notes</label>
                        <textarea id="deductNotes" class="form-control" rows="2" maxlength="500" placeholder="Reason for deduction..."></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger btn-sm" onclick="deductExpired()">
                    <i class="bi bi-dash-circle me-1"></i> Deduct
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentDeductMax = 0;

        function openDeductModal(inventoryId, productName, qty) {
            document.getElementById('deductInventoryId').value = inventoryId;
            document.getElementById('deductProductName').textContent = productName;
            document.getElementById('deductOnHand').textContent = qty;
            document.getElementById('deductQuantity').max = qty;
            document.getElementById('deductQuantity').value = qty;
            currentDeductMax = qty;
            new bootstrap.Modal(document.getElementById('deductModal')).show();
        }

        async function deductExpired() {
            const form = document.getElementById('deductForm');
            if (!form.checkValidity()) {
                form.classList.add('was-validated');
                return;
            }

            const qty = parseInt(document.getElementById('deductQuantity').value);
            if (qty > currentDeductMax) {
                showGlobalToast('error', `Cannot deduct more than ${currentDeductMax}`);
                return;
            }

            const data = {
                inventoryID: parseInt(document.getElementById('deductInventoryId').value),
                quantity: qty,
                notes: document.getElementById('deductNotes').value || null
            };

            try {
                const response = await fetch('@Url.Action("DeductExpired", "Sales")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify(data)
                });

                const result = await response.json();
                if (response.ok && result.success) {
                    showGlobalToast('success', result.message);
                    setTimeout(() => window.location.reload(), 500);
                } else {
                    showGlobalToast('error', result.message || 'Failed to deduct');
                }
            } catch {
                showGlobalToast('error', 'An error occurred');
            }
        }
    </script>
}
