@model IT15_DairyFlow.Models.Finance.FinanceDashboardViewModel

@{
    ViewData["Title"] = "Finance Management";
}

<div class="container-fluid p-4">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1 fw-bold">Finance Management</h2>
            <p class="text-muted mb-0">Track expenses, billing invoices, and production costs.</p>
        </div>
        <div class="btn-group">
            <button class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#addExpenseModal">
                <i class="bi bi-receipt me-1"></i> Add Expense
            </button>
            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addInvoiceModal">
                <i class="bi bi-file-earmark-text me-1"></i> Create Invoice
            </button>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row g-4 mb-4">
        <div class="col-lg-3 col-md-6">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="rounded-circle bg-success bg-opacity-10 p-3 me-3">
                            <i class="bi bi-graph-up-arrow text-success fs-4"></i>
                        </div>
                        <div>
                            <h6 class="text-muted mb-1 small text-uppercase">Total Revenue</h6>
                            <h3 class="mb-0 fw-bold text-success">â‚±@Model.Summary.TotalRevenue.ToString("N2")</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="rounded-circle bg-danger bg-opacity-10 p-3 me-3">
                            <i class="bi bi-graph-down-arrow text-danger fs-4"></i>
                        </div>
                        <div>
                            <h6 class="text-muted mb-1 small text-uppercase">Total Expenses</h6>
                            <h3 class="mb-0 fw-bold text-danger">â‚±@Model.Summary.TotalExpenses.ToString("N2")</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="rounded-circle bg-primary bg-opacity-10 p-3 me-3">
                            <i class="bi bi-cash-stack text-primary fs-4"></i>
                        </div>
                        <div>
                            <h6 class="text-muted mb-1 small text-uppercase">Net Income</h6>
                            <h3 class="mb-0 fw-bold @(Model.Summary.NetIncome >= 0 ? "text-success" : "text-danger")">
                                â‚±@Model.Summary.NetIncome.ToString("N2")
                            </h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="rounded-circle bg-warning bg-opacity-10 p-3 me-3">
                            <i class="bi bi-hourglass-split text-warning fs-4"></i>
                        </div>
                        <div>
                            <h6 class="text-muted mb-1 small text-uppercase">Pending Invoices</h6>
                            <h3 class="mb-0 fw-bold text-warning">â‚±@Model.Summary.PendingInvoices.ToString("N2")</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Expenses and Invoices Row -->
    <div class="row g-4 mb-4">
        <!-- Recent Expenses -->
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-receipt text-danger me-2"></i>
                        <h6 class="mb-0 fw-semibold">Recent Expenses</h6>
                    </div>
                    <button class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#addExpenseModal">
                        <i class="bi bi-plus-lg"></i>
                    </button>
                </div>
                <div class="card-body p-0">
                    @if (Model.RecentExpenses.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="px-4">Date</th>
                                        <th>Supplier</th>
                                        <th>Amount</th>
                                        <th class="text-end px-4">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var expense in Model.RecentExpenses)
                                    {
                                        <tr class="expense-row" data-expense-id="@expense.ExpenseID" style="cursor: pointer;">
                                            <td class="px-4">@(expense.ExpenseDate?.ToString("MMM dd, yyyy") ?? "N/A")</td>
                                            <td>@expense.SupplierName</td>
                                            <td class="fw-semibold text-danger">â‚±@expense.Amount.ToString("N2")</td>
                                            <td class="text-end px-4">
                                                <button class="btn btn-sm btn-outline-danger" onclick="event.stopPropagation(); deleteExpense(@expense.ExpenseID)">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center text-muted py-4">
                            <i class="bi bi-receipt display-4 d-block mb-3 opacity-25"></i>
                            <p class="mb-0">No expenses recorded yet.</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Recent Invoices -->
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-file-earmark-text text-success me-2"></i>
                        <h6 class="mb-0 fw-semibold">Recent Invoices</h6>
                    </div>
                    <button class="btn btn-sm btn-outline-success" data-bs-toggle="modal" data-bs-target="#addInvoiceModal">
                        <i class="bi bi-plus-lg"></i>
                    </button>
                </div>
                <div class="card-body p-0">
                    @if (Model.RecentInvoices.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="px-4">Due Date</th>
                                        <th>Amount</th>
                                        <th>Status</th>
                                        <th class="text-end px-4">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var invoice in Model.RecentInvoices)
                                    {
                                        var statusClass = invoice.PaymentStatus switch
                                        {
                                            "Paid" => "bg-success",
                                            "Pending" => "bg-warning",
                                            "Overdue" => "bg-danger",
                                            _ => "bg-secondary"
                                        };
                                        <tr>
                                            <td class="px-4">@(invoice.DueDate?.ToString("MMM dd, yyyy") ?? "N/A")</td>
                                            <td class="fw-semibold">â‚±@invoice.Amount.ToString("N2")</td>
                                            <td>
                                                <span class="badge @statusClass">@invoice.PaymentStatus</span>
                                            </td>
                                            <td class="text-end px-4">
                                                @if (invoice.PaymentStatus != "Paid")
                                                {
                                                    <button class="btn btn-sm btn-outline-success me-1" onclick="markInvoicePaid(@invoice.BillingInvoiceID)">
                                                        <i class="bi bi-check-lg"></i>
                                                    </button>
                                                }
                                                <button class="btn btn-sm btn-outline-danger" onclick="deleteInvoice(@invoice.BillingInvoiceID)">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center text-muted py-4">
                            <i class="bi bi-file-earmark-text display-4 d-block mb-3 opacity-25"></i>
                            <p class="mb-0">No invoices created yet.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Production Costs -->
    <div class="row g-4">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-transparent border-0">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-gear text-info me-2"></i>
                        <h6 class="mb-0 fw-semibold">Production Costs</h6>
                    </div>
                </div>
                <div class="card-body p-0">
                    @if (Model.ProductionCosts.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="px-4">Batch Code</th>
                                        <th>Production Period</th>
                                        <th>Total Cost</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var cost in Model.ProductionCosts)
                                    {
                                        <tr>
                                            <td class="px-4 fw-semibold">@cost.BatchCode</td>
                                            <td>
                                                @(cost.StartDate?.ToString("MMM dd") ?? "N/A") - @(cost.EndDate?.ToString("MMM dd, yyyy") ?? "N/A")
                                            </td>
                                            <td class="fw-semibold text-info">â‚±@cost.TotalCost.ToString("N2")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center text-muted py-4">
                            <i class="bi bi-gear display-4 d-block mb-3 opacity-25"></i>
                            <p class="mb-0">No production costs recorded yet.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add Expense Modal -->
<div class="modal fade" id="addExpenseModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-receipt text-danger me-2"></i>Record Expense
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="addExpenseForm">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Amount <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text">â‚±</span>
                            <input type="number" class="form-control" id="expenseAmount" step="0.01" min="0.01" required>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Date <span class="text-danger">*</span></label>
                        <input type="date" class="form-control" id="expenseDate" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Supplier</label>
                        <select class="form-select" id="expenseSupplier">
                            <option value="">Select supplier (optional)...</option>
                            @foreach (var supplier in Model.Suppliers)
                            {
                                <option value="@supplier.Id">@supplier.Name</option>
                            }
                        </select>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" onclick="addExpense()">
                    <i class="bi bi-check-lg me-1"></i>Record Expense
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Add Invoice Modal -->
<div class="modal fade" id="addInvoiceModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-file-earmark-text text-success me-2"></i>Create Invoice
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="addInvoiceForm">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Amount <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text">â‚±</span>
                            <input type="number" class="form-control" id="invoiceAmount" step="0.01" min="0.01" required>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Invoice Date</label>
                        <input type="date" class="form-control" id="invoiceDate">
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Due Date</label>
                        <input type="date" class="form-control" id="invoiceDueDate">
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Status</label>
                        <select class="form-select" id="invoiceStatus">
                            <option value="Pending" selected>Pending</option>
                            <option value="Paid">Paid</option>
                        </select>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success" onclick="addInvoice()">
                    <i class="bi bi-check-lg me-1"></i>Create Invoice
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Set default date to today
        document.addEventListener('DOMContentLoaded', function() {
            const today = new Date().toISOString().split('T')[0];
            document.getElementById('expenseDate').value = today;
            document.getElementById('invoiceDate').value = today;

            // Row click to view expense details
            document.querySelectorAll('.expense-row').forEach(row => {
                row.addEventListener('click', function () {
                    const expenseId = this.dataset.expenseId;
                    viewExpense(expenseId);
                });
            });
        });

        // Expense functions
        async function addExpense() {
            const form = document.getElementById('addExpenseForm');
            if (!form.checkValidity()) {
                form.classList.add('was-validated');
                return;
            }

            const data = {
                amount: parseFloat(document.getElementById('expenseAmount').value),
                expenseDate: document.getElementById('expenseDate').value || null,
                supplierID: document.getElementById('expenseSupplier').value || null
            };

            if (data.supplierID) data.supplierID = parseInt(data.supplierID);

            try {
                const response = await fetch('@Url.Action("CreateExpense", "Finance")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify(data)
                });

                if (response.ok) {
                    showToast('success', 'Expense recorded successfully');
                    setTimeout(() => window.location.reload(), 300);
                } else {
                    showToast('error', 'Failed to record expense');
                }
            } catch (error) {
                showToast('error', 'An error occurred');
                console.error(error);
            }
        }

        async function viewExpense(id) {
            try {
                const response = await fetch(`@Url.Action("GetExpenseDetail", "Finance")/${id}`);
                if (response.ok) {
                    const data = await response.json();
                    showGlobalToast('success', `Expense: â‚±${data.amount.toFixed(2)} | Date: ${data.expenseDate || 'N/A'} | Supplier: ${data.supplierName}`);
                }
            } catch (error) {
                showToast('error', 'Failed to load expense details');
            }
        }

        async function deleteExpense(id) {
            showConfirmModal('Are you sure you want to delete this expense?', async () => {
                try {
                    const response = await fetch(`@Url.Action("DeleteExpense", "Finance")/${id}`, {
                        method: 'POST',
                        headers: {
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                        }
                    });

                    if (response.ok) {
                        showToast('success', 'Expense deleted');
                        setTimeout(() => window.location.reload(), 300);
                    } else {
                        showToast('error', 'Failed to delete expense');
                    }
                } catch (error) {
                    showToast('error', 'An error occurred');
                }
            });
        }

        // Invoice functions
        async function addInvoice() {
            const form = document.getElementById('addInvoiceForm');
            if (!form.checkValidity()) {
                form.classList.add('was-validated');
                return;
            }

            const data = {
                amount: parseFloat(document.getElementById('invoiceAmount').value),
                invoiceDate: document.getElementById('invoiceDate').value || null,
                dueDate: document.getElementById('invoiceDueDate').value || null,
                paymentStatus: document.getElementById('invoiceStatus').value
            };

            try {
                const response = await fetch('@Url.Action("CreateInvoice", "Finance")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify(data)
                });

                if (response.ok) {
                    showToast('success', 'Invoice created');
                    setTimeout(() => window.location.reload(), 300);
                } else {
                    showToast('error', 'Failed to create invoice');
                }
            } catch (error) {
                showToast('error', 'An error occurred');
            }
        }

        async function markInvoicePaid(id) {
            showConfirmModal('Mark this invoice as paid?', async () => {
                try {
                    const response = await fetch(`@Url.Action("MarkInvoicePaid", "Finance")/${id}`, {
                        method: 'POST',
                        headers: {
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                        }
                    });

                    if (response.ok) {
                        showToast('success', 'Invoice marked as paid');
                        setTimeout(() => window.location.reload(), 300);
                    } else {
                        showToast('error', 'Failed to update invoice');
                    }
                } catch (error) {
                    showToast('error', 'An error occurred');
                }
            });
        }

        async function deleteInvoice(id) {
            showConfirmModal('Are you sure you want to delete this invoice?', async () => {
                try {
                    const response = await fetch(`@Url.Action("DeleteInvoice", "Finance")/${id}`, {
                        method: 'POST',
                        headers: {
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                        }
                    });

                    if (response.ok) {
                        showToast('success', 'Invoice deleted');
                        setTimeout(() => window.location.reload(), 300);
                    } else {
                        showToast('error', 'Failed to delete invoice');
                    }
                } catch (error) {
                    showToast('error', 'An error occurred');
                }
            });
        }

        function showToast(type, message) {
            showGlobalToast(type, message);
        }
    </script>
}
