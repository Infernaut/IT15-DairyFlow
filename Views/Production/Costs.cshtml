@model IT15_DairyFlow.Models.Production.ProductionCostPageViewModel
@using System.Text.Json

@{
    ViewData["Title"] = "Production Costs";

    var chartData = Model.CostItems.Where(c => c.StartDate.HasValue && c.TotalCost.HasValue)
        .OrderBy(c => c.StartDate)
        .Select(c => new {
            date = c.StartDate!.Value.ToString("yyyy-MM-dd"),
            cost = c.TotalCost!.Value,
            product = c.ProductName,
            batch = c.BatchCode
        }).ToList();

    // Monthly aggregation for bar chart
    var monthlyData = Model.CostItems.Where(c => c.StartDate.HasValue && c.TotalCost.HasValue)
        .GroupBy(c => new { c.StartDate!.Value.Year, c.StartDate!.Value.Month })
        .OrderBy(g => g.Key.Year).ThenBy(g => g.Key.Month)
        .Select(g => new {
            label = new DateTime(g.Key.Year, g.Key.Month, 1).ToString("MMM yyyy"),
            total = g.Sum(c => c.TotalCost ?? 0),
            count = g.Count()
        }).ToList();

    // Product cost distribution for doughnut chart
    var productData = Model.CostItems.Where(c => c.TotalCost.HasValue)
        .GroupBy(c => c.ProductName)
        .Select(g => new {
            product = g.Key,
            total = g.Sum(c => c.TotalCost ?? 0)
        })
        .OrderByDescending(x => x.total)
        .Take(8)
        .ToList();

    var chartJson = JsonSerializer.Serialize(chartData);
    var monthlyJson = JsonSerializer.Serialize(monthlyData);
    var productJson = JsonSerializer.Serialize(productData);
}

<div class="container-fluid p-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1 fw-bold">Production Costs</h2>
            <p class="text-muted mb-0">Analyze production cost trends with daily, weekly, monthly and yearly breakdowns.</p>
        </div>
    </div>

    <!-- Period Filter Tabs -->
    <ul class="nav nav-pills mb-4" id="periodTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link" data-period="daily" id="daily-tab" type="button" role="tab">Daily</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" data-period="weekly" id="weekly-tab" type="button" role="tab">Weekly</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link active" data-period="monthly" id="monthly-tab" type="button" role="tab">Monthly</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" data-period="yearly" id="yearly-tab" type="button" role="tab">Yearly</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" data-period="all" id="all-tab" type="button" role="tab">All Time</button>
        </li>
    </ul>

    <!-- Summary Cards -->
    <div class="row g-4 mb-4">
        <div class="col-lg-3 col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="rounded-circle bg-primary bg-opacity-10 p-3 me-3">
                            <i class="bi bi-cash-stack text-primary fs-4"></i>
                        </div>
                        <div>
                            <h6 class="text-muted mb-1 small text-uppercase">Total Cost</h6>
                            <h3 class="mb-0 fw-bold" id="summaryTotalCost">₱@Model.TotalCostAll.ToString("N2")</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="rounded-circle bg-success bg-opacity-10 p-3 me-3">
                            <i class="bi bi-box-seam text-success fs-4"></i>
                        </div>
                        <div>
                            <h6 class="text-muted mb-1 small text-uppercase">Batches</h6>
                            <h3 class="mb-0 fw-bold" id="summaryBatchCount">@Model.TotalBatches</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="rounded-circle bg-info bg-opacity-10 p-3 me-3">
                            <i class="bi bi-graph-up text-info fs-4"></i>
                        </div>
                        <div>
                            <h6 class="text-muted mb-1 small text-uppercase">Avg Cost / Batch</h6>
                            <h3 class="mb-0 fw-bold" id="summaryAvgCost">₱@Model.AverageCostPerBatch.ToString("N2")</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="rounded-circle bg-warning bg-opacity-10 p-3 me-3">
                            <i class="bi bi-cash-stack text-warning fs-4"></i>
                        </div>
                        <div>
                            <h6 class="text-muted mb-1 small text-uppercase">Highest Batch</h6>
                            <h3 class="mb-0 fw-bold" id="summaryHighest">₱@((Model.CostItems.Any() ? Model.CostItems.Max(c => c.TotalCost ?? 0) : 0).ToString("N2"))</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Row -->
    <div class="row g-4 mb-4">
        <!-- Cost Trend Chart -->
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-transparent border-0 py-3">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-bar-chart text-primary me-2"></i>
                        <h6 class="mb-0 fw-semibold" id="trendChartTitle">Monthly Cost Trend</h6>
                    </div>
                </div>
                <div class="card-body">
                    <canvas id="costTrendChart" height="280"></canvas>
                </div>
            </div>
        </div>
        <!-- Product Distribution Chart -->
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-transparent border-0 py-3">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-pie-chart text-primary me-2"></i>
                        <h6 class="mb-0 fw-semibold">Cost by Product</h6>
                    </div>
                </div>
                <div class="card-body d-flex align-items-center justify-content-center">
                    <canvas id="productDistChart" height="260"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Cost Table -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center py-3">
            <div class="d-flex align-items-center">
                <i class="bi bi-table text-primary me-2"></i>
                <h6 class="mb-0 fw-semibold">Cost Records</h6>
            </div>
            <span class="text-muted small" id="tableCountLabel">Showing all records</span>
        </div>
        <div class="table-container">
            <table class="table table-hover align-middle mb-0" id="costTable">
                <thead class="table-light">
                    <tr>
                        <th class="px-4">Batch Code</th>
                        <th>Product</th>
                        <th>Quantity</th>
                        <th>Start Date</th>
                        <th>End Date</th>
                        <th>Total Cost</th>
                    </tr>
                </thead>
                <tbody id="costTableBody">
                    @if (!Model.CostItems.Any())
                    {
                        <tr class="empty-row">
                            <td colspan="6" class="text-center text-muted py-5">
                                <i class="bi bi-inbox display-4 d-block mb-3 opacity-25"></i>
                                <p class="mb-0">No production cost records found.</p>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var cost in Model.CostItems)
                        {
                            <tr data-date="@(cost.StartDate?.ToString("yyyy-MM-dd") ?? "")">
                                <td class="px-4 fw-semibold">@cost.BatchCode</td>
                                <td>@cost.ProductName</td>
                                <td>@cost.Quantity</td>
                                <td>@(cost.StartDate?.ToString("MMM dd, yyyy") ?? "-")</td>
                                <td>@(cost.EndDate?.ToString("MMM dd, yyyy") ?? "-")</td>
                                <td class="fw-semibold">@(cost.TotalCost.HasValue ? "₱" + cost.TotalCost.Value.ToString("N2") : "-")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        const rawData = @Html.Raw(chartJson);
        const monthlyRaw = @Html.Raw(monthlyJson);
        const productRaw = @Html.Raw(productJson);
        const today = new Date();
        today.setHours(0, 0, 0, 0);

        const chartColors = ['#0d6efd', '#198754', '#ffc107', '#dc3545', '#6f42c1', '#0dcaf0', '#fd7e14', '#20c997'];

        // ─── Helper: group data by period ───
        function aggregateByPeriod(data, period) {
            const groups = {};
            data.forEach(d => {
                const dt = new Date(d.date + 'T00:00:00');
                let key;
                if (period === 'daily') {
                    key = d.date;
                } else if (period === 'weekly') {
                    const dayOfWeek = dt.getDay();
                    const start = new Date(dt);
                    start.setDate(start.getDate() - dayOfWeek);
                    key = start.toISOString().slice(0, 10);
                } else if (period === 'monthly') {
                    key = d.date.slice(0, 7);
                } else if (period === 'yearly') {
                    key = d.date.slice(0, 4);
                } else {
                    key = 'All';
                }
                if (!groups[key]) groups[key] = { total: 0, count: 0 };
                groups[key].total += d.cost;
                groups[key].count++;
            });
            return groups;
        }

        function filterByPeriod(data, period) {
            return data.filter(d => {
                const dt = new Date(d.date + 'T00:00:00');
                if (period === 'daily') return dt.toDateString() === today.toDateString();
                if (period === 'weekly') {
                    const startOfWeek = new Date(today);
                    startOfWeek.setDate(today.getDate() - today.getDay());
                    return dt >= startOfWeek && dt <= today;
                }
                if (period === 'monthly') return dt.getMonth() === today.getMonth() && dt.getFullYear() === today.getFullYear();
                if (period === 'yearly') return dt.getFullYear() === today.getFullYear();
                return true; // all
            });
        }

        function formatLabel(key, period) {
            if (period === 'daily') {
                const d = new Date(key + 'T00:00:00');
                return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
            }
            if (period === 'weekly') {
                const d = new Date(key + 'T00:00:00');
                return 'Week of ' + d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
            }
            if (period === 'monthly') {
                const [y, m] = key.split('-');
                return new Date(parseInt(y), parseInt(m) - 1, 1).toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
            }
            if (period === 'yearly') return key;
            return 'All Time';
        }

        // ─── Cost Trend Chart ───
        const trendCtx = document.getElementById('costTrendChart').getContext('2d');
        let trendChart = new Chart(trendCtx, {
            type: 'bar',
            data: {
                labels: monthlyRaw.map(d => d.label),
                datasets: [{
                    label: 'Total Cost',
                    data: monthlyRaw.map(d => d.total),
                    backgroundColor: 'rgba(13, 110, 253, 0.7)',
                    borderColor: '#0d6efd',
                    borderWidth: 1,
                    borderRadius: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: ctx => '$' + ctx.parsed.y.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: val => '$' + val.toLocaleString()
                        },
                        grid: { color: 'rgba(0,0,0,0.05)' }
                    },
                    x: {
                        grid: { display: false }
                    }
                }
            }
        });

        // ─── Product Distribution Chart ───
        const distCtx = document.getElementById('productDistChart').getContext('2d');
        let distChart = new Chart(distCtx, {
            type: 'doughnut',
            data: {
                labels: productRaw.map(d => d.product),
                datasets: [{
                    data: productRaw.map(d => d.total),
                    backgroundColor: chartColors.slice(0, productRaw.length),
                    borderWidth: 2,
                    borderColor: '#fff'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: { padding: 12, font: { size: 11 } }
                    },
                    tooltip: {
                        callbacks: {
                            label: ctx => {
                                const val = ctx.parsed;
                                const total = ctx.dataset.data.reduce((a, b) => a + b, 0);
                                const pct = ((val / total) * 100).toFixed(1);
                                return `$${val.toLocaleString(undefined, { minimumFractionDigits: 2 })} (${pct}%)`;
                            }
                        }
                    }
                }
            }
        });

        // ─── Period Tab Logic ───
        function updateForPeriod(period) {
            // Filter raw data
            const filtered = filterByPeriod(rawData, period);
            const totalCost = filtered.reduce((s, d) => s + d.cost, 0);
            const batchCount = filtered.length;
            const avgCost = batchCount > 0 ? totalCost / batchCount : 0;
            const highest = batchCount > 0 ? Math.max(...filtered.map(d => d.cost)) : 0;

            // Update summary cards
            document.getElementById('summaryTotalCost').textContent = '$' + totalCost.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            document.getElementById('summaryBatchCount').textContent = batchCount;
            document.getElementById('summaryAvgCost').textContent = '$' + avgCost.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            document.getElementById('summaryHighest').textContent = '$' + highest.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });

            // Update trend chart
            let aggregated;
            if (period === 'all') {
                aggregated = aggregateByPeriod(rawData, 'monthly');
            } else {
                aggregated = aggregateByPeriod(filtered, period);
            }

            const sortedKeys = Object.keys(aggregated).sort();
            const labels = sortedKeys.map(k => formatLabel(k, period === 'all' ? 'monthly' : period));
            const values = sortedKeys.map(k => aggregated[k].total);

            trendChart.data.labels = labels;
            trendChart.data.datasets[0].data = values;

            // Use line chart for daily and weekly
            if (period === 'daily' || period === 'weekly') {
                trendChart.config.type = 'line';
                trendChart.data.datasets[0].fill = true;
                trendChart.data.datasets[0].backgroundColor = 'rgba(13, 110, 253, 0.1)';
                trendChart.data.datasets[0].tension = 0.3;
                trendChart.data.datasets[0].pointRadius = 4;
                trendChart.data.datasets[0].pointBackgroundColor = '#0d6efd';
            } else {
                trendChart.config.type = 'bar';
                trendChart.data.datasets[0].fill = false;
                trendChart.data.datasets[0].backgroundColor = 'rgba(13, 110, 253, 0.7)';
                delete trendChart.data.datasets[0].tension;
                delete trendChart.data.datasets[0].pointRadius;
                delete trendChart.data.datasets[0].pointBackgroundColor;
            }
            trendChart.update();

            const periodLabels = { daily: 'Daily', weekly: 'Weekly', monthly: 'Monthly', yearly: 'Yearly', all: 'All Time' };
            document.getElementById('trendChartTitle').textContent = (periodLabels[period] || 'Monthly') + ' Cost Trend';

            // Filter table rows
            const rows = document.querySelectorAll('#costTableBody tr:not(.empty-row)');
            let visibleCount = 0;
            rows.forEach(row => {
                const dateStr = row.getAttribute('data-date');
                if (!dateStr || period === 'all') {
                    row.style.display = '';
                    visibleCount++;
                    return;
                }
                const dt = new Date(dateStr + 'T00:00:00');
                let show = false;
                if (period === 'daily') show = dt.toDateString() === today.toDateString();
                else if (period === 'weekly') {
                    const startOfWeek = new Date(today);
                    startOfWeek.setDate(today.getDate() - today.getDay());
                    show = dt >= startOfWeek && dt <= today;
                }
                else if (period === 'monthly') show = dt.getMonth() === today.getMonth() && dt.getFullYear() === today.getFullYear();
                else if (period === 'yearly') show = dt.getFullYear() === today.getFullYear();
                row.style.display = show ? '' : 'none';
                if (show) visibleCount++;
            });
            document.getElementById('tableCountLabel').textContent = period === 'all' ? 'Showing all records' : `Showing ${visibleCount} record${visibleCount !== 1 ? 's' : ''} (${periodLabels[period]})`;
        }

        document.querySelectorAll('#periodTabs .nav-link').forEach(tab => {
            tab.addEventListener('click', function () {
                document.querySelectorAll('#periodTabs .nav-link').forEach(t => t.classList.remove('active'));
                this.classList.add('active');
                updateForPeriod(this.dataset.period);
            });
        });

        // Initialize with monthly
        updateForPeriod('monthly');
    </script>
}
