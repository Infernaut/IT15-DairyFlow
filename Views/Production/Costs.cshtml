@model IEnumerable<IT15_DairyFlow.Models.Production.ProductionCostListViewModel>

@{
    ViewData["Title"] = "Production Cost";
}

<div class="container-fluid p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1 fw-bold">Production Cost</h2>
            <p class="text-muted mb-0">Review cost breakdown by production batch.</p>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="px-4">Batch Code</th>
                        <th>Start Date</th>
                        <th>End Date</th>
                        <th>Total Cost</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted py-5">
                                <i class="bi bi-inbox display-4 d-block mb-3 opacity-25"></i>
                                <p class="mb-0">No production cost records found.</p>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var cost in Model)
                        {
                            <tr>
                                <td class="px-4 fw-semibold">@cost.BatchCode</td>
                                <td>@(cost.StartDate?.ToString("MMM dd, yyyy") ?? "-")</td>
                                <td>@(cost.EndDate?.ToString("MMM dd, yyyy") ?? "-")</td>
                                <td>@(cost.TotalCost?.ToString("C") ?? "-")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
