@model IT15_DairyFlow.Models.Production.ProductionBatchPageViewModel

@{
    ViewData["Title"] = "Production Batches";
    var productsJson = System.Text.Json.JsonSerializer.Serialize(Model.Products.Select(p => new { id = p.Id, name = p.Name, hasFormulation = p.HasFormulation }));
}

<div class="container-fluid p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1 fw-bold">Production Batches</h2>
            <p class="text-muted mb-0">Track active production runs and manage batch lifecycle.</p>
        </div>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createBatchModal">
            <i class="bi bi-plus-lg me-1"></i> Add Batch
        </button>
    </div>

    <div class="card shadow-sm">
        <div class="table-container">
            <table class="table table-hover align-middle mb-0" id="batchesTable">
                <thead class="table-light">
                    <tr>
                        <th class="px-4">Batch Code</th>
                        <th>Product</th>
                        <th>Quantity</th>
                        <th>Start Date</th>
                        <th>End Date</th>
                        <th>Est. Cost</th>
                        <th>Status</th>
                        <th class="text-end px-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Batches.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-5">
                                <i class="bi bi-inbox display-4 d-block mb-3 opacity-25"></i>
                                <p class="mb-0">No active production batches found.</p>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var batch in Model.Batches)
                        {
                            <tr class="batch-row" data-batch-id="@batch.ProductionBatchID" style="cursor: pointer;">
                                <td class="px-4 fw-semibold">@batch.BatchCode</td>
                                <td>@batch.ProductName</td>
                                <td>@batch.Quantity</td>
                                <td>@(batch.StartDate?.ToString("MMM dd, yyyy") ?? "-")</td>
                                <td>@(batch.EndDate?.ToString("MMM dd, yyyy") ?? "-")</td>
                                <td>@(batch.TotalCost?.ToString("C") ?? "-")</td>
                                <td>
                                    @{
                                        var badgeClass = batch.Status switch
                                        {
                                            "In Production" => "bg-success",
                                            "Scheduled" => "bg-info",
                                            "Paused" => "bg-warning",
                                            "Completed" => "bg-secondary",
                                            _ => "bg-secondary"
                                        };
                                    }
                                    <span class="badge @badgeClass">@(batch.Status ?? "Unknown")</span>
                                </td>
                                <td class="text-end px-4">
                                    <button class="btn btn-sm btn-outline-success" onclick="event.stopPropagation(); finishBatch(@batch.ProductionBatchID)">
                                        <i class="bi bi-check2-circle"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Create Batch Modal -->
<div class="modal fade" id="createBatchModal" tabindex="-1" aria-labelledby="createBatchModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="createBatchModalLabel">
                    <i class="bi bi-hammer text-primary me-2"></i>Create Production Batch
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="createBatchForm">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Batch Code</label>
                        <input type="text" class="form-control" value="Auto-generated" disabled>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Start Date <span class="text-danger">*</span></label>
                        <input type="date" class="form-control" id="batchStartDate" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">End Date <span class="text-danger">*</span></label>
                        <input type="date" class="form-control" id="batchEndDate" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Product <span class="text-danger">*</span></label>
                        <select class="form-select" id="batchProduct" required>
                            <option value="">Select product...</option>
                            @foreach (var item in Model.Products)
                            {
                                <option value="@item.Id" data-has-formulation="@item.HasFormulation.ToString().ToLower()">@item.Name</option>
                            }
                        </select>
                        <div id="formulationWarning" class="text-danger small mt-1" style="display: none;">
                            <i class="bi bi-exclamation-triangle me-1"></i>This product has no formulation. Please add a formulation before producing.
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Equipment <span class="text-danger">*</span></label>
                        <select class="form-select" id="batchEquipment" required>
                            <option value="">Select equipment...</option>
                            @foreach (var item in Model.Equipments)
                            {
                                <option value="@item.Id">@item.Name</option>
                            }
                        </select>
                        <div class="form-text">Only available equipment is shown.</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Quantity <span class="text-danger">*</span></label>
                        <input type="number" class="form-control" id="batchQuantity" min="1" value="1" required>
                    </div>
                    <div class="mb-3" id="estimatedCostSection" style="display: none;">
                        <label class="form-label fw-semibold">Estimated Total Cost</label>
                        <div class="alert alert-light border mb-0">
                            <span class="fw-bold text-primary fs-5" id="estimatedCostValue">-</span>
                            <div class="text-muted small">Cost per unit: <span id="costPerUnitValue">-</span></div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="createBatchBtn" onclick="createBatch()">
                    <i class="bi bi-check-lg me-1"></i>Create Batch
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Batch Detail Modal -->
<div class="modal fade" id="batchDetailModal" tabindex="-1" aria-labelledby="batchDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="batchDetailModalLabel">
                    <i class="bi bi-box-seam text-primary me-2"></i>Batch Details
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="batchDetailContent"></div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let costPerUnit = 0;

        // Product selection handler - check formulation
        document.getElementById('batchProduct').addEventListener('change', async function () {
            const selectedOption = this.options[this.selectedIndex];
            const hasFormulation = selectedOption.dataset.hasFormulation === 'true';
            const productId = this.value;
            const warning = document.getElementById('formulationWarning');
            const createBtn = document.getElementById('createBatchBtn');
            const costSection = document.getElementById('estimatedCostSection');

            if (!productId) {
                warning.style.display = 'none';
                createBtn.disabled = false;
                costSection.style.display = 'none';
                costPerUnit = 0;
                return;
            }

            if (!hasFormulation) {
                warning.style.display = 'block';
                createBtn.disabled = true;
                costSection.style.display = 'none';
                costPerUnit = 0;
            } else {
                warning.style.display = 'none';
                createBtn.disabled = false;

                // Fetch cost info
                try {
                    const response = await fetch(`@Url.Action("CheckProductFormulation", "Production")?productId=${productId}`);
                    if (response.ok) {
                        const data = await response.json();
                        costPerUnit = data.costPerUnit;
                        document.getElementById('costPerUnitValue').textContent = '$' + costPerUnit.toFixed(2);
                        updateEstimatedCost();
                        costSection.style.display = 'block';
                    }
                } catch (e) {
                    console.error(e);
                }
            }
        });

        // Quantity change handler - update estimated cost
        document.getElementById('batchQuantity').addEventListener('input', updateEstimatedCost);

        function updateEstimatedCost() {
            const qty = parseInt(document.getElementById('batchQuantity').value) || 0;
            const total = costPerUnit * qty;
            document.getElementById('estimatedCostValue').textContent = '$' + total.toFixed(2);
        }

        async function createBatch() {
            const form = document.getElementById('createBatchForm');
            if (!form.checkValidity()) {
                form.classList.add('was-validated');
                return;
            }

            const data = {
                startDate: document.getElementById('batchStartDate').value,
                endDate: document.getElementById('batchEndDate').value,
                status: 'In Production',
                productID: parseInt(document.getElementById('batchProduct').value),
                equipmentID: parseInt(document.getElementById('batchEquipment').value),
                quantity: parseInt(document.getElementById('batchQuantity').value)
            };

            try {
                const response = await fetch('@Url.Action("CreateBatch", "Production")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify(data)
                });

                if (response.ok) {
                    const result = await response.json();
                    showToast('success', result.message);
                    setTimeout(() => window.location.reload(), 300);
                } else {
                    const errorText = await response.text();
                    showToast('error', errorText || 'Failed to create batch');
                }
            } catch (error) {
                showToast('error', 'An error occurred');
                console.error(error);
            }
        }

        async function viewBatchDetail(batchId) {
            try {
                const response = await fetch(`@Url.Action("GetBatchDetail", "Production")/${batchId}`);
                if (response.ok) {
                    const batch = await response.json();
                    renderBatchDetail(batch);
                    new bootstrap.Modal(document.getElementById('batchDetailModal')).show();
                }
            } catch (error) {
                console.error(error);
                showToast('error', 'Failed to load batch details');
            }
        }

        function renderBatchDetail(batch) {
            const badgeClass = {
                'In Production': 'bg-success',
                'Scheduled': 'bg-info',
                'Paused': 'bg-warning',
                'Completed': 'bg-secondary'
            }[batch.status] || 'bg-secondary';

            const content = `
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold text-muted small">Batch Code</label>
                        <input type="text" class="form-control form-control-lg" value="${batch.batchCode}" readonly>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold text-muted small">Status</label>
                        <div class="mt-2"><span class="badge ${badgeClass}">${batch.status}</span></div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold text-muted small">Start Date</label>
                        <input type="text" class="form-control form-control-lg" value="${batch.startDate ? new Date(batch.startDate).toLocaleDateString() : '-'}" readonly>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold text-muted small">End Date</label>
                        <input type="text" class="form-control form-control-lg" value="${batch.endDate ? new Date(batch.endDate).toLocaleDateString() : '-'}" readonly>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold text-muted small">Product</label>
                        <input type="text" class="form-control form-control-lg" value="${batch.productName}" readonly>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold text-muted small">Equipment</label>
                        <input type="text" class="form-control form-control-lg" value="${batch.equipmentName}" readonly>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold text-muted small">Operator</label>
                        <input type="text" class="form-control form-control-lg" value="${batch.userName}" readonly>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold text-muted small">Quantity</label>
                        <input type="text" class="form-control form-control-lg" value="${batch.quantity}" readonly>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold text-muted small">Total Cost</label>
                        <input type="text" class="form-control form-control-lg" value="${batch.totalCost != null ? '$' + batch.totalCost.toFixed(2) : '-'}" readonly>
                    </div>
                </div>
            `;
            document.getElementById('batchDetailContent').innerHTML = content;
        }

        async function finishBatch(batchId) {
            showConfirmModal('Mark this batch as completed?', async () => {
                try {
                    const response = await fetch(`@Url.Action("FinishBatch", "Production")/${batchId}`, {
                        method: 'POST',
                        headers: {
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                        }
                    });

                    if (response.ok) {
                        const result = await response.json();
                        showToast('success', result.message);
                        setTimeout(() => window.location.reload(), 300);
                    } else {
                        showToast('error', 'Failed to finish batch');
                    }
                } catch (error) {
                    showToast('error', 'An error occurred');
                    console.error(error);
                }
            });
        }

        document.querySelectorAll('.batch-row').forEach(row => {
            row.addEventListener('click', function () {
                const batchId = this.dataset.batchId;
                viewBatchDetail(batchId);
            });
        });

        function showToast(type, message) {
            showGlobalToast(type, message);
        }
    </script>
}

@Html.AntiForgeryToken()
