@model IT15_DairyFlow.Models.Production.SupplierPageViewModel

@{
    ViewData["Title"] = "Suppliers";
}

<div class="container-fluid p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1 fw-bold">Suppliers</h2>
            <p class="text-muted mb-0">Manage your raw material suppliers.</p>
        </div>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createSupplierModal">
            <i class="bi bi-plus-lg me-1"></i> Add Supplier
        </button>
    </div>

    <!-- Filter Tabs -->
    <ul class="nav nav-tabs mb-3" id="supplierTabs">
        <li class="nav-item">
            <a class="nav-link active" href="#" data-filter="all">All</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" href="#" data-filter="Active">Active</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" href="#" data-filter="Inactive">Inactive</a>
        </li>
    </ul>

    <div class="card shadow-sm">
        <div class="table-container">
            <table class="table table-hover align-middle mb-0" id="suppliersTable">
                <thead class="table-light">
                    <tr>
                        <th class="px-4">Supplier Name</th>
                        <th>Contact Info</th>
                        <th>Status</th>
                        <th class="text-end px-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Suppliers.Any())
                    {
                        <tr class="empty-row">
                            <td colspan="4" class="text-center text-muted py-5">
                                <i class="bi bi-inbox display-4 d-block mb-3 opacity-25"></i>
                                <p class="mb-0">No suppliers found. Add your first supplier.</p>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var supplier in Model.Suppliers)
                        {
                            <tr class="supplier-row" data-status="@supplier.Status">
                                <td class="px-4 fw-semibold">@supplier.SupplierName</td>
                                <td>@(supplier.ContactInfo ?? "-")</td>
                                <td>
                                    @{
                                        var statusClass = supplier.Status == "Active" ? "bg-success" : "bg-secondary";
                                    }
                                    <span class="badge @statusClass">@(supplier.Status ?? "Unknown")</span>
                                </td>
                                <td class="text-end px-4">
                                    <button class="btn btn-sm btn-outline-primary me-1" onclick="editSupplier(@supplier.SupplierID)" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-warning me-1" onclick="toggleStatus(@supplier.SupplierID)" title="Toggle Active/Inactive">
                                        <i class="bi bi-toggle-on"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger" onclick="deleteSupplier(@supplier.SupplierID)" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Create Supplier Modal -->
<div class="modal fade" id="createSupplierModal" tabindex="-1" aria-labelledby="createSupplierModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="createSupplierModalLabel">
                    <i class="bi bi-truck text-primary me-2"></i>Add Supplier
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="createSupplierForm">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Supplier Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="supplierName" required maxlength="256">
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Contact Info</label>
                        <textarea class="form-control" id="supplierContact" rows="3" placeholder="Phone, email, address..."></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="createSupplier()">
                    <i class="bi bi-check-lg me-1"></i>Add Supplier
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Edit Supplier Modal -->
<div class="modal fade" id="editSupplierModal" tabindex="-1" aria-labelledby="editSupplierModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="editSupplierModalLabel">
                    <i class="bi bi-pencil-square text-primary me-2"></i>Edit Supplier
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="editSupplierForm">
                    <input type="hidden" id="editSupplierId">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Supplier Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="editSupplierName" required maxlength="256">
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Contact Info</label>
                        <textarea class="form-control" id="editSupplierContact" rows="3"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="updateSupplier()">
                    <i class="bi bi-check-lg me-1"></i>Save Changes
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Filter tabs
        document.querySelectorAll('#supplierTabs .nav-link').forEach(tab => {
            tab.addEventListener('click', function (e) {
                e.preventDefault();
                document.querySelectorAll('#supplierTabs .nav-link').forEach(t => t.classList.remove('active'));
                this.classList.add('active');
                const filter = this.dataset.filter;
                document.querySelectorAll('.supplier-row').forEach(row => {
                    if (filter === 'all' || row.dataset.status === filter) {
                        row.style.display = '';
                    } else {
                        row.style.display = 'none';
                    }
                });
            });
        });

        async function createSupplier() {
            const form = document.getElementById('createSupplierForm');
            if (!form.checkValidity()) {
                form.classList.add('was-validated');
                return;
            }

            const data = {
                supplierName: document.getElementById('supplierName').value,
                contactInfo: document.getElementById('supplierContact').value
            };

            try {
                const response = await fetch('@Url.Action("CreateSupplier", "Production")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify(data)
                });

                if (response.ok) {
                    const result = await response.json();
                    showToast('success', result.message);
                    setTimeout(() => window.location.reload(), 1000);
                } else {
                    const errorText = await response.text();
                    showToast('error', errorText || 'Failed to create supplier');
                }
            } catch (error) {
                showToast('error', 'An error occurred');
                console.error(error);
            }
        }

        async function editSupplier(id) {
            try {
                const response = await fetch(`@Url.Action("GetSupplierDetail", "Production")/${id}`);
                if (response.ok) {
                    const supplier = await response.json();
                    document.getElementById('editSupplierId').value = supplier.supplierID;
                    document.getElementById('editSupplierName').value = supplier.supplierName || '';
                    document.getElementById('editSupplierContact').value = supplier.contactInfo || '';
                    new bootstrap.Modal(document.getElementById('editSupplierModal')).show();
                }
            } catch (error) {
                showToast('error', 'Failed to load supplier details');
                console.error(error);
            }
        }

        async function updateSupplier() {
            const form = document.getElementById('editSupplierForm');
            if (!form.checkValidity()) {
                form.classList.add('was-validated');
                return;
            }

            const data = {
                supplierID: parseInt(document.getElementById('editSupplierId').value),
                supplierName: document.getElementById('editSupplierName').value,
                contactInfo: document.getElementById('editSupplierContact').value
            };

            try {
                const response = await fetch('@Url.Action("UpdateSupplier", "Production")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify(data)
                });

                if (response.ok) {
                    const result = await response.json();
                    showToast('success', result.message);
                    setTimeout(() => window.location.reload(), 1000);
                } else {
                    const errorText = await response.text();
                    showToast('error', errorText || 'Failed to update supplier');
                }
            } catch (error) {
                showToast('error', 'An error occurred');
                console.error(error);
            }
        }

        async function toggleStatus(id) {
            showConfirmModal('Toggle supplier active/inactive status?', async () => {
                try {
                    const response = await fetch(`@Url.Action("ToggleSupplierStatus", "Production")/${id}`, {
                        method: 'POST',
                        headers: {
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                        }
                    });

                    if (response.ok) {
                        const result = await response.json();
                        showToast('success', result.message);
                        setTimeout(() => window.location.reload(), 1000);
                    } else {
                        showToast('error', 'Failed to toggle status');
                    }
                } catch (error) {
                    showToast('error', 'An error occurred');
                    console.error(error);
                }
            });
        }

        async function deleteSupplier(id) {
            showConfirmModal('Are you sure you want to delete this supplier?', async () => {
                try {
                    const response = await fetch(`@Url.Action("DeleteSupplier", "Production")/${id}`, {
                        method: 'POST',
                        headers: {
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                        }
                    });

                    if (response.ok) {
                        const result = await response.json();
                        showToast('success', result.message);
                        setTimeout(() => window.location.reload(), 1000);
                    } else {
                        const errorText = await response.text();
                        showToast('error', errorText || 'Failed to delete supplier');
                    }
                } catch (error) {
                    showToast('error', 'An error occurred');
                    console.error(error);
                }
            });
        }

        function showToast(type, message) {
            showGlobalToast(type, message);
        }
    </script>
}

@Html.AntiForgeryToken()
