@model IT15_DairyFlow.Models.Production.ProductionSchedulePageViewModel
@using System.Text.Json

@{
    ViewData["Title"] = "Production Schedule";
    var scheduleData = Model.ScheduleItems.Select(item => new
    {
        id = item.ProductionBatchID,
        title = item.BatchCode,
        start = item.StartDate?.ToString("yyyy-MM-dd"),
        end = item.EndDate?.AddDays(1).ToString("yyyy-MM-dd"),
        extendedProps = new
        {
            status = item.Status,
            productName = item.ProductName,
            equipmentName = item.EquipmentName,
            batchCode = item.BatchCode
        }
    }).ToList();
    var scheduleJson = JsonSerializer.Serialize(scheduleData);
}

<div class="container-fluid p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1 fw-bold">Production Schedule</h2>
            <p class="text-muted mb-0">Calendar view of current and upcoming production. Click a date to add a batch.</p>
        </div>
        <div class="d-flex align-items-center gap-3">
            <span class="d-flex align-items-center gap-1"><span class="legend-dot legend-ongoing"></span> Ongoing</span>
            <span class="d-flex align-items-center gap-1"><span class="legend-dot legend-completed"></span> Completed</span>
            <span class="d-flex align-items-center gap-1"><span class="legend-dot legend-scheduled"></span> Scheduled</span>
        </div>
    </div>

    <div class="calendar-shell">
        <div id="fullCalendar"></div>
    </div>
</div>

<!-- Date Detail Modal (shows schedules for a date) -->
<div class="modal fade" id="dateDetailModal" tabindex="-1" aria-labelledby="dateDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="dateDetailModalLabel">
                    <i class="bi bi-calendar-event text-primary me-2"></i><span id="dateDetailTitle">Date</span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="dateDetailList"></div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" id="dateDetailAddBtn" onclick="dateDetailAddBatch()">
                    <i class="bi bi-plus-lg me-1"></i>Add Batch on This Date
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Batch Detail Modal (from schedule) -->
<div class="modal fade" id="scheduleBatchDetailModal" tabindex="-1" aria-labelledby="scheduleBatchDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="scheduleBatchDetailModalLabel">
                    <i class="bi bi-box-seam text-primary me-2"></i>Batch Details
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="scheduleBatchDetailContent"></div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Create Batch from Calendar Modal -->
<div class="modal fade" id="calendarCreateBatchModal" tabindex="-1" aria-labelledby="calendarCreateBatchModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="calendarCreateBatchModalLabel">
                    <i class="bi bi-hammer text-primary me-2"></i>Schedule Production Batch
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="calendarCreateBatchForm">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Batch Code</label>
                        <input type="text" class="form-control" value="Auto-generated" disabled>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Start Date <span class="text-danger">*</span></label>
                        <input type="date" class="form-control" id="calBatchStartDate" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">End Date <span class="text-danger">*</span></label>
                        <input type="date" class="form-control" id="calBatchEndDate" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Product <span class="text-danger">*</span></label>
                        <select class="form-select" id="calBatchProduct" required>
                            <option value="">Select product...</option>
                            @foreach (var item in Model.Products)
                            {
                                <option value="@item.Id" data-has-formulation="@item.HasFormulation.ToString().ToLower()">@item.Name</option>
                            }
                        </select>
                        <div id="calFormulationWarning" class="text-danger small mt-1" style="display: none;">
                            <i class="bi bi-exclamation-triangle me-1"></i>This product has no formulation. Please add a formulation before producing.
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Equipment <span class="text-danger">*</span></label>
                        <select class="form-select" id="calBatchEquipment" required>
                            <option value="">Select equipment...</option>
                            @foreach (var item in Model.Equipments)
                            {
                                <option value="@item.Id">@item.Name</option>
                            }
                        </select>
                        <div class="form-text">Only available equipment is shown.</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Quantity <span class="text-danger">*</span></label>
                        <input type="number" class="form-control" id="calBatchQuantity" min="1" value="1" required>
                    </div>
                    <div class="mb-3" id="calEstimatedCostSection" style="display: none;">
                        <label class="form-label fw-semibold">Estimated Total Cost</label>
                        <div class="alert alert-light border mb-0">
                            <span class="fw-bold text-primary fs-5" id="calEstimatedCostValue">-</span>
                            <div class="text-muted small">Cost per unit: <span id="calCostPerUnitValue">-</span></div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="calCreateBatchBtn" onclick="calCreateBatch()">
                    <i class="bi bi-check-lg me-1"></i>Create Batch
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- FullCalendar CDN -->
    <link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.js"></script>

    <style>
        /* FullCalendar theme overrides to match DairyFlow design */
        #fullCalendar {
            padding: 1rem 1.5rem 1.5rem;
        }

        .fc {
            font-family: 'Inter', sans-serif;
        }

        .fc .fc-toolbar-title {
            font-size: 1.1rem;
            font-weight: 700;
            color: #0f172a;
        }

        .fc .fc-button {
            background: #ffffff;
            border: 1px solid #dee2e6;
            color: #495057;
            font-size: 0.85rem;
            font-weight: 500;
            padding: 0.3rem 0.75rem;
            box-shadow: none;
        }

        .fc .fc-button:hover {
            background: #f0f7ff;
            border-color: #0d6efd;
            color: #0d6efd;
        }

        .fc .fc-button-active,
        .fc .fc-button:active {
            background: #0d6efd !important;
            border-color: #0d6efd !important;
            color: #fff !important;
        }

        .fc .fc-col-header-cell {
            background: #f8fafc;
            font-size: 0.8rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            color: #64748b;
            padding: 0.75rem 0.5rem;
        }

        .fc .fc-daygrid-day {
            min-height: 120px;
            cursor: pointer;
            transition: background-color 0.15s ease;
        }

        .fc .fc-daygrid-day:hover {
            background-color: #f0f7ff;
        }

        .fc .fc-day-today {
            background: rgba(13, 110, 253, 0.04) !important;
            box-shadow: inset 0 0 0 2px rgba(13, 110, 253, 0.2);
        }

        .fc .fc-day-other {
            background: #fafbff;
        }

        .fc .fc-daygrid-day-number {
            font-weight: 600;
            color: #0f172a;
            padding: 0.5rem;
        }

        .fc .fc-daygrid-day:hover .fc-daygrid-day-number {
            color: #0d6efd;
        }

        /* Event styling per status */
        .fc-event {
            border: none !important;
            border-radius: 6px !important;
            padding: 2px 6px !important;
            font-size: 0.75rem !important;
            margin-bottom: 2px !important;
            cursor: pointer;
        }

        .fc-event .fc-event-title {
            font-weight: 600;
        }

        .fc-event.status-in-production {
            background: #fde8e8 !important;
            border-left: 3px solid #dc3545 !important;
            color: #1a1a2e !important;
        }

        .fc-event.status-completed {
            background: #d4edda !important;
            border-left: 3px solid #28a745 !important;
            color: #1a1a2e !important;
        }

        .fc-event.status-scheduled {
            background: #d1ecf1 !important;
            border-left: 3px solid #17a2b8 !important;
            color: #1a1a2e !important;
        }

        .fc-event.status-paused {
            background: #fff3cd !important;
            border-left: 3px solid #ffc107 !important;
            color: #1a1a2e !important;
        }

        .fc .fc-more-link {
            font-size: 0.75rem;
            color: #64748b;
            font-weight: 500;
        }

        .fc .fc-popover {
            border-radius: 10px;
            box-shadow: 0 8px 24px rgba(0,0,0,0.12);
        }
    </style>

    <script>
        const scheduleEvents = @Html.Raw(scheduleJson);
        let calCostPerUnit = 0;
        let calendarInstance = null;

        // Map status to CSS class
        function getStatusClass(status) {
            const map = {
                'In Production': 'status-in-production',
                'Completed': 'status-completed',
                'Scheduled': 'status-scheduled',
                'Paused': 'status-paused'
            };
            return map[status] || '';
        }

        // Initialize FullCalendar
        document.addEventListener('DOMContentLoaded', function () {
            const calendarEl = document.getElementById('fullCalendar');

            calendarInstance = new FullCalendar.Calendar(calendarEl, {
                initialView: 'dayGridMonth',
                headerToolbar: {
                    left: 'prev,next today',
                    center: 'title',
                    right: 'dayGridMonth,dayGridWeek,listWeek'
                },
                buttonText: {
                    today: 'Today',
                    month: 'Month',
                    week: 'Week',
                    list: 'List'
                },
                height: 'auto',
                fixedWeekCount: false,
                dayMaxEvents: 3,
                events: scheduleEvents,
                eventClassNames: function (arg) {
                    const status = arg.event.extendedProps.status || '';
                    return [getStatusClass(status)];
                },
                eventContent: function (arg) {
                    const props = arg.event.extendedProps;
                    return {
                        html: `<div class="fc-event-title" style="font-weight:600;color:#1a1a2e;">${props.batchCode}</div>
                               <div style="font-size:0.7rem;color:#1a1a2e;opacity:0.85;">${props.productName}</div>`
                    };
                },
                eventClick: function (info) {
                    info.jsEvent.preventDefault();
                    info.jsEvent.stopPropagation();
                    viewScheduleBatchDetail(info.event.id);
                },
                dateClick: function (info) {
                    // Get events on this date
                    const dateStr = info.dateStr;
                    const eventsOnDate = scheduleEvents.filter(e => {
                        if (!e.start) return false;
                        const start = e.start;
                        const end = e.end || e.start;
                        return dateStr >= start && dateStr < end;
                    });

                    if (eventsOnDate.length > 0) {
                        openDateDetailModal(dateStr, eventsOnDate);
                    } else {
                        openCalendarCreateBatch(dateStr);
                    }
                }
            });

            calendarInstance.render();
        });

        function formatDateKey(date) {
            const year = date.getFullYear();
            const month = String(date.getMonth() + 1).padStart(2, '0');
            const day = String(date.getDate()).padStart(2, '0');
            return `${year}-${month}-${day}`;
        }

        function openDateDetailModal(dateKey, events) {
            const d = new Date(dateKey + 'T00:00:00');
            const formatted = d.toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
            document.getElementById('dateDetailTitle').textContent = formatted;

            const statusColors = {
                'In Production': 'bg-danger',
                'Completed': 'bg-success',
                'Scheduled': 'bg-info',
                'Paused': 'bg-warning'
            };

            // De-duplicate by id
            const unique = [];
            const seen = new Set();
            events.forEach(e => {
                if (!seen.has(e.id)) {
                    seen.add(e.id);
                    unique.push(e);
                }
            });

            let html = '';
            unique.forEach(ev => {
                const props = ev.extendedProps || ev;
                const status = props.status || ev.status;
                const badge = statusColors[status] || 'bg-secondary';
                const batchCode = props.batchCode || ev.title;
                const productName = props.productName || '';
                const equipmentName = props.equipmentName || '';
                const startDate = ev.start || '';
                const endDate = ev.end || ev.start || '';
                html += `
                    <div class="date-detail-item" onclick="viewScheduleBatchDetail(${ev.id})" style="cursor:pointer;">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="fw-semibold">${batchCode}</div>
                                <div class="text-muted small">${productName} &middot; ${equipmentName}</div>
                                <div class="text-muted small">${startDate} &rarr; ${endDate}</div>
                            </div>
                            <span class="badge ${badge}">${status}</span>
                        </div>
                    </div>
                `;
            });
            document.getElementById('dateDetailList').innerHTML = html;
            document.getElementById('dateDetailAddBtn').setAttribute('data-date', dateKey);
            new bootstrap.Modal(document.getElementById('dateDetailModal')).show();
        }

        async function viewScheduleBatchDetail(batchId) {
            // Close any open modal first
            const dateModal = bootstrap.Modal.getInstance(document.getElementById('dateDetailModal'));
            if (dateModal) dateModal.hide();

            try {
                const response = await fetch(`@Url.Action("GetBatchDetail", "Production")/${batchId}`);
                if (response.ok) {
                    const batch = await response.json();
                    const badgeClass = {
                        'In Production': 'bg-danger',
                        'Scheduled': 'bg-info',
                        'Paused': 'bg-warning',
                        'Completed': 'bg-success'
                    }[batch.status] || 'bg-secondary';

                    const content = `
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold text-muted small">Batch Code</label>
                                <input type="text" class="form-control" value="${batch.batchCode}" readonly>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold text-muted small">Status</label>
                                <div class="mt-2"><span class="badge ${badgeClass}">${batch.status}</span></div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold text-muted small">Start Date</label>
                                <input type="text" class="form-control" value="${batch.startDate ? new Date(batch.startDate).toLocaleDateString() : '-'}" readonly>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold text-muted small">End Date</label>
                                <input type="text" class="form-control" value="${batch.endDate ? new Date(batch.endDate).toLocaleDateString() : '-'}" readonly>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold text-muted small">Product</label>
                                <input type="text" class="form-control" value="${batch.productName}" readonly>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold text-muted small">Equipment</label>
                                <input type="text" class="form-control" value="${batch.equipmentName}" readonly>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold text-muted small">Operator</label>
                                <input type="text" class="form-control" value="${batch.userName}" readonly>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold text-muted small">Quantity</label>
                                <input type="text" class="form-control" value="${batch.quantity}" readonly>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold text-muted small">Total Cost</label>
                                <input type="text" class="form-control" value="${batch.totalCost != null ? '$' + batch.totalCost.toFixed(2) : '-'}" readonly>
                            </div>
                        </div>
                    `;
                    document.getElementById('scheduleBatchDetailContent').innerHTML = content;
                    new bootstrap.Modal(document.getElementById('scheduleBatchDetailModal')).show();
                }
            } catch (error) {
                console.error(error);
                showGlobalToast('error', 'Failed to load batch details');
            }
        }

        function dateDetailAddBatch() {
            const dateKey = document.getElementById('dateDetailAddBtn').getAttribute('data-date');
            const dateModal = bootstrap.Modal.getInstance(document.getElementById('dateDetailModal'));
            if (dateModal) dateModal.hide();
            setTimeout(() => openCalendarCreateBatch(dateKey), 300);
        }

        function openCalendarCreateBatch(dateKey) {
            document.getElementById('calBatchStartDate').value = dateKey;
            const start = new Date(dateKey + 'T00:00:00');
            start.setDate(start.getDate() + 1);
            document.getElementById('calBatchEndDate').value = formatDateKey(start);
            document.getElementById('calBatchProduct').value = '';
            document.getElementById('calBatchEquipment').value = '';
            document.getElementById('calBatchQuantity').value = '1';
            document.getElementById('calFormulationWarning').style.display = 'none';
            document.getElementById('calCreateBatchBtn').disabled = false;
            document.getElementById('calEstimatedCostSection').style.display = 'none';
            calCostPerUnit = 0;
            new bootstrap.Modal(document.getElementById('calendarCreateBatchModal')).show();
        }

        // Product selection handler for calendar modal
        document.getElementById('calBatchProduct').addEventListener('change', async function () {
            const selectedOption = this.options[this.selectedIndex];
            const hasFormulation = selectedOption.dataset.hasFormulation === 'true';
            const productId = this.value;
            const warning = document.getElementById('calFormulationWarning');
            const createBtn = document.getElementById('calCreateBatchBtn');
            const costSection = document.getElementById('calEstimatedCostSection');

            if (!productId) {
                warning.style.display = 'none';
                createBtn.disabled = false;
                costSection.style.display = 'none';
                calCostPerUnit = 0;
                return;
            }

            if (!hasFormulation) {
                warning.style.display = 'block';
                createBtn.disabled = true;
                costSection.style.display = 'none';
                calCostPerUnit = 0;
            } else {
                warning.style.display = 'none';
                createBtn.disabled = false;
                try {
                    const response = await fetch(`@Url.Action("CheckProductFormulation", "Production")?productId=${productId}`);
                    if (response.ok) {
                        const data = await response.json();
                        calCostPerUnit = data.costPerUnit;
                        document.getElementById('calCostPerUnitValue').textContent = '₱' + calCostPerUnit.toFixed(2);
                        calUpdateEstimatedCost();
                        costSection.style.display = 'block';
                    }
                } catch (e) { console.error(e); }
            }
        });

        document.getElementById('calBatchQuantity').addEventListener('input', calUpdateEstimatedCost);

        function calUpdateEstimatedCost() {
            const qty = parseInt(document.getElementById('calBatchQuantity').value) || 0;
            const total = calCostPerUnit * qty;
            document.getElementById('calEstimatedCostValue').textContent = '₱' + total.toFixed(2);
        }

        async function calCreateBatch() {
            const form = document.getElementById('calendarCreateBatchForm');
            if (!form.checkValidity()) {
                form.classList.add('was-validated');
                return;
            }

            const data = {
                startDate: document.getElementById('calBatchStartDate').value,
                endDate: document.getElementById('calBatchEndDate').value,
                status: 'Scheduled',
                productID: parseInt(document.getElementById('calBatchProduct').value),
                equipmentID: parseInt(document.getElementById('calBatchEquipment').value),
                quantity: parseInt(document.getElementById('calBatchQuantity').value)
            };

            try {
                const response = await fetch('@Url.Action("CreateBatch", "Production")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify(data)
                });

                if (response.ok) {
                    const result = await response.json();
                    showGlobalToast('success', result.message);
                    setTimeout(() => window.location.reload(), 300);
                } else {
                    const errorText = await response.text();
                    showGlobalToast('error', errorText || 'Failed to create batch');
                }
            } catch (error) {
                showGlobalToast('error', 'An error occurred');
                console.error(error);
            }
        }
    </script>
}

@Html.AntiForgeryToken()
