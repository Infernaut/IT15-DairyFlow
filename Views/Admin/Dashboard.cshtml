@using IT15_DairyFlow.Models.Admin
@model AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "_Layout";
}

<div class="container-fluid p-4">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1 fw-bold">@Model.CompanyName</h2>
            <p class="text-muted mb-0">Administrative Dashboard - Company Overview & KPIs</p>
        </div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("Users")" class="btn btn-outline-primary">
                <i class="bi bi-people me-1"></i> Manage Users
            </a>
            <a href="@Url.Action("Logs")" class="btn btn-primary">
                <i class="bi bi-journal-text me-1"></i> View Logs
            </a>
        </div>
    </div>

    <!-- Primary KPI Cards -->
    <div class="row g-4 mb-4">
        <div class="col-md-3 col-sm-6">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="rounded-circle bg-primary bg-opacity-10 p-3 me-3">
                            <i class="bi bi-people-fill text-primary fs-4"></i>
                        </div>
                        <div>
                            <h6 class="text-muted mb-1 small text-uppercase">Total Users</h6>
                            <h3 class="mb-0 fw-bold">@Model.TotalUsers</h3>
                        </div>
                    </div>
                    <div class="progress" style="height: 4px;">
                        <div class="progress-bar bg-primary" style="width: 100%"></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="rounded-circle bg-success bg-opacity-10 p-3 me-3">
                            <i class="bi bi-person-check-fill text-success fs-4"></i>
                        </div>
                        <div>
                            <h6 class="text-muted mb-1 small text-uppercase">Active Users</h6>
                            <h3 class="mb-0 fw-bold">@Model.ActiveUsers</h3>
                        </div>
                    </div>
                    <div class="progress" style="height: 4px;">
                        <div class="progress-bar bg-success" style="width: @(Model.TotalUsers > 0 ? (Model.ActiveUsers * 100 / Model.TotalUsers) : 0)%"></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="rounded-circle bg-warning bg-opacity-10 p-3 me-3">
                            <i class="bi bi-person-dash-fill text-warning fs-4"></i>
                        </div>
                        <div>
                            <h6 class="text-muted mb-1 small text-uppercase">Inactive Users</h6>
                            <h3 class="mb-0 fw-bold">@Model.InactiveUsers</h3>
                        </div>
                    </div>
                    <div class="progress" style="height: 4px;">
                        <div class="progress-bar bg-warning" style="width: @(Model.TotalUsers > 0 ? (Model.InactiveUsers * 100 / Model.TotalUsers) : 0)%"></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="rounded-circle bg-info bg-opacity-10 p-3 me-3">
                            <i class="bi bi-shield-fill-check text-info fs-4"></i>
                        </div>
                        <div>
                            <h6 class="text-muted mb-1 small text-uppercase">Admin Users</h6>
                            <h3 class="mb-0 fw-bold">@Model.AdminUsers</h3>
                        </div>
                    </div>
                    <div class="progress" style="height: 4px;">
                        <div class="progress-bar bg-info" style="width: @(Model.TotalUsers > 0 ? (Model.AdminUsers * 100 / Model.TotalUsers) : 0)%"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Business Metrics Row -->
    <div class="row g-4 mb-4">
        <!-- Production Metrics -->
        <div class="col-lg-4">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-header bg-transparent border-0 pb-0">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-gear-fill text-primary me-2"></i>
                        <h6 class="mb-0 fw-semibold">Production Overview</h6>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row text-center">
                        <div class="col-4">
                            <div class="border-end">
                                <h4 class="fw-bold text-primary mb-1">@Model.KPIMetrics.TotalProductionBatches</h4>
                                <small class="text-muted">Total Batches</small>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="border-end">
                                <h4 class="fw-bold text-success mb-1">@Model.KPIMetrics.CompletedBatches</h4>
                                <small class="text-muted">Completed</small>
                            </div>
                        </div>
                        <div class="col-4">
                            <h4 class="fw-bold text-warning mb-1">@Model.KPIMetrics.OngoingBatches</h4>
                            <small class="text-muted">In Progress</small>
                        </div>
                    </div>
                    <hr>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-muted">Completion Rate</span>
                        <span class="badge bg-primary-subtle text-primary">@Model.KPIMetrics.ProductionCompletionRate.ToString("F1")%</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Quality Metrics -->
        <div class="col-lg-4">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-header bg-transparent border-0 pb-0">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-clipboard-check-fill text-success me-2"></i>
                        <h6 class="mb-0 fw-semibold">Quality Control</h6>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row text-center">
                        <div class="col-4">
                            <div class="border-end">
                                <h4 class="fw-bold text-primary mb-1">@Model.KPIMetrics.TotalQualityInspections</h4>
                                <small class="text-muted">Inspections</small>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="border-end">
                                <h4 class="fw-bold text-success mb-1">@Model.KPIMetrics.PassedInspections</h4>
                                <small class="text-muted">Passed</small>
                            </div>
                        </div>
                        <div class="col-4">
                            <h4 class="fw-bold text-danger mb-1">@Model.KPIMetrics.FailedInspections</h4>
                            <small class="text-muted">Failed</small>
                        </div>
                    </div>
                    <hr>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-muted">Pass Rate</span>
                        <span class="badge bg-success-subtle text-success">@Model.KPIMetrics.QualityPassRate.ToString("F1")%</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Inventory Metrics -->
        <div class="col-lg-4">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-header bg-transparent border-0 pb-0">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-box-seam-fill text-info me-2"></i>
                        <h6 class="mb-0 fw-semibold">Inventory Status</h6>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row text-center">
                        <div class="col-6">
                            <div class="border-end">
                                <h4 class="fw-bold text-primary mb-1">@Model.KPIMetrics.TotalInventoryItems</h4>
                                <small class="text-muted">Total Items</small>
                            </div>
                        </div>
                        <div class="col-6">
                            <h4 class="fw-bold text-warning mb-1">@Model.KPIMetrics.LowStockItems</h4>
                            <small class="text-muted">Low Stock</small>
                        </div>
                    </div>
                    <hr>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-muted">Avg. Stock Level</span>
                        <span class="badge bg-info-subtle text-info">@Model.KPIMetrics.AverageInventoryHealth.ToString("F0") units</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Product & Financial Row -->
    <div class="row g-4 mb-4">
        <!-- Product Metrics -->
        <div class="col-lg-6">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-header bg-transparent border-0 pb-0">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-box-fill text-primary me-2"></i>
                        <h6 class="mb-0 fw-semibold">Product Portfolio</h6>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <div class="p-3 bg-light rounded text-center">
                                <h4 class="fw-bold text-primary mb-1">@Model.KPIMetrics.TotalProducts</h4>
                                <small class="text-muted">Total Products</small>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="p-3 bg-light rounded text-center">
                                <h4 class="fw-bold text-success mb-1">@Model.KPIMetrics.ActiveProducts</h4>
                                <small class="text-muted">Active</small>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="p-3 bg-light rounded text-center">
                                <h4 class="fw-bold text-danger mb-1">@Model.KPIMetrics.DiscontinuedProducts</h4>
                                <small class="text-muted">Discontinued</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Financial Summary -->
        <div class="col-lg-6">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-header bg-transparent border-0 pb-0">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-currency-dollar text-success me-2"></i>
                        <h6 class="mb-0 fw-semibold">Financial Summary</h6>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <div class="p-3 bg-light rounded text-center">
                                <h4 class="fw-bold text-success mb-1">₱@Model.KPIMetrics.TotalRevenue.ToString("N0")</h4>
                                <small class="text-muted">Revenue</small>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="p-3 bg-light rounded text-center">
                                <h4 class="fw-bold text-danger mb-1">₱@Model.KPIMetrics.TotalExpenses.ToString("N0")</h4>
                                <small class="text-muted">Expenses</small>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="p-3 bg-light rounded text-center">
                                <h4 class="fw-bold text-info mb-1">@Model.KPIMetrics.BudgetUtilization.ToString("F1")%</h4>
                                <small class="text-muted">Budget Used</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Statistical Charts -->
    <div class="row g-4 mb-4">
        <!-- Production Trend Chart -->
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-transparent border-0 pb-0">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-bar-chart-fill text-primary me-2"></i>
                        <h6 class="mb-0 fw-semibold">Production Trend</h6>
                    </div>
                </div>
                <div class="card-body">
                    <canvas id="productionChart" height="220"></canvas>
                </div>
            </div>
        </div>
        <!-- Quality Inspection Chart -->
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-transparent border-0 pb-0">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-pie-chart-fill text-success me-2"></i>
                        <h6 class="mb-0 fw-semibold">Quality Inspections</h6>
                    </div>
                </div>
                <div class="card-body d-flex align-items-center justify-content-center">
                    <canvas id="qualityChart" height="220"></canvas>
                </div>
            </div>
        </div>
        <!-- Revenue vs Expenses Chart -->
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-transparent border-0 pb-0">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-graph-up-arrow text-danger me-2"></i>
                        <h6 class="mb-0 fw-semibold">Revenue vs Expenses</h6>
                    </div>
                </div>
                <div class="card-body">
                    <canvas id="financeChart" height="220"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- System Activity & Recent Logs -->
    <div class="row g-4">
        <!-- System Activity -->
        <div class="col-lg-4">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-header bg-transparent border-0 pb-0">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-activity text-primary me-2"></i>
                        <h6 class="mb-0 fw-semibold">System Activity</h6>
                    </div>
                </div>
                <div class="card-body">
                    <div class="mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-muted">Last 30 Days Activity</span>
                            <span class="badge bg-primary">@Model.KPIMetrics.SystemActivityCount actions</span>
                        </div>
                        <div class="progress" style="height: 8px;">
                            <div class="progress-bar bg-primary" style="width: @(Math.Min(100, Model.KPIMetrics.SystemActivityCount))%"></div>
                        </div>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-muted">Last Modified</span>
                        <span class="fw-semibold">@Model.KPIMetrics.LastModifiedDate.ToString("MMM dd, yyyy HH:mm")</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Recent Audit Logs -->
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-journal-text text-primary me-2"></i>
                        <h6 class="mb-0 fw-semibold">Recent Activity Logs</h6>
                    </div>
                    <a href="@Url.Action("Logs")" class="btn btn-sm btn-outline-primary">View All</a>
                </div>
                <div class="card-body p-0">
                    @if (Model.RecentAuditLogs.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="px-4">User</th>
                                        <th>Action</th>
                                        <th class="text-end px-4">Timestamp</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var log in Model.RecentAuditLogs.Take(8))
                                    {
                                        <tr>
                                            <td class="px-4">
                                                <div class="d-flex align-items-center">
                                                    <div class="rounded-circle bg-primary bg-opacity-10 p-2 me-2">
                                                        <i class="bi bi-person text-primary"></i>
                                                    </div>
                                                    <div>
                                                        <div class="fw-semibold">@log.UserName</div>
                                                        <small class="text-muted">@log.UserEmail</small>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <span class="badge @log.ActionBadgeClass">@log.Action</span>
                                            </td>
                                            <td class="text-end px-4">
                                                <small class="text-muted">@log.FormattedTimeStamp</small>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center text-muted py-5">
                            <i class="bi bi-journal display-4 d-block mb-3 opacity-25"></i>
                            <p class="mb-0">No activity logs available yet.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        // Production Trend (Bar)
        new Chart(document.getElementById('productionChart'), {
            type: 'bar',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyBatchLabels)),
                datasets: [{
                    label: 'Batches',
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyBatchCounts)),
                    backgroundColor: 'rgba(13, 110, 253, 0.7)',
                    borderColor: '#0d6efd',
                    borderWidth: 1,
                    borderRadius: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } }
            }
        });

        // Quality Inspection (Doughnut)
        new Chart(document.getElementById('qualityChart'), {
            type: 'doughnut',
            data: {
                labels: ['Passed', 'Failed', 'Pending'],
                datasets: [{
                    data: [
                        @Model.KPIMetrics.PassedInspections,
                        @Model.KPIMetrics.FailedInspections,
                        @(Model.KPIMetrics.TotalQualityInspections - Model.KPIMetrics.PassedInspections - Model.KPIMetrics.FailedInspections)
                    ],
                    backgroundColor: ['#198754', '#dc3545', '#ffc107'],
                    borderWidth: 0
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { position: 'bottom' } }
            }
        });

        // Revenue vs Expenses (Line)
        new Chart(document.getElementById('financeChart'), {
            type: 'line',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyRevenueLabels)),
                datasets: [
                    {
                        label: 'Revenue',
                        data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyRevenues)),
                        borderColor: '#198754',
                        backgroundColor: 'rgba(25, 135, 84, 0.1)',
                        fill: true,
                        tension: 0.4
                    },
                    {
                        label: 'Expenses',
                        data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyExpenses)),
                        borderColor: '#dc3545',
                        backgroundColor: 'rgba(220, 53, 69, 0.1)',
                        fill: true,
                        tension: 0.4
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { position: 'bottom' } },
                scales: { y: { beginAtZero: true } }
            }
        });
    </script>
}