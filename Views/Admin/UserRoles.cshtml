@model IT15_DairyFlow.Models.Admin.UserRolesViewModel

@{
    ViewData["Title"] = "Manage User Roles";
}

<div class="container-fluid p-4">
    <div class="mb-4">
        <h2 class="mb-1">Manage Roles</h2>
        <p class="text-muted mb-0">Update role assignments for @Model.Email.</p>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="UserRoles" method="post">
                @Html.AntiForgeryToken()
                <input asp-for="UserId" type="hidden" />

                @if (Model.Roles.Count == 0)
                {
                    <div class="text-muted">No roles available yet. Create a role first.</div>
                }
                else
                {
                    <div class="row">
                        @for (var i = 0; i < Model.Roles.Count; i++)
                        {
                            <div class="col-md-6 mb-2">
                                <div class="form-check">
                                    <input asp-for="Roles[i].Selected" class="form-check-input" />
                                    <label asp-for="Roles[i].Selected" class="form-check-label">@Model.Roles[i].RoleName</label>
                                    <input asp-for="Roles[i].RoleId" type="hidden" />
                                    <input asp-for="Roles[i].RoleName" type="hidden" />
                                </div>
                            </div>
                        }
                    </div>
                }

                <div class="d-flex gap-2 mt-3">
                    <button type="submit" class="btn btn-primary">Save Roles</button>
                    <a class="btn btn-outline-secondary" asp-action="Users">Back to Users</a>
                </div>
            </form>
        </div>
    </div>
</div>
