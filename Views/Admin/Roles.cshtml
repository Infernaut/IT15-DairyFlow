@model IReadOnlyList<IT15_DairyFlow.Models.Admin.RoleListItemViewModel>

@{
    ViewData["Title"] = "Role Management";
}

<div class="container-fluid p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Role Management</h2>
            <p class="text-muted mb-0">Create and edit roles for access control.</p>
        </div>
        <a class="btn btn-primary" asp-action="CreateRole">
            <i class="bi bi-plus-circle me-1"></i> Add Role
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Role</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="2" class="text-center text-muted py-4">No roles found.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var role in Model)
                        {
                            <tr>
                                <td>@role.Name</td>
                                <td class="text-end">
                                    <a class="btn btn-sm btn-outline-primary" asp-action="EditRole" asp-route-id="@role.Id">Edit</a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
