@using IT15_DairyFlow.Models.Admin
@model AuditLogFilterViewModel

@{
    ViewData["Title"] = "Audit Logs";
}

<div class="container-fluid mt-4">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-md-12">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <h1 class="card-title mb-2">Audit Logs</h1>
                    <p class="text-muted mb-0">Administrative activity tracking and monitoring</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter Section -->
    <div class="row mb-4">
        <div class="col-md-12">
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Filter Logs</h5>
                </div>
                <div class="card-body">
                    <form method="get" class="row g-3">
                        <div class="col-md-3">
                            <label for="startDate" class="form-label">Start Date</label>
                            <input type="date" class="form-control" id="startDate" name="startDate" value="@Model.StartDate?.ToString("yyyy-MM-dd")">
                        </div>
                        <div class="col-md-3">
                            <label for="endDate" class="form-label">End Date</label>
                            <input type="date" class="form-control" id="endDate" name="endDate" value="@Model.EndDate?.ToString("yyyy-MM-dd")">
                        </div>
                        <div class="col-md-3">
                            <label for="actionFilter" class="form-label">Action</label>
                            <input type="text" class="form-control" id="actionFilter" name="actionFilter" placeholder="e.g., Created, Updated, Deleted" value="@Model.ActionFilter">
                        </div>
                        <div class="col-md-3 d-flex align-items-end gap-2">
                            <button type="submit" class="btn btn-primary w-100">Filter</button>
                            <a href="@Url.Action("Logs")" class="btn btn-secondary">Reset</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Audit Logs Table -->
    <div class="row">
        <div class="col-md-12">
            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="mb-0">
                        Audit Logs
                        <span class="badge badge-primary float-end">@Model.TotalRecords records</span>
                    </h5>
                </div>
                <div class="card-body">
                    @if (Model.AuditLogs.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width: 20%;">User Name</th>
                                        <th style="width: 25%;">Email</th>
                                        <th style="width: 35%;">Action</th>
                                        <th style="width: 20%;">Timestamp</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var log in Model.AuditLogs)
                                    {
                                        <tr>
                                            <td>
                                                <span class="font-weight-bold">@log.UserName</span>
                                            </td>
                                            <td>
                                                <span class="text-muted">@log.UserEmail</span>
                                            </td>
                                            <td>
                                                <span class="badge @log.ActionBadgeClass">@log.Action</span>
                                            </td>
                                            <td>
                                                <small class="text-muted">@log.FormattedTimeStamp</small>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center text-muted py-5">
                            <i class="fas fa-inbox fa-3x mb-3" style="opacity: 0.5;"></i>
                            <p>No audit logs found matching your criteria.</p>
                            <a href="@Url.Action("Logs")" class="btn btn-sm btn-outline-primary">Clear Filters</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .badge-success {
        background-color: #28a745;
    }
    .badge-info {
        background-color: #17a2b8;
    }
    .badge-danger {
        background-color: #dc3545;
    }
    .badge-primary {
        background-color: #007bff;
    }
    .badge-secondary {
        background-color: #6c757d;
    }
    .badge-warning {
        background-color: #ffc107;
        color: #000;
    }
    .badge-light {
        background-color: #f8f9fa;
        color: #000;
    }

    .table-hover tbody tr:hover {
        background-color: #f9f9f9;
    }
</style>
