@model IT15_DairyFlow.Models.Sub.PaymentMethodViewModel
@{
    ViewData["Title"] = "Payment Method — DairyFlow ERP";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>
    :root {
        --blue-main: #0d6efd;
        --blue-soft: #4dabf7;
        --blue-sky: #e7f3ff;
        --blue-deep: #0b5ed7;
        --green-accent: #20c997;
        --border-soft: #dbe7f3;
    }

    body {
        background: linear-gradient(180deg, #f8fbff, #eef6ff);
        min-height: 100vh;
    }

    .payment-container {
        max-width: 700px;
        margin: 3rem auto;
    }

    .step-indicator {
        display: flex;
        justify-content: center;
        gap: 8px;
        margin-bottom: 16px;
    }

    .step-dot {
        width: 32px;
        height: 4px;
        border-radius: 2px;
        background: #dee2e6;
    }

    .step-dot.active {
        background: linear-gradient(135deg, var(--green-accent), var(--blue-main));
    }

    .payment-card {
        background: #ffffff;
        border-radius: 24px;
        border: 1px solid var(--border-soft);
        box-shadow: 0 20px 40px rgba(13, 110, 253, 0.08);
        overflow: hidden;
    }

    .order-summary {
        background: linear-gradient(135deg, var(--blue-sky), #f0f7ff);
        border-bottom: 1px solid var(--border-soft);
        padding: 24px 32px;
    }

    .method-option {
        border: 2px solid var(--border-soft);
        border-radius: 16px;
        padding: 20px;
        cursor: pointer;
        transition: all 0.25s ease;
        position: relative;
    }

    .method-option:hover {
        border-color: var(--blue-soft);
        background: var(--blue-sky);
    }

    .method-option.selected {
        border-color: var(--blue-main);
        background: var(--blue-sky);
        box-shadow: 0 0 0 3px rgba(13, 110, 253, 0.1);
    }

    .method-option input[type="radio"] {
        display: none;
    }

    .method-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.3rem;
    }

    .method-icon.card-icon {
        background: linear-gradient(135deg, #667eea, #764ba2);
        color: white;
    }

    .method-icon.gcash-icon {
        background: linear-gradient(135deg, #007bff, #00d4ff);
        color: white;
    }

    .method-icon.paymaya-icon {
        background: linear-gradient(135deg, #00b300, #00cc66);
        color: white;
    }

    .method-check {
        position: absolute;
        top: 12px;
        right: 12px;
        color: var(--blue-main);
        font-size: 1.2rem;
        display: none;
    }

    .method-option.selected .method-check {
        display: block;
    }

    .btn-pay {
        background: linear-gradient(135deg, var(--blue-soft), var(--blue-main));
        border: none;
        padding: 0.85rem;
        font-weight: 700;
        font-size: 1rem;
        border-radius: 12px;
        transition: all 0.3s ease;
        color: white;
    }

    .btn-pay:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(13, 110, 253, 0.3);
        color: white;
    }

    .btn-pay:disabled {
        opacity: 0.5;
        transform: none;
        box-shadow: none;
    }

    .secure-badge {
        background: rgba(32, 201, 151, 0.1);
        border: 1px solid rgba(32, 201, 151, 0.2);
        border-radius: 50px;
        padding: 6px 16px;
        font-size: 0.8rem;
        color: #0ca678;
        font-weight: 600;
    }

    .bi {
        display: inline-block !important;
        line-height: 1;
    }
</style>

<div class="container payment-container">
    <div class="text-center mb-4">
        <div class="step-indicator">
            <div class="step-dot active"></div>
            <div class="step-dot active"></div>
            <div class="step-dot active"></div>
        </div>
        <h2 class="fw-bold text-primary mb-2">Choose Payment Method</h2>
        <p class="text-muted">Step 3 of 3 — Select how you'd like to pay.</p>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="payment-card">
        <!-- Order Summary -->
        <div class="order-summary">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="fw-bold text-primary mb-1">Order Summary</h6>
                    <p class="text-muted small mb-0">@Model.PlanName — @Model.BillingCycle billing</p>
                </div>
                <div class="text-end">
                    <p class="fw-bold fs-4 text-primary mb-0">₱@Model.Price.ToString("N0")</p>
                    <p class="text-muted small mb-0">/ @Model.BillingCycle.ToLower()</p>
                </div>
            </div>
        </div>

        <!-- Payment Methods -->
        <div class="p-4">
            <form asp-action="ProcessPayment" asp-controller="Subscription" method="post" id="paymentForm">
                @Html.AntiForgeryToken()

                <h6 class="fw-bold mb-3">
                    <i class="bi bi-credit-card-2-back me-2 text-primary"></i> Payment Options
                </h6>

                <div class="d-flex flex-column gap-3 mb-4">
                    <!-- Card Payment -->
                    <label class="method-option" id="opt-card" onclick="selectMethod('card')">
                        <input type="radio" name="paymentMethod" value="card" />
                        <i class="bi bi-check-circle-fill method-check"></i>
                        <div class="d-flex align-items-center gap-3">
                            <div class="method-icon card-icon">
                                <i class="bi bi-credit-card-fill"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-0">Credit / Debit Card</h6>
                                <p class="text-muted small mb-0">Visa, Mastercard & more</p>
                            </div>
                        </div>
                    </label>

                    <!-- GCash -->
                    <label class="method-option" id="opt-gcash" onclick="selectMethod('gcash')">
                        <input type="radio" name="paymentMethod" value="gcash" />
                        <i class="bi bi-check-circle-fill method-check"></i>
                        <div class="d-flex align-items-center gap-3">
                            <div class="method-icon gcash-icon">
                                <i class="bi bi-phone-fill"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-0">GCash</h6>
                                <p class="text-muted small mb-0">Pay with your GCash e-wallet</p>
                            </div>
                        </div>
                    </label>

                    <!-- PayMaya -->
                    <label class="method-option" id="opt-paymaya" onclick="selectMethod('paymaya')">
                        <input type="radio" name="paymentMethod" value="paymaya" />
                        <i class="bi bi-check-circle-fill method-check"></i>
                        <div class="d-flex align-items-center gap-3">
                            <div class="method-icon paymaya-icon">
                                <i class="bi bi-wallet2"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-0">Maya (PayMaya)</h6>
                                <p class="text-muted small mb-0">Pay with your Maya e-wallet</p>
                            </div>
                        </div>
                    </label>
                </div>

                <button type="submit" class="btn btn-pay w-100 mb-3" id="payBtn" disabled>
                    <i class="bi bi-lock-fill me-2"></i> Proceed to Secure Payment
                </button>

                <div class="text-center">
                    <span class="secure-badge">
                        <i class="bi bi-shield-lock-fill me-1"></i> Secured by PayMongo
                    </span>
                </div>
            </form>
        </div>
    </div>

    <div class="text-center mt-3">
        <p class="text-muted small">
            You'll be redirected to PayMongo's secure payment page to complete your transaction.
        </p>
    </div>
</div>

@section Scripts {
    <script>
        function selectMethod(method) {
            // Remove selected from all
            document.querySelectorAll('.method-option').forEach(el => el.classList.remove('selected'));
            // Add to clicked
            document.getElementById('opt-' + method).classList.add('selected');
            // Check the radio
            document.querySelector('input[value="' + method + '"]').checked = true;
            // Enable button
            document.getElementById('payBtn').disabled = false;
        }
    </script>
}
