@model IT15_DairyFlow.Models.Sub.SubscriptionSuccessViewModel
@{
    ViewData["Title"] = "Welcome — DairyFlow ERP";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>
    :root {
        --blue-main: #0d6efd;
        --blue-soft: #4dabf7;
        --blue-sky: #e7f3ff;
        --green-accent: #20c997;
        --border-soft: #dbe7f3;
    }

    body {
        background: linear-gradient(180deg, #f8fbff, #eef6ff);
        min-height: 100vh;
    }

    .success-container {
        max-width: 600px;
        margin: 4rem auto;
    }

    .success-card {
        background: #ffffff;
        border-radius: 24px;
        border: 1px solid var(--border-soft);
        box-shadow: 0 20px 40px rgba(13, 110, 253, 0.08);
        overflow: hidden;
    }

    .success-header {
        background: linear-gradient(135deg, var(--green-accent), #0ca678);
        padding: 40px 32px;
        text-align: center;
        color: white;
        position: relative;
    }

    .success-header::before {
        content: "";
        position: absolute;
        width: 120px;
        height: 120px;
        background: rgba(255,255,255,0.1);
        border-radius: 50%;
        top: -40px;
        right: -40px;
    }

    .success-icon {
        width: 80px;
        height: 80px;
        background: rgba(255,255,255,0.2);
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 2.5rem;
        margin-bottom: 16px;
        animation: popIn 0.5s ease-out;
    }

    @@keyframes popIn {
        0% { transform: scale(0); opacity: 0; }
        60% { transform: scale(1.15); }
        100% { transform: scale(1); opacity: 1; }
    }

    .detail-row {
        display: flex;
        justify-content: space-between;
        padding: 10px 0;
        border-bottom: 1px solid #f0f3f7;
    }

    .detail-row:last-child {
        border-bottom: none;
    }

    .detail-label {
        color: #6c757d;
        font-size: 0.9rem;
    }

    .detail-value {
        color: #212529;
        font-weight: 600;
        font-size: 0.9rem;
    }

    .btn-login-now {
        background: linear-gradient(135deg, var(--blue-soft), var(--blue-main));
        border: none;
        padding: 0.85rem;
        font-weight: 700;
        font-size: 1rem;
        border-radius: 12px;
        transition: all 0.3s ease;
        color: white;
        text-decoration: none;
        display: block;
        text-align: center;
    }

    .btn-login-now:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(13, 110, 253, 0.3);
        color: white;
    }

    .bi {
        display: inline-block !important;
        line-height: 1;
    }
</style>

<div class="container success-container">
    <div class="success-card">
        <div class="success-header">
            <div class="success-icon">
                <i class="bi bi-check-lg"></i>
            </div>
            <h2 class="fw-bold mb-2">
                @(Model.IsFreeTrial ? "Trial Activated!" : "Payment Successful!")
            </h2>
            <p class="opacity-85 mb-0">
                @Model.Message
            </p>
        </div>

        <div class="p-4">
            <div class="mb-4">
                <div class="detail-row">
                    <span class="detail-label"><i class="bi bi-envelope me-2"></i> Email</span>
                    <span class="detail-value">@Model.Email</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label"><i class="bi bi-building me-2"></i> Company</span>
                    <span class="detail-value">@(Model.Email?.Split('@')[0])</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label"><i class="bi bi-tag me-2"></i> Plan</span>
                    <span class="detail-value text-primary">@Model.PlanName</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label"><i class="bi bi-calendar-check me-2"></i> Status</span>
                    <span class="detail-value text-success">
                        <i class="bi bi-circle-fill me-1" style="font-size: 0.5rem; vertical-align: middle;"></i>
                        Active
                    </span>
                </div>
            </div>

            <div class="bg-light rounded-3 p-3 mb-4 text-center">
                <p class="text-muted small mb-1">
                    <i class="bi bi-info-circle me-1"></i>
                    A confirmation email has been sent to <strong>@Model.Email</strong>
                </p>
                <p class="text-muted small mb-0">
                    You can now access the DairyFlow ERP system using your credentials.
                </p>
            </div>

            <a href="@Url.Page("/Account/Login", new { area = "Identity", Input_Email = Model.Email })"
               class="btn-login-now mb-3"
               id="loginLink">
                <i class="bi bi-unlock-fill me-2"></i> Log In to DairyFlow
            </a>

            <div class="text-center">
                <a asp-controller="Home" asp-action="Index" class="text-muted small text-decoration-none">
                    <i class="bi bi-house me-1"></i> Return to Home
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Auto-fill email on login page via query param
        (function () {
            var loginLink = document.getElementById('loginLink');
            if (loginLink) {
                var email = '@Html.Raw(Model.Email)';
                loginLink.href = '/Identity/Account/Login?email=' + encodeURIComponent(email);
            }
        })();
    </script>
}
