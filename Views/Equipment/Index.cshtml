@model IT15_DairyFlow.Controllers.EquipmentPageViewModel

@{
    ViewData["Title"] = "Equipment Management";
}

<div class="container-fluid p-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1 fw-bold">Equipment Management</h2>
            <p class="text-muted mb-0">Manage production equipment, track maintenance, and monitor status.</p>
        </div>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addEquipmentModal">
            <i class="bi bi-plus-lg me-1"></i> Add Equipment
        </button>
    </div>

    <!-- Summary Cards -->
    <div class="row g-4 mb-4">
        <div class="col-lg-3 col-md-6">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="rounded-circle bg-primary bg-opacity-10 p-3 me-3">
                            <i class="bi bi-gear-fill text-primary fs-4"></i>
                        </div>
                        <div>
                            <h6 class="text-muted mb-1 small text-uppercase">Total Equipment</h6>
                            <h3 class="mb-0 fw-bold">@Model.Summary.TotalEquipment</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="rounded-circle bg-success bg-opacity-10 p-3 me-3">
                            <i class="bi bi-check-circle-fill text-success fs-4"></i>
                        </div>
                        <div>
                            <h6 class="text-muted mb-1 small text-uppercase">Available</h6>
                            <h3 class="mb-0 fw-bold text-success">@Model.Summary.OperationalCount</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="rounded-circle bg-warning bg-opacity-10 p-3 me-3">
                            <i class="bi bi-tools text-warning fs-4"></i>
                        </div>
                        <div>
                            <h6 class="text-muted mb-1 small text-uppercase">Under Maintenance</h6>
                            <h3 class="mb-0 fw-bold text-warning">@Model.Summary.MaintenanceCount</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="rounded-circle bg-danger bg-opacity-10 p-3 me-3">
                            <i class="bi bi-exclamation-triangle-fill text-danger fs-4"></i>
                        </div>
                        <div>
                            <h6 class="text-muted mb-1 small text-uppercase">Needs Attention</h6>
                            <h3 class="mb-0 fw-bold text-danger">@Model.Summary.NeedsMaintenanceCount</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Equipment Table -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center py-3">
            <div class="d-flex align-items-center">
                <i class="bi bi-gear text-primary me-2"></i>
                <h6 class="mb-0 fw-semibold">Equipment List</h6>
            </div>
            <div>
                <select id="statusFilter" class="form-select form-select-sm" style="width: auto;">
                    <option value="">All Status</option>
                    <option value="Available">Available</option>
                    <option value="Under Maintenance">Under Maintenance</option>
                    <option value="Out of Service">Out of Service</option>
                </select>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="equipmentTable">
                    <thead class="table-light">
                        <tr>
                            <th class="px-4">Equipment Name</th>
                            <th>Type</th>
                            <th>Location</th>
                            <th>Cost</th>
                            <th>Status</th>
                            <th>Last Maintenance</th>
                            <th class="text-end px-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Equipment.Any())
                        {
                            @foreach (var item in Model.Equipment)
                            {
                                var statusClass = item.Status switch
                                {
                                    "Available" => "bg-success",
                                    "Under Maintenance" => "bg-warning",
                                    "Out of Service" => "bg-danger",
                                    _ => "bg-secondary"
                                };
                                var needsMaintenance = item.DaysSinceLastMaintenance > 30;
                                <tr data-status="@item.Status">
                                    <td class="px-4">
                                        <div class="d-flex align-items-center">
                                            <div class="rounded-circle bg-primary bg-opacity-10 p-2 me-2">
                                                <i class="bi bi-gear-fill text-primary"></i>
                                            </div>
                                            <div>
                                                <span class="fw-semibold">@item.EquipmentName</span>
                                                @if (needsMaintenance)
                                                {
                                                    <span class="badge bg-danger ms-2">Overdue</span>
                                                }
                                            </div>
                                        </div>
                                    </td>
                                    <td>@item.EquipmentType</td>
                                    <td>@item.Location</td>
                                    <td>@(item.Cost.HasValue ? item.Cost.Value.ToString("C") : "-")</td>
                                    <td>
                                        <span class="badge @statusClass">@item.Status</span>
                                    </td>
                                    <td>
                                        @if (item.LastMaintenanceDate.HasValue)
                                        {
                                            <div>
                                                <span>@item.LastMaintenanceDate.Value.ToString("MMM dd, yyyy")</span>
                                                <br />
                                                <small class="text-muted">@item.DaysSinceLastMaintenance days ago</small>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Never</span>
                                        }
                                    </td>
                                    <td class="text-end px-4">
                                        <div class="btn-group">
                                            <button class="btn btn-sm btn-outline-primary" onclick="editEquipment(@item.EquipmentID)" title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-success" onclick="recordMaintenance(@item.EquipmentID, '@item.EquipmentName')" title="Record Maintenance">
                                                <i class="bi bi-tools"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" title="Change Status">
                                                <i class="bi bi-toggle-on"></i>
                                            </button>
                                            <ul class="dropdown-menu">
                                                <li><a class="dropdown-item" href="#" onclick="updateStatus(@item.EquipmentID, 'Available')"><i class="bi bi-check-circle me-2 text-success"></i>Available</a></li>
                                                <li><a class="dropdown-item" href="#" onclick="updateStatus(@item.EquipmentID, 'Under Maintenance')"><i class="bi bi-tools me-2 text-warning"></i>Under Maintenance</a></li>
                                                <li><a class="dropdown-item" href="#" onclick="updateStatus(@item.EquipmentID, 'Out of Service')"><i class="bi bi-x-circle me-2 text-danger"></i>Out of Service</a></li>
                                            </ul>
                                            <button class="btn btn-sm btn-outline-danger" onclick="deleteEquipment(@item.EquipmentID, '@item.EquipmentName')" title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                    No equipment found. Add your first equipment to get started.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Add Equipment Modal -->
<div class="modal fade" id="addEquipmentModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold">Add New Equipment</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="addEquipmentForm">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Equipment Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="add_equipmentName" required maxlength="200">
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Equipment Type</label>
                        <select class="form-select" id="add_equipmentType">
                            <option value="">Select Type</option>
                            <option value="Pasteurizer">Pasteurizer</option>
                            <option value="Homogenizer">Homogenizer</option>
                            <option value="Separator">Separator</option>
                            <option value="Storage Tank">Storage Tank</option>
                            <option value="Filling Machine">Filling Machine</option>
                            <option value="Packaging Machine">Packaging Machine</option>
                            <option value="Refrigeration Unit">Refrigeration Unit</option>
                            <option value="CIP System">CIP System</option>
                            <option value="Conveyor">Conveyor</option>
                            <option value="Pump">Pump</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Location</label>
                        <input type="text" class="form-control" id="add_location" maxlength="200" placeholder="e.g., Production Floor A">
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Machine Cost / Price</label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input type="number" class="form-control" id="add_cost" min="0" step="0.01" placeholder="0.00">
                        </div>
                        <small class="text-muted">Will be recorded as an expense.</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Status</label>
                        <select class="form-select" id="add_status">
                            <option value="Available" selected>Available</option>
                            <option value="Under Maintenance">Under Maintenance</option>
                            <option value="Out of Service">Out of Service</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Last Maintenance Date</label>
                        <input type="date" class="form-control" id="add_lastMaintenanceDate">
                    </div>
                </form>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="submitAddEquipment()">
                    <i class="bi bi-plus-lg me-1"></i> Add Equipment
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Edit Equipment Modal -->
<div class="modal fade" id="editEquipmentModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold">Edit Equipment</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="editEquipmentForm">
                    <input type="hidden" id="edit_equipmentID">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Equipment Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="edit_equipmentName" required maxlength="200">
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Equipment Type</label>
                        <select class="form-select" id="edit_equipmentType">
                            <option value="">Select Type</option>
                            <option value="Pasteurizer">Pasteurizer</option>
                            <option value="Homogenizer">Homogenizer</option>
                            <option value="Separator">Separator</option>
                            <option value="Storage Tank">Storage Tank</option>
                            <option value="Filling Machine">Filling Machine</option>
                            <option value="Packaging Machine">Packaging Machine</option>
                            <option value="Refrigeration Unit">Refrigeration Unit</option>
                            <option value="CIP System">CIP System</option>
                            <option value="Conveyor">Conveyor</option>
                            <option value="Pump">Pump</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Location</label>
                        <input type="text" class="form-control" id="edit_location" maxlength="200">
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Machine Cost / Price</label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input type="number" class="form-control" id="edit_cost" min="0" step="0.01" placeholder="0.00">
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Status</label>
                        <select class="form-select" id="edit_status">
                            <option value="Available">Available</option>
                            <option value="Under Maintenance">Under Maintenance</option>
                            <option value="Out of Service">Out of Service</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Last Maintenance Date</label>
                        <input type="date" class="form-control" id="edit_lastMaintenanceDate">
                    </div>
                </form>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="submitEditEquipment()">
                    <i class="bi bi-check-lg me-1"></i> Save Changes
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Record Maintenance Modal -->
<div class="modal fade" id="maintenanceModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold">Record Maintenance</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted">Recording maintenance for: <strong id="maintenance_equipmentName"></strong></p>
                <form id="maintenanceForm">
                    <input type="hidden" id="maintenance_equipmentID">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Maintenance Date</label>
                        <input type="date" class="form-control" id="maintenance_date">
                        <small class="text-muted">Leave blank to use today's date.</small>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success" onclick="submitMaintenance()">
                    <i class="bi bi-check-lg me-1"></i> Record Maintenance
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // CSRF Token
        const csrfToken = '@Html.AntiForgeryToken()'.match(/value="([^"]+)"/)[1];

        // Filter by status
        document.getElementById('statusFilter').addEventListener('change', function() {
            const filterValue = this.value;
            const rows = document.querySelectorAll('#equipmentTable tbody tr[data-status]');
            rows.forEach(row => {
                if (!filterValue || row.dataset.status === filterValue) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        });

        // Add Equipment
        function submitAddEquipment() {
            const data = {
                equipmentName: document.getElementById('add_equipmentName').value,
                equipmentType: document.getElementById('add_equipmentType').value || null,
                location: document.getElementById('add_location').value || null,
                cost: document.getElementById('add_cost').value ? parseFloat(document.getElementById('add_cost').value) : null,
                status: document.getElementById('add_status').value,
                lastMaintenanceDate: document.getElementById('add_lastMaintenanceDate').value || null
            };

            if (!data.equipmentName) {
                showGlobalToast('error', 'Please enter equipment name.');
                return;
            }

            fetch('/Equipment/Create', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': csrfToken
                },
                body: JSON.stringify(data)
            })
            .then(response => response.json())
            .then(result => {
                if (result.success) {
                    location.reload();
                } else {
                    showGlobalToast('error', result.message || 'Error creating equipment.');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                showGlobalToast('error', 'Error creating equipment.');
            });
        }

        // Edit Equipment
        function editEquipment(id) {
            fetch(`/Equipment/GetDetail/${id}`)
            .then(response => response.json())
            .then(data => {
                document.getElementById('edit_equipmentID').value = data.equipmentID;
                document.getElementById('edit_equipmentName').value = data.equipmentName;
                document.getElementById('edit_equipmentType').value = data.equipmentType || '';
                document.getElementById('edit_location').value = data.location || '';
                document.getElementById('edit_cost').value = data.cost ?? '';
                document.getElementById('edit_status').value = data.status || 'Available';
                document.getElementById('edit_lastMaintenanceDate').value = data.lastMaintenanceDate ? data.lastMaintenanceDate.split('T')[0] : '';
                
                new bootstrap.Modal(document.getElementById('editEquipmentModal')).show();
            })
            .catch(error => {
                console.error('Error:', error);
                showGlobalToast('error', 'Error loading equipment details.');
            });
        }

        function submitEditEquipment() {
            const data = {
                equipmentID: parseInt(document.getElementById('edit_equipmentID').value),
                equipmentName: document.getElementById('edit_equipmentName').value,
                equipmentType: document.getElementById('edit_equipmentType').value || null,
                location: document.getElementById('edit_location').value || null,
                cost: document.getElementById('edit_cost').value ? parseFloat(document.getElementById('edit_cost').value) : null,
                status: document.getElementById('edit_status').value,
                lastMaintenanceDate: document.getElementById('edit_lastMaintenanceDate').value || null
            };

            if (!data.equipmentName) {
                showGlobalToast('error', 'Please enter equipment name.');
                return;
            }

            fetch('/Equipment/Update', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': csrfToken
                },
                body: JSON.stringify(data)
            })
            .then(response => response.json())
            .then(result => {
                if (result.success) {
                    location.reload();
                } else {
                    showGlobalToast('error', result.message || 'Error updating equipment.');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                showGlobalToast('error', 'Error updating equipment.');
            });
        }

        // Update Status
        function updateStatus(id, status) {
            showConfirmModal(`Change equipment status to "${status}"?`, () => {
                fetch('/Equipment/UpdateStatus', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': csrfToken
                    },
                    body: JSON.stringify({ equipmentID: id, status: status })
                })
                .then(response => response.json())
                .then(result => {
                    if (result.success) {
                        location.reload();
                    } else {
                        showGlobalToast('error', result.message || 'Error updating status.');
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    showGlobalToast('error', 'Error updating status.');
                });
            });
        }

        // Record Maintenance
        function recordMaintenance(id, name) {
            document.getElementById('maintenance_equipmentID').value = id;
            document.getElementById('maintenance_equipmentName').textContent = name;
            document.getElementById('maintenance_date').value = new Date().toISOString().split('T')[0];
            
            new bootstrap.Modal(document.getElementById('maintenanceModal')).show();
        }

        function submitMaintenance() {
            const data = {
                equipmentID: parseInt(document.getElementById('maintenance_equipmentID').value),
                maintenanceDate: document.getElementById('maintenance_date').value || null
            };

            fetch('/Equipment/RecordMaintenance', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': csrfToken
                },
                body: JSON.stringify(data)
            })
            .then(response => response.json())
            .then(result => {
                if (result.success) {
                    location.reload();
                } else {
                    showGlobalToast('error', result.message || 'Error recording maintenance.');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                showGlobalToast('error', 'Error recording maintenance.');
            });
        }

        // Delete Equipment
        function deleteEquipment(id, name) {
            showConfirmModal(`Are you sure you want to delete "${name}"? This action cannot be undone.`, () => {
                fetch(`/Equipment/Delete/${id}`, {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': csrfToken
                    }
                })
                .then(response => response.json())
                .then(result => {
                    if (result.success) {
                        location.reload();
                    } else {
                        showGlobalToast('error', result.message || 'Error deleting equipment.');
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    showGlobalToast('error', 'Error deleting equipment.');
                });
            });
        }
    </script>
}
