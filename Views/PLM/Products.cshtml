@model IEnumerable<IT15_DairyFlow.Models.PLM.ProductListViewModel>

@{
    ViewData["Title"] = "Product Lifecycle Management";
    var showArchived = ViewBag.ShowArchived ?? false;
}

<div class="container-fluid p-4">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1 fw-bold">Product Lifecycle Management</h2>
            <p class="text-muted mb-0">Manage your product portfolio, versions, and lifecycle stages.</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-secondary" id="toggleArchiveBtn" onclick="toggleArchivedView()">
                <i class="bi bi-archive me-1"></i> @(showArchived ? "Hide Archived" : "Show Archived")
            </button>
            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createProductModal">
                <i class="bi bi-plus-lg me-1"></i> Create Product
            </button>
        </div>
    </div>

    <!-- Filters and Search -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                        <input type="text" class="form-control" id="searchInput" placeholder="Search products...">
                    </div>
                </div>
                <div class="col-md-3">
                    <select class="form-select" id="typeFilter">
                        <option value="">All Types</option>
                        <option value="Dairy">Dairy</option>
                        <option value="Beverage">Beverage</option>
                        <option value="Cheese">Cheese</option>
                        <option value="Yogurt">Yogurt</option>
                        <option value="Other">Other</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <select class="form-select" id="statusFilter">
                        <option value="">All Statuses</option>
                        <option value="Active">Active</option>
                        <option value="Development">Development</option>
                        <option value="Discontinued">Discontinued</option>
                        <option value="Archived">Archived</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button class="btn btn-outline-secondary w-100" onclick="clearFilters()">
                        <i class="bi bi-x-circle me-1"></i> Clear
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Products Table -->
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="productsTable">
                    <thead class="table-light">
                        <tr>
                            <th class="px-4">Product Name</th>
                            <th>Type</th>
                            <th>Lifecycle Status</th>
                            <th>Created By</th>
                            <th class="text-end px-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-5">
                                    <i class="bi bi-inbox display-4 d-block mb-3 opacity-25"></i>
                                    <p class="mb-0">No products found. Create your first product to get started!</p>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var product in Model)
                            {
                                <tr class="product-row" data-product-id="@product.ProductID" style="cursor: pointer;">
                                    <td class="px-4 fw-semibold">@product.ProductName</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(product.Type))
                                        {
                                            <span class="badge bg-light text-dark border">@product.Type</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td>
                                        @{
                                            var badgeClass = product.LifecycleStatus switch
                                            {
                                                "Active" => "bg-success",
                                                "Development" => "bg-info",
                                                "Discontinued" => "bg-warning",
                                                "Archived" => "bg-secondary",
                                                _ => "bg-secondary"
                                            };
                                        }
                                        <span class="badge @badgeClass">@(product.LifecycleStatus ?? "Unknown")</span>
                                    </td>
                                    <td class="text-muted">@product.UserEmail</td>
                                    <td class="text-end px-4">
                                        <button class="btn btn-sm btn-outline-primary me-1" onclick="event.stopPropagation(); viewProductDetail(@product.ProductID)">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-secondary me-1" onclick="event.stopPropagation(); editProduct(@product.ProductID)">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        @if (product.LifecycleStatus != "Archived")
                                        {
                                            <button class="btn btn-sm btn-outline-danger" onclick="event.stopPropagation(); archiveProduct(@product.ProductID, '@product.ProductName')">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Create Product Modal -->
<div class="modal fade" id="createProductModal" tabindex="-1" aria-labelledby="createProductModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="createProductModalLabel">
                    <i class="bi bi-plus-circle text-primary me-2"></i>Create New Product
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="createProductForm">
                    <div class="mb-3">
                        <label for="createProductName" class="form-label fw-semibold">Product Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="createProductName" required>
                        <div class="invalid-feedback">Please enter a product name.</div>
                    </div>
                    <div class="mb-3">
                        <label for="createProductType" class="form-label fw-semibold">Type</label>
                        <select class="form-select" id="createProductType">
                            <option value="">Select type...</option>
                            <option value="Dairy">Dairy</option>
                            <option value="Beverage">Beverage</option>
                            <option value="Cheese">Cheese</option>
                            <option value="Yogurt">Yogurt</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="createLifecycleStatus" class="form-label fw-semibold">Lifecycle Status</label>
                        <select class="form-select" id="createLifecycleStatus">
                            <option value="Active" selected>Active</option>
                            <option value="Development">Development</option>
                            <option value="Discontinued">Discontinued</option>
                        </select>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="createProduct()">
                    <i class="bi bi-check-lg me-1"></i>Create Product
                </button>
            </div>
        </div>
    </div>
</div>

<!-- View/Edit Product Modal -->
<div class="modal fade" id="viewProductModal" tabindex="-1" aria-labelledby="viewProductModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="viewProductModalLabel">
                    <i class="bi bi-box-seam text-primary me-2"></i>Product Details
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="viewProductContent">
                    <!-- Content will be loaded dynamically -->
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" id="editProductBtn" onclick="toggleEditMode()">
                    <i class="bi bi-pencil me-1"></i>Edit
                </button>
                <button type="button" class="btn btn-success d-none" id="saveProductBtn" onclick="saveProduct()">
                    <i class="bi bi-check-lg me-1"></i>Save Changes
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentProductId = null;
        let isEditMode = false;

        // Toggle archived view
        function toggleArchivedView() {
            const currentUrl = new URL(window.location);
            const showArchived = currentUrl.searchParams.get('showArchived') === 'true';
            currentUrl.searchParams.set('showArchived', !showArchived);
            window.location.href = currentUrl.toString();
        }

        // Search functionality
        document.getElementById('searchInput').addEventListener('keyup', filterTable);
        document.getElementById('typeFilter').addEventListener('change', filterTable);
        document.getElementById('statusFilter').addEventListener('change', filterTable);

        function filterTable() {
            const searchTerm = document.getElementById('searchInput').value.toLowerCase();
            const typeFilter = document.getElementById('typeFilter').value;
            const statusFilter = document.getElementById('statusFilter').value;
            const rows = document.querySelectorAll('#productsTable tbody tr.product-row');

            rows.forEach(row => {
                const productName = row.cells[0].textContent.toLowerCase();
                const type = row.cells[1].textContent.trim();
                const status = row.cells[2].textContent.trim();

                const matchesSearch = productName.includes(searchTerm);
                const matchesType = !typeFilter || type.includes(typeFilter);
                const matchesStatus = !statusFilter || status.includes(statusFilter);

                row.style.display = (matchesSearch && matchesType && matchesStatus) ? '' : 'none';
            });
        }

        function clearFilters() {
            document.getElementById('searchInput').value = '';
            document.getElementById('typeFilter').value = '';
            document.getElementById('statusFilter').value = '';
            filterTable();
        }

        // Create product
        async function createProduct() {
            const form = document.getElementById('createProductForm');
            if (!form.checkValidity()) {
                form.classList.add('was-validated');
                return;
            }

            const data = {
                productName: document.getElementById('createProductName').value,
                type: document.getElementById('createProductType').value || null,
                lifecycleStatus: document.getElementById('createLifecycleStatus').value
            };

            try {
                const response = await fetch('@Url.Action("CreateProduct", "PLM")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify(data)
                });

                if (response.ok) {
                    const result = await response.json();
                    showToast('success', result.message);
                    setTimeout(() => window.location.reload(), 1000);
                } else {
                    showToast('error', 'Failed to create product');
                }
            } catch (error) {
                showToast('error', 'An error occurred');
                console.error(error);
            }
        }

        // View product detail
        async function viewProductDetail(productId, openEdit = false) {
            currentProductId = productId;
            isEditMode = false;
            
            try {
                const response = await fetch(`@Url.Action("GetProductDetail", "PLM")/${productId}`);
                if (response.ok) {
                    const product = await response.json();
                    displayProductDetail(product);
                    new bootstrap.Modal(document.getElementById('viewProductModal')).show();
                    if (openEdit) {
                        toggleEditMode();
                    }
                }
            } catch (error) {
                console.error(error);
                showToast('error', 'Failed to load product details');
            }
        }

        function editProduct(productId) {
            viewProductDetail(productId, true);
        }

        // Click on row to view details
        document.querySelectorAll('.product-row').forEach(row => {
            row.addEventListener('click', function() {
                const productId = this.dataset.productId;
                viewProductDetail(productId);
            });
        });

        function displayProductDetail(product) {
            const statusBadgeClass = {
                'Active': 'bg-success',
                'Development': 'bg-info',
                'Discontinued': 'bg-warning',
                'Archived': 'bg-secondary'
            }[product.lifecycleStatus] || 'bg-secondary';

            const content = `
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold text-muted small">Product Name</label>
                        <input type="text" class="form-control form-control-lg" id="editProductName" value="${product.productName}" readonly>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold text-muted small">Type</label>
                        <select class="form-select form-select-lg" id="editProductType" disabled>
                            <option value="">Select type...</option>
                            <option value="Dairy" ${product.type === 'Dairy' ? 'selected' : ''}>Dairy</option>
                            <option value="Beverage" ${product.type === 'Beverage' ? 'selected' : ''}>Beverage</option>
                            <option value="Cheese" ${product.type === 'Cheese' ? 'selected' : ''}>Cheese</option>
                            <option value="Yogurt" ${product.type === 'Yogurt' ? 'selected' : ''}>Yogurt</option>
                            <option value="Other" ${product.type === 'Other' ? 'selected' : ''}>Other</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold text-muted small">Lifecycle Status</label>
                        <select class="form-select form-select-lg" id="editLifecycleStatus" disabled>
                            <option value="Active" ${product.lifecycleStatus === 'Active' ? 'selected' : ''}>Active</option>
                            <option value="Development" ${product.lifecycleStatus === 'Development' ? 'selected' : ''}>Development</option>
                            <option value="Discontinued" ${product.lifecycleStatus === 'Discontinued' ? 'selected' : ''}>Discontinued</option>
                            <option value="Archived" ${product.lifecycleStatus === 'Archived' ? 'selected' : ''}>Archived</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold text-muted small">Created By</label>
                        <input type="text" class="form-control form-control-lg" value="${product.userEmail}" readonly>
                    </div>
                    <div class="col-12">
                        <div class="alert alert-light border mb-0">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <small class="text-muted d-block">Product ID</small>
                                    <strong>#${product.productID}</strong>
                                </div>
                                <div>
                                    <small class="text-muted d-block">Status</small>
                                    <span class="badge ${statusBadgeClass}">${product.lifecycleStatus}</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            `;
            
            document.getElementById('viewProductContent').innerHTML = content;
            document.getElementById('editProductBtn').classList.remove('d-none');
            document.getElementById('saveProductBtn').classList.add('d-none');
        }

        function toggleEditMode() {
            isEditMode = !isEditMode;
            
            document.getElementById('editProductName').readOnly = !isEditMode;
            document.getElementById('editProductType').disabled = !isEditMode;
            document.getElementById('editLifecycleStatus').disabled = !isEditMode;
            
            if (isEditMode) {
                document.getElementById('editProductBtn').classList.add('d-none');
                document.getElementById('saveProductBtn').classList.remove('d-none');
            } else {
                document.getElementById('editProductBtn').classList.remove('d-none');
                document.getElementById('saveProductBtn').classList.add('d-none');
            }
        }

        async function saveProduct() {
            const data = {
                productID: currentProductId,
                productName: document.getElementById('editProductName').value,
                type: document.getElementById('editProductType').value || null,
                lifecycleStatus: document.getElementById('editLifecycleStatus').value
            };

            try {
                const response = await fetch('@Url.Action("UpdateProduct", "PLM")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify(data)
                });

                if (response.ok) {
                    const result = await response.json();
                    showToast('success', result.message);
                    setTimeout(() => window.location.reload(), 1000);
                } else {
                    showToast('error', 'Failed to update product');
                }
            } catch (error) {
                showToast('error', 'An error occurred');
                console.error(error);
            }
        }

        async function archiveProduct(productId, productName) {
            if (!confirm(`Are you sure you want to archive "${productName}"?`)) {
                return;
            }

            try {
                const response = await fetch(`@Url.Action("ArchiveProduct", "PLM")/${productId}`, {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    }
                });

                if (response.ok) {
                    const result = await response.json();
                    showToast('success', result.message);
                    setTimeout(() => window.location.reload(), 1000);
                } else {
                    showToast('error', 'Failed to archive product');
                }
            } catch (error) {
                showToast('error', 'An error occurred');
                console.error(error);
            }
        }

        function showToast(type, message) {
            // Simple toast notification
            const toast = document.createElement('div');
            toast.className = `alert alert-${type === 'success' ? 'success' : 'danger'} position-fixed top-0 end-0 m-3`;
            toast.style.zIndex = '9999';
            toast.textContent = message;
            document.body.appendChild(toast);
            setTimeout(() => toast.remove(), 3000);
        }
    </script>
}

@Html.AntiForgeryToken()
