@model IEnumerable<IT15_DairyFlow.Models.PLM.ProductApprovalListViewModel>

@{
    ViewData["Title"] = "Product Approval";
}

<div class="container-fluid p-4">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1 fw-bold">Product Approval</h2>
            <p class="text-muted mb-0">Review and approve products submitted by team members.</p>
        </div>
    </div>

    <!-- Filters -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                        <input type="text" class="form-control" id="searchInput" placeholder="Search products...">
                    </div>
                </div>
                <div class="col-md-3">
                    <select class="form-select" id="statusFilter">
                        <option value="">All Statuses</option>
                        <option value="underreview" selected>Under Review</option>
                        <option value="Needs Revision">Needs Revision</option>
                        <option value="Approved">Approved</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button class="btn btn-outline-secondary w-100" onclick="clearFilters()">
                        <i class="bi bi-x-circle me-1"></i> Clear
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Products Table -->
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="approvalsTable">
                    <thead class="table-light">
                        <tr>
                            <th class="px-4">Product Name</th>
                            <th>Type</th>
                            <th>Status</th>
                            <th>Submitted By</th>
                            <th class="text-end px-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-5">
                                    <i class="bi bi-inbox display-6 d-block mb-2 opacity-25"></i>
                                    No products pending review.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var product in Model)
                            {
                                <tr class="product-row"
                                    data-name="@product.ProductName?.ToLower()"
                                    data-status="@product.LifecycleStatus?.ToLower()">
                                    <td class="px-4 fw-semibold">@product.ProductName</td>
                                    <td>
                                        <span class="badge bg-light text-dark border">@(product.Type ?? "—")</span>
                                    </td>
                                    <td>
                                        @{
                                            var badgeClass = product.LifecycleStatus switch
                                            {
                                                "underreview" => "bg-warning text-dark",
                                                "Approved" => "bg-success",
                                                "Needs Revision" => "bg-danger",
                                                _ => "bg-secondary"
                                            };
                                            var statusText = product.LifecycleStatus switch
                                            {
                                                "underreview" => "Under Review",
                                                _ => product.LifecycleStatus ?? "Unknown"
                                            };
                                        }
                                        <span class="badge @badgeClass">@statusText</span>
                                    </td>
                                    <td>
                                        <div class="fw-semibold small">@product.CreatedByUserName</div>
                                        <div class="text-muted small">@product.CreatedByEmail</div>
                                    </td>
                                    <td class="text-end px-4">
                                        <button class="btn btn-sm btn-outline-primary" onclick="viewApprovalDetail(@product.ProductID)">
                                            <i class="bi bi-eye me-1"></i> Review
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Approval Detail Modal -->
<div class="modal fade" id="approvalDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-primary bg-opacity-10">
                <h5 class="modal-title fw-bold"><i class="bi bi-clipboard-check me-2"></i>Product Review</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold text-muted small">Product Name</label>
                        <p id="detailProductName" class="fw-bold fs-5"></p>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold text-muted small">Type</label>
                        <p id="detailProductType"></p>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold text-muted small">Status</label>
                        <p id="detailProductStatus"></p>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold text-muted small">Submitted By</label>
                        <p id="detailCreatedBy"></p>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold text-muted small">Total Unit Cost</label>
                        <p id="detailUnitCost" class="fw-bold text-success fs-5"></p>
                    </div>
                </div>

                <hr />
                <h6 class="fw-bold mb-3"><i class="bi bi-list-check me-2"></i>Formulation / Ingredients</h6>
                <div class="table-responsive">
                    <table class="table table-sm table-bordered" id="ingredientsTable">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Material</th>
                                <th>Quantity</th>
                                <th>Unit</th>
                                <th>Unit Cost</th>
                                <th>Total</th>
                            </tr>
                        </thead>
                        <tbody id="ingredientsBody">
                        </tbody>
                    </table>
                </div>

                <!-- Rejection reason (hidden by default) -->
                <div id="rejectionSection" class="mt-3 d-none">
                    <hr />
                    <label class="form-label fw-semibold">Reason for rejection / revision</label>
                    <textarea id="rejectionReason" class="form-control" rows="3" placeholder="Explain why this product needs revision..."></textarea>
                </div>
            </div>
            <div class="modal-footer" id="approvalFooter">
                <input type="hidden" id="detailProductID" />
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-danger" id="btnReject" onclick="showRejectionReason()">
                    <i class="bi bi-x-circle me-1"></i> Needs Revision
                </button>
                <button type="button" class="btn btn-success" id="btnApprove" onclick="processApproval('Approved')">
                    <i class="bi bi-check-circle me-1"></i> Approve
                </button>
                <button type="button" class="btn btn-danger d-none" id="btnConfirmReject" onclick="processApproval('Rejected')">
                    <i class="bi bi-x-circle me-1"></i> Confirm Rejection
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // ─── Search and Filter ────────────────────────────────
        document.getElementById('searchInput').addEventListener('input', filterTable);
        document.getElementById('statusFilter').addEventListener('change', filterTable);

        function filterTable() {
            const search = document.getElementById('searchInput').value.toLowerCase();
            const status = document.getElementById('statusFilter').value.toLowerCase();
            document.querySelectorAll('.product-row').forEach(row => {
                const name = row.dataset.name || '';
                const rowStatus = row.dataset.status || '';
                const matchSearch = !search || name.includes(search);
                const matchStatus = !status || rowStatus === status;
                row.style.display = (matchSearch && matchStatus) ? '' : 'none';
            });
        }

        function clearFilters() {
            document.getElementById('searchInput').value = '';
            document.getElementById('statusFilter').value = '';
            filterTable();
        }

        // ─── View Detail ──────────────────────────────────────
        async function viewApprovalDetail(productId) {
            try {
                const response = await fetch(`@Url.Action("GetApprovalDetail", "PLM")/${productId}`);
                if (!response.ok) throw new Error('Failed to load');
                const data = await response.json();

                document.getElementById('detailProductID').value = data.productID;
                document.getElementById('detailProductName').textContent = data.productName;
                document.getElementById('detailProductType').textContent = data.type || '—';

                const statusText = data.lifecycleStatus === 'underreview' ? 'Under Review' : data.lifecycleStatus;
                document.getElementById('detailProductStatus').innerHTML =
                    `<span class="badge ${getStatusBadge(data.lifecycleStatus)}">${statusText}</span>`;

                document.getElementById('detailCreatedBy').innerHTML =
                    `<span class="fw-semibold">${data.createdByUserName}</span> <span class="text-muted">(${data.createdByEmail})</span>`;

                document.getElementById('detailUnitCost').textContent = `₱${data.totalUnitCost.toFixed(2)}`;

                // Ingredients
                const tbody = document.getElementById('ingredientsBody');
                tbody.innerHTML = '';
                if (data.ingredients.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="6" class="text-center text-muted">No formulation defined.</td></tr>';
                } else {
                    data.ingredients.forEach((ing, idx) => {
                        tbody.innerHTML += `
                            <tr>
                                <td>${idx + 1}</td>
                                <td>${ing.materialName}</td>
                                <td>${ing.quantity}</td>
                                <td>${ing.unit}</td>
                                <td>₱${ing.unitCost.toFixed(2)}</td>
                                <td>₱${ing.totalCost.toFixed(2)}</td>
                            </tr>`;
                    });
                }

                // Show/hide approval buttons based on status
                const isApproved = data.lifecycleStatus === 'Approved';
                document.getElementById('btnApprove').classList.toggle('d-none', isApproved);
                document.getElementById('btnReject').classList.toggle('d-none', isApproved);
                document.getElementById('btnConfirmReject').classList.add('d-none');
                document.getElementById('rejectionSection').classList.add('d-none');

                new bootstrap.Modal(document.getElementById('approvalDetailModal')).show();
            } catch (err) {
                alert('Error loading product details.');
                console.error(err);
            }
        }

        function getStatusBadge(status) {
            switch (status) {
                case 'underreview': return 'bg-warning text-dark';
                case 'Approved': return 'bg-success';
                case 'Needs Revision': return 'bg-danger';
                default: return 'bg-secondary';
            }
        }

        function showRejectionReason() {
            document.getElementById('rejectionSection').classList.remove('d-none');
            document.getElementById('btnReject').classList.add('d-none');
            document.getElementById('btnConfirmReject').classList.remove('d-none');
        }

        async function processApproval(action) {
            const productId = parseInt(document.getElementById('detailProductID').value);
            const reason = document.getElementById('rejectionReason')?.value || '';

            if (action === 'Rejected' && !reason.trim()) {
                alert('Please provide a reason for rejection.');
                return;
            }

            try {
                const response = await fetch('@Url.Action("ProcessApproval", "PLM")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                            || document.querySelector('meta[name="RequestVerificationToken"]')?.content
                            || ''
                    },
                    body: JSON.stringify({ productID: productId, action: action, reason: reason })
                });

                const result = await response.json();
                if (result.success) {
                    bootstrap.Modal.getInstance(document.getElementById('approvalDetailModal'))?.hide();
                    location.reload();
                } else {
                    alert(result.message || 'Operation failed.');
                }
            } catch (err) {
                alert('Error processing approval.');
                console.error(err);
            }
        }

        // Auto-filter on page load (default to "Under Review")
        filterTable();
    </script>
}
