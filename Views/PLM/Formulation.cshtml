@model IT15_DairyFlow.Models.PLM.FormulationPageViewModel

@{
    ViewData["Title"] = "Product Formulation";
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <a href="@Url.Action("Products", "PLM")" class="btn btn-outline-secondary btn-sm mb-2">
                <i class="bi bi-arrow-left"></i> Back to Products
            </a>
            <h2 class="mb-1">
                <i class="bi bi-list-check text-primary"></i> Formulation: @Model.ProductName
            </h2>
            <p class="text-muted mb-0">
                <span class="badge bg-secondary me-2">@Model.ProductType</span>
                @{
                    var lcBadge = Model.LifecycleStatus switch
                    {
                        "approved" => "bg-success",
                        "underreview" => "bg-warning text-dark",
                        "In Production" => "bg-primary",
                        "Produced" => "bg-info",
                        _ => "bg-secondary"
                    };
                    var lcLabel = Model.LifecycleStatus switch
                    {
                        "approved" => "Approved",
                        "underreview" => "Under Review",
                        "In Production" => "In Production",
                        "Produced" => "Produced",
                        _ => Model.LifecycleStatus
                    };
                }
                <span class="badge @lcBadge">@lcLabel</span>
            </p>
        </div>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addIngredientModal">
            <i class="bi bi-plus-lg"></i> Add Ingredient
        </button>
    </div>

    <!-- Summary Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="bg-primary bg-opacity-10 rounded-3 p-3 me-3">
                            <i class="bi bi-box-seam text-primary fs-4"></i>
                        </div>
                        <div>
                            <p class="text-muted small mb-0">Total Ingredients</p>
                            <h4 class="mb-0">@Model.Ingredients.Count</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="bg-success bg-opacity-10 rounded-3 p-3 me-3">
                            <i class="bi bi-currency-dollar text-success fs-4"></i>
                        </div>
                        <div>
                            <p class="text-muted small mb-0">Cost per Unit</p>
                            <h4 class="mb-0">₱@Model.TotalCost.ToString("N2")</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="bg-info bg-opacity-10 rounded-3 p-3 me-3">
                            <i class="bi bi-calculator text-info fs-4"></i>
                        </div>
                        <div>
                            <p class="text-muted small mb-0">Batch Calculator</p>
                            <div class="input-group input-group-sm" style="max-width: 150px;">
                                <input type="number" class="form-control" id="batchQuantity" value="1" min="1">
                                <button class="btn btn-outline-secondary" type="button" onclick="calculateBatch()">
                                    <i class="bi bi-arrow-right"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Ingredients Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-0 py-3">
            <h5 class="mb-0"><i class="bi bi-list-ul me-2"></i>Ingredients List</h5>
        </div>
        <div class="card-body p-0">
            @if (Model.Ingredients.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th width="50">#</th>
                                <th>Raw Material</th>
                                <th class="text-center">Quantity</th>
                                <th class="text-end">Unit Cost</th>
                                <th class="text-end">Total Cost</th>
                                <th>Process Instructions</th>
                                <th width="120" class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ingredient in Model.Ingredients)
                            {
                                <tr data-id="@ingredient.FormulationID">
                                    <td class="text-muted">@(ingredient.ProcessOrder ?? 0)</td>
                                    <td>
                                        <strong>@ingredient.MaterialName</strong>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-light text-dark">
                                            @ingredient.Quantity.ToString("N2") @ingredient.Unit
                                        </span>
                                    </td>
                                    <td class="text-end">₱@ingredient.UnitCost.ToString("N2")</td>
                                    <td class="text-end fw-bold">₱@ingredient.TotalCost.ToString("N2")</td>
                                    <td class="text-muted small">@(ingredient.ProcessInstructions ?? "-")</td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-outline-primary me-1" onclick="editIngredient(@ingredient.FormulationID)" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger" onclick="removeIngredient(@ingredient.FormulationID)" title="Remove">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light">
                            <tr>
                                <td colspan="4" class="text-end fw-bold">Total Cost per Unit:</td>
                                <td class="text-end fw-bold text-primary">₱@Model.TotalCost.ToString("N2")</td>
                                <td colspan="2"></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox text-muted" style="font-size: 3rem;"></i>
                    <p class="text-muted mt-2">No ingredients added yet.</p>
                    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addIngredientModal">
                        <i class="bi bi-plus-lg"></i> Add First Ingredient
                    </button>
                </div>
            }
        </div>
    </div>
</div>

<!-- Add Ingredient Modal -->
<div class="modal fade" id="addIngredientModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="addIngredientForm">
                <div class="modal-header border-0">
                    <h5 class="modal-title"><i class="bi bi-plus-circle me-2"></i>Add Ingredient</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="addProductId" value="@Model.ProductID" />
                    <div class="mb-3">
                        <label class="form-label">Raw Material <span class="text-danger">*</span></label>
                        <select class="form-select" id="addRawMaterial" required>
                            <option value="">Select Material...</option>
                            @foreach (var material in Model.AvailableMaterials)
                            {
                                <option value="@material.Id" data-cost="@material.UnitCost">
                                    @material.Name (₱@material.UnitCost.ToString("N2")/unit)
                                </option>
                            }
                        </select>
                    </div>
                    <div class="row">
                        <div class="col-6">
                            <div class="mb-3">
                                <label class="form-label">Quantity <span class="text-danger">*</span></label>
                                <input type="number" class="form-control" id="addQuantity" step="0.01" min="0.01" required />
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="mb-3">
                                <label class="form-label">Unit</label>
                                <select class="form-select" id="addUnit">
                                    <option value="kg">kg</option>
                                    <option value="g">g</option>
                                    <option value="L">L</option>
                                    <option value="mL">mL</option>
                                    <option value="pcs">pcs</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Process Order</label>
                        <input type="number" class="form-control" id="addProcessOrder" min="1" placeholder="e.g., 1, 2, 3..." />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Process Instructions</label>
                        <textarea class="form-control" id="addProcessInstructions" rows="2" placeholder="Optional instructions..."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-plus-lg me-1"></i>Add Ingredient
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Ingredient Modal -->
<div class="modal fade" id="editIngredientModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="editIngredientForm">
                <div class="modal-header border-0">
                    <h5 class="modal-title"><i class="bi bi-pencil me-2"></i>Edit Ingredient</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="editFormulationId" />
                    <div class="mb-3">
                        <label class="form-label">Raw Material</label>
                        <input type="text" class="form-control" id="editMaterialName" readonly />
                    </div>
                    <div class="row">
                        <div class="col-6">
                            <div class="mb-3">
                                <label class="form-label">Quantity <span class="text-danger">*</span></label>
                                <input type="number" class="form-control" id="editQuantity" step="0.01" min="0.01" required />
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="mb-3">
                                <label class="form-label">Unit</label>
                                <select class="form-select" id="editUnit">
                                    <option value="kg">kg</option>
                                    <option value="g">g</option>
                                    <option value="L">L</option>
                                    <option value="mL">mL</option>
                                    <option value="pcs">pcs</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Process Order</label>
                        <input type="number" class="form-control" id="editProcessOrder" min="1" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Process Instructions</label>
                        <textarea class="form-control" id="editProcessInstructions" rows="2"></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-lg me-1"></i>Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Batch Requirements Modal -->
<div class="modal fade" id="batchRequirementsModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title"><i class="bi bi-calculator me-2"></i>Batch Requirements</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="batchRequirementsContent">
                    <!-- Content loaded via JS -->
                </div>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const productId = @Model.ProductID;
        const antiForgeryToken = $('input[name="__RequestVerificationToken"]').val();

        // Add Ingredient
        $('#addIngredientForm').on('submit', function (e) {
            e.preventDefault();

            const data = {
                ProductID: productId,
                RawMaterialID: parseInt($('#addRawMaterial').val()),
                Quantity: parseFloat($('#addQuantity').val()),
                Unit: $('#addUnit').val(),
                ProcessOrder: $('#addProcessOrder').val() ? parseInt($('#addProcessOrder').val()) : null,
                ProcessInstructions: $('#addProcessInstructions').val() || null
            };

            $.ajax({
                url: '@Url.Action("AddIngredient", "PLM")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(data),
                headers: { 'RequestVerificationToken': antiForgeryToken },
                success: function (response) {
                    if (response.success) {
                        location.reload();
                    }
                },
                error: function (xhr) {
                    showGlobalToast('error', 'Error: ' + (xhr.responseJSON?.message || 'Failed to add ingredient'));
                }
            });
        });

        // Edit Ingredient
        function editIngredient(id) {
            $.get('@Url.Action("GetFormulationDetail", "PLM")/' + id, function (data) {
                $('#editFormulationId').val(data.formulationID);
                $('#editMaterialName').val(data.materialName);
                $('#editQuantity').val(data.quantity);
                $('#editUnit').val(data.unit);
                $('#editProcessOrder').val(data.processOrder);
                $('#editProcessInstructions').val(data.processInstructions);
                $('#editIngredientModal').modal('show');
            });
        }

        $('#editIngredientForm').on('submit', function (e) {
            e.preventDefault();

            const data = {
                FormulationID: parseInt($('#editFormulationId').val()),
                Quantity: parseFloat($('#editQuantity').val()),
                Unit: $('#editUnit').val(),
                ProcessOrder: $('#editProcessOrder').val() ? parseInt($('#editProcessOrder').val()) : null,
                ProcessInstructions: $('#editProcessInstructions').val() || null
            };

            $.ajax({
                url: '@Url.Action("UpdateIngredient", "PLM")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(data),
                headers: { 'RequestVerificationToken': antiForgeryToken },
                success: function (response) {
                    if (response.success) {
                        location.reload();
                    }
                },
                error: function (xhr) {
                    showGlobalToast('error', 'Error: ' + (xhr.responseJSON?.message || 'Failed to update ingredient'));
                }
            });
        });

        // Remove Ingredient
        function removeIngredient(id) {
            showConfirmModal('Remove this ingredient from the formulation?', () => {
                $.ajax({
                    url: '@Url.Action("RemoveIngredient", "PLM")/' + id,
                    type: 'POST',
                    headers: { 'RequestVerificationToken': antiForgeryToken },
                    success: function (response) {
                        if (response.success) {
                            location.reload();
                        }
                    },
                    error: function (xhr) {
                        showGlobalToast('error', 'Error: ' + (xhr.responseJSON?.message || 'Failed to remove ingredient'));
                    }
                });
            });
        }

        // Calculate Batch Requirements
        function calculateBatch() {
            const qty = parseInt($('#batchQuantity').val()) || 1;

            $.get('@Url.Action("CalculateBatchRequirements", "PLM")/' + productId + '/' + qty, function (data) {
                let html = `
                    <div class="alert alert-info">
                        <i class="bi bi-info-circle me-2"></i>
                        Material requirements for <strong>${qty}</strong> unit(s) of <strong>@Model.ProductName</strong>
                    </div>
                    <table class="table table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>Material</th>
                                <th class="text-center">Required Qty</th>
                                <th class="text-end">Unit Cost</th>
                                <th class="text-end">Total Cost</th>
                            </tr>
                        </thead>
                        <tbody>`;

                data.requirements.forEach(function (item) {
                    html += `
                        <tr>
                            <td>${item.materialName}</td>
                            <td class="text-center">${item.requiredQuantity.toFixed(2)} ${item.unit}</td>
                            <td class="text-end">₱${item.unitCost.toFixed(2)}</td>
                            <td class="text-end">₱${item.totalCost.toFixed(2)}</td>
                        </tr>`;
                });

                html += `
                        </tbody>
                        <tfoot class="table-light">
                            <tr>
                                <td colspan="3" class="text-end fw-bold">Total Batch Cost:</td>
                                <td class="text-end fw-bold text-primary">₱${data.totalCost.toFixed(2)}</td>
                            </tr>
                        </tfoot>
                    </table>`;

                $('#batchRequirementsContent').html(html);
                $('#batchRequirementsModal').modal('show');
            });
        }
    </script>
}
