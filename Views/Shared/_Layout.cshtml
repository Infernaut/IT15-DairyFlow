@using Microsoft.AspNetCore.Identity
@using IT15_DairyFlow.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    var layoutUser = SignInManager.IsSignedIn(User) ? await UserManager.GetUserAsync(User) : null;
    var layoutCompanyId = layoutUser?.CompanyID?.ToString() ?? "";
}

<!DOCTYPE html>
<html lang="en" data-company-id="@layoutCompanyId">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DairyFlow ERP</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        :root {
            --blue-main: #0d6efd;
            --sidebar-width: 280px;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8fbff;
            height: 100vh;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        /* On mobile, let the body scroll naturally */
        @@media (max-width: 767.98px) {
            body {
                overflow: auto;
                -webkit-overflow-scrolling: touch;
            }
        }

        /* Navbar Styling */
        .navbar-custom {
            height: 70px;
            border-bottom: 1px solid #eef2f7 !important;
            z-index: 1030;
            margin-left: 0;
        }

        /* When sidebar is present, push content */
        .has-sidebar .navbar-custom {
            margin-left: var(--sidebar-width);
        }

        /* Visible navbar borderline matching sidebar brand width */
        .has-sidebar .navbar-custom::before {
            content: '';
            position: absolute;
            left: calc(var(--sidebar-width) * -1);
            top: 0;
            width: var(--sidebar-width);
            height: 100%;
            background: linear-gradient(135deg, #0d6efd, #0a58ca);
            border-bottom: 3px solid #0a58ca;
            z-index: -1;
        }

        .has-sidebar .main-wrapper {
            margin-left: var(--sidebar-width);
        }

        /* Right-side scrollbar for main content area */
        main[role="main"] {
            scrollbar-width: thin;
            scrollbar-color: rgba(0,0,0,0.18) transparent;
        }

        main[role="main"]::-webkit-scrollbar {
            width: 7px;
        }

        main[role="main"]::-webkit-scrollbar-track {
            background: transparent;
        }

        main[role="main"]::-webkit-scrollbar-thumb {
            background-color: rgba(0,0,0,0.18);
            border-radius: 6px;
        }

        main[role="main"]::-webkit-scrollbar-thumb:hover {
            background-color: rgba(0,0,0,0.3);
        }

        /* Hide Scrollbars on sidebar while allowing functionality */
        .sidebar-scroll-container {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }

        .sidebar-scroll-container::-webkit-scrollbar {
            display: none;
        }

        .main-wrapper {
            display: flex;
            flex: 1;
            overflow: hidden;
        }

        main[role="main"] {
            flex: 1;
            overflow-y: auto;
            padding: 0;
        }

        .footer-custom {
            background: #fff;
            border-top: 1px solid #eef2f7;
            padding: 1rem 0;
        }
    </style>
</head>
<body class="@(SignInManager.IsSignedIn(User) ? "has-sidebar" : "")">
    @if (SignInManager.IsSignedIn(User))
    {
        <button class="mobile-nav-toggle" id="mobileNavToggle" aria-label="Toggle navigation">
            <i class="bi bi-list" id="mobileNavIcon"></i>
        </button>
        <div class="sidebar-overlay" id="sidebarOverlay"></div>
    }
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white navbar-custom shadow-sm">
            <div class="container-fluid">
                @if (!SignInManager.IsSignedIn(User))
                {
                    <a class="navbar-brand fw-bold text-primary" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-droplet-half me-2"></i>DairyFlow
                    </a>
                }
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @* LOGIC: Only show Home/Privacy when NOT logged in *@
                        @if (!SignInManager.IsSignedIn(User))
                        {
                            <li class="nav-item">
                                <a class="nav-link px-3" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link px-3" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <span class="nav-link disabled text-primary fw-bold px-3">ERP Portal</span>
                            </li>
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <div class="main-wrapper">
        @if (SignInManager.IsSignedIn(User))
        {
            if (User.IsInRole("Superadmin"))
            {
                <partial name="_SuperAdminSidebarPartial" />
            }
            else if (User.IsInRole("Admin"))
            {
                <partial name="_AdminSidebarPartial" />
            }
            else
            {
                <partial name="_SidebarPartial" />
            }
        }

        <main role="main">
            @RenderBody()

            @if (!SignInManager.IsSignedIn(User))
            {
                <footer class="footer-custom">
                    <div class="container text-center">
                        <span>&copy; 2026 - DairyFlow ERP</span>
                    </div>
                </footer>
            }
        </main>
    </div>

    <!-- Global Confirm Modal -->
    <div class="modal fade" id="globalConfirmModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content">
                <div class="modal-header border-0 pb-0">
                    <h6 class="modal-title fw-bold" id="globalConfirmTitle">
                        <i class="bi bi-exclamation-triangle text-warning me-2"></i>Confirm Action
                    </h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body pt-2">
                    <p class="mb-0 text-muted" id="globalConfirmMessage">Are you sure?</p>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary btn-sm" id="globalConfirmBtn">Confirm</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Global Error Toast Container -->
    <div id="globalToastContainer" class="position-fixed top-0 end-0 p-3" style="z-index: 9999;"></div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js" defer></script>
    <script src="~/js/signalr-client.js" asp-append-version="true" defer></script>
    <script>
        // Global confirm modal helper
        function showConfirmModal(message, onConfirm, title) {
            const modalEl = document.getElementById('globalConfirmModal');
            document.getElementById('globalConfirmMessage').textContent = message;
            if (title) {
                document.getElementById('globalConfirmTitle').innerHTML =
                    '<i class="bi bi-exclamation-triangle text-warning me-2"></i>' + title;
            }
            const confirmBtn = document.getElementById('globalConfirmBtn');
            const newBtn = confirmBtn.cloneNode(true);
            confirmBtn.parentNode.replaceChild(newBtn, confirmBtn);
            newBtn.addEventListener('click', function () {
                bootstrap.Modal.getInstance(modalEl).hide();
                onConfirm();
            });
            new bootstrap.Modal(modalEl).show();
        }

        // Global showToast helper
        function showGlobalToast(type, message) {
            const container = document.getElementById('globalToastContainer');
            const alertClass = type === 'success' ? 'alert-success' : 'alert-danger';
            const icon = type === 'success' ? 'bi-check-circle' : 'bi-exclamation-circle';
            const toast = document.createElement('div');
            toast.className = `alert ${alertClass} d-flex align-items-center shadow-sm mb-2 py-2 px-3`;
            toast.style.minWidth = '250px';
            toast.style.animation = 'fadeIn 0.3s ease';
            toast.innerHTML = `<i class="bi ${icon} me-2"></i><span>${message}</span>`;
            container.appendChild(toast);
            setTimeout(() => {
                toast.style.transition = 'opacity 0.3s ease';
                toast.style.opacity = '0';
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }

        // Global unhandled error handlers
        window.addEventListener('unhandledrejection', function (event) {
            console.error('Unhandled promise rejection:', event.reason);
            showGlobalToast('error', 'An unexpected error occurred. Please try again.');
        });

        // ─── Debounce utility (available globally) ───
        function debounce(fn, delay) {
            let timer;
            return function (...args) {
                clearTimeout(timer);
                timer = setTimeout(() => fn.apply(this, args), delay);
            };
        }

        // ─── Mobile sidebar toggle ───
        (function () {
            const toggle = document.getElementById('mobileNavToggle');
            const overlay = document.getElementById('sidebarOverlay');
            const sidebar = document.querySelector('.sidebar');
            const icon = document.getElementById('mobileNavIcon');
            if (!toggle || !sidebar) return;

            function openSidebar() {
                sidebar.classList.add('mobile-open');
                overlay?.classList.add('show');
                if (icon) { icon.className = 'bi bi-x-lg'; }
            }

            function closeSidebar() {
                sidebar.classList.remove('mobile-open');
                overlay?.classList.remove('show');
                if (icon) { icon.className = 'bi bi-list'; }
            }

            toggle.addEventListener('click', function () {
                sidebar.classList.contains('mobile-open') ? closeSidebar() : openSidebar();
            });
            overlay?.addEventListener('click', closeSidebar);

            // Close sidebar on nav link click (mobile)
            sidebar.querySelectorAll('a[href]').forEach(function (link) {
                link.addEventListener('click', function () {
                    if (window.innerWidth < 768) closeSidebar();
                });
            });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>