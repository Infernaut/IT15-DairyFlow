@using Microsoft.AspNetCore.Identity
@using IT15_DairyFlow.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    var layoutUser = SignInManager.IsSignedIn(User) ? await UserManager.GetUserAsync(User) : null;
    var layoutCompanyId = layoutUser?.CompanyID?.ToString() ?? "";
}

<!DOCTYPE html>
<html lang="en" data-company-id="@layoutCompanyId">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DairyFlow ERP</title>
    <link rel="icon" type="image/png" href="~/images/logo.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        :root {
            --blue-main: #0d6efd;
            --sidebar-width: 272px;
            --nav-height: 64px;
            --navy: #0f172a;
            --slate: #334155;
            --muted: #64748b;
            --border: #e2e8f0;
            --surface: #f8fafc;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--surface);
            height: 100vh;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        /* On mobile, let the body scroll naturally */
        @@media (max-width: 767.98px) {
            body {
                overflow: auto;
                -webkit-overflow-scrolling: touch;
            }
        }

        /* ═══ NAVBAR ═══════════════════════════════════════════ */
        .navbar-custom {
            height: var(--nav-height);
            border-bottom: 1px solid var(--border) !important;
            z-index: 1030;
            margin-left: 0;
            background: #fff !important;
            backdrop-filter: blur(12px);
        }

        /* Guest navbar — transparent over hero, becomes white on scroll */
        body:not(.has-sidebar) .navbar-custom {
            background: rgba(255,255,255,.95) !important;
            box-shadow: 0 1px 3px rgba(0,0,0,.04);
        }

        body:not(.has-sidebar) .navbar-custom .navbar-brand {
            font-size: 1.15rem;
            letter-spacing: -0.02em;
        }

        body:not(.has-sidebar) .navbar-custom .nav-link {
            font-weight: 500;
            color: var(--slate);
            padding: .5rem 1rem !important;
            border-radius: 8px;
            transition: all .2s ease;
        }

        body:not(.has-sidebar) .navbar-custom .nav-link:hover {
            background: rgba(13,110,253,.06);
            color: var(--blue-main);
        }

        /* When sidebar is present, push content — gradient navbar */
        .has-sidebar .navbar-custom {
            margin-left: var(--sidebar-width);
            background: linear-gradient(135deg, #1e3a5f 0%, #0f172a 100%) !important;
            border-bottom: none !important;
            box-shadow: 0 2px 12px rgba(15,23,42,.18);
        }

        /* Sidebar brand overlay behind navbar */
        .has-sidebar .navbar-custom::before {
            content: '';
            position: absolute;
            left: calc(var(--sidebar-width) * -1);
            top: 0;
            width: var(--sidebar-width);
            height: 100%;
            pointer-events: none;
            z-index: -1;
        }

        .has-sidebar .main-wrapper {
            margin-left: var(--sidebar-width);
        }

        /* ═══ AUTHENTICATED NAVBAR ENHANCEMENTS ═══════════════ */
        .has-sidebar .navbar-custom .navbar-nav .nav-link {
            font-size: .85rem;
            color: rgba(255,255,255,.8);
            transition: color .2s ease;
        }

        .has-sidebar .navbar-custom .navbar-nav .nav-link:hover {
            color: #fff;
        }

        /* Portal label */
        .nav-portal-label {
            font-size: .78rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .06em;
            color: rgba(255,255,255,.5);
            opacity: .7;
        }

        /* Authenticated navbar brand text & icons */
        .has-sidebar .navbar-custom .navbar-brand {
            color: #fff !important;
        }

        .has-sidebar .navbar-custom .btn-outline-secondary,
        .has-sidebar .navbar-custom .text-muted {
            color: rgba(255,255,255,.7) !important;
            border-color: rgba(255,255,255,.2) !important;
        }

        .has-sidebar .navbar-custom .btn-outline-secondary:hover {
            background: rgba(255,255,255,.1) !important;
            color: #fff !important;
        }

        /* Right-side scrollbar for main content area */
        main[role="main"] {
            scrollbar-width: thin;
            scrollbar-color: rgba(0,0,0,0.12) transparent;
        }

        main[role="main"]::-webkit-scrollbar {
            width: 6px;
        }

        main[role="main"]::-webkit-scrollbar-track {
            background: transparent;
        }

        main[role="main"]::-webkit-scrollbar-thumb {
            background-color: rgba(0,0,0,0.12);
            border-radius: 6px;
        }

        main[role="main"]::-webkit-scrollbar-thumb:hover {
            background-color: rgba(0,0,0,0.22);
        }

        /* Hide Scrollbars on sidebar while allowing functionality */
        .sidebar-scroll-container {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }

        .sidebar-scroll-container::-webkit-scrollbar {
            display: none;
        }

        .main-wrapper {
            display: flex;
            flex: 1;
            overflow: hidden;
        }

        main[role="main"] {
            flex: 1;
            overflow-y: auto;
            padding: 0;
        }

        .footer-custom {
            background: #fff;
            border-top: 1px solid var(--border);
            padding: 1rem 0;
        }

        /* ═══ SHARED SIDEBAR BASE ═════════════════════════════ */
        .sidebar {
            min-width: var(--sidebar-width);
            max-width: var(--sidebar-width);
            background: #fff;
            border-right: 1px solid var(--border);
            height: 100vh;
            position: fixed;
            top: 0;
            left: 0;
            display: flex;
            flex-direction: column;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            z-index: 1040;
            box-shadow: 1px 0 4px rgba(0,0,0,.03);
        }

        .sidebar-brand {
            display: flex;
            align-items: center;
            padding: 0 1.25rem;
            border-bottom: 1px solid rgba(255,255,255,.1);
            min-height: var(--nav-height);
        }

        .sidebar-brand-icon {
            width: 36px;
            height: 36px;
            background: rgba(255,255,255,0.25);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 11px;
            flex-shrink: 0;
            box-shadow: 0 2px 6px rgba(0,0,0,.12);
        }

        .sidebar-brand-icon i {
            font-size: 1.25rem;
            color: #fff;
            text-shadow: 0 1px 3px rgba(0,0,0,.15);
        }

        .sidebar-brand-text {
            color: #fff;
            font-weight: 700;
            font-size: 1.15rem;
            letter-spacing: -0.03em;
        }

        .sidebar-brand-subtitle {
            color: rgba(255,255,255,0.6);
            font-size: 0.65rem;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            font-weight: 600;
        }

        .sidebar-scroll-container {
            flex: 1;
            overflow-y: auto;
            padding: 0.75rem 0;
        }

        .sidebar-section-label {
            font-size: 0.68rem;
            text-transform: uppercase;
            font-weight: 700;
            color: #94a3b8;
            padding: 1.15rem 1.25rem 0.4rem;
            letter-spacing: 0.06em;
        }

        .sidebar-link {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0.55rem 1.25rem;
            margin: 1px 0.5rem;
            color: var(--slate);
            text-decoration: none !important;
            font-weight: 500;
            font-size: 0.875rem;
            transition: all 0.15s ease;
            border-radius: 8px;
            border-left: none;
        }

        .sidebar-link i:first-child {
            font-size: 1.05rem;
            width: 24px;
            color: var(--muted);
        }

        .sidebar-link:hover {
            background: rgba(13,110,253,.06);
            color: var(--blue-main);
        }

        .sidebar-link:hover i {
            color: var(--blue-main);
        }

        .sidebar-link.active {
            background: rgba(13,110,253,.08);
            color: var(--blue-main);
            font-weight: 600;
        }

        .sidebar-link.active i {
            color: var(--blue-main);
        }

        /* Submenu styles */
        .sidebar-submenu {
            background: transparent;
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .submenu-link {
            display: block;
            padding: 0.4rem 1.25rem 0.4rem 3.25rem;
            margin: 0 0.5rem;
            color: var(--muted);
            font-size: 0.82rem;
            text-decoration: none !important;
            transition: all 0.15s ease;
            border-radius: 6px;
        }

        .submenu-link:hover {
            color: var(--blue-main);
            background: rgba(13,110,253,.04);
        }

        .submenu-link.active {
            color: var(--blue-main);
            font-weight: 600;
            background: rgba(13,110,253,.06);
        }
    </style>
</head>
<body class="@(SignInManager.IsSignedIn(User) ? "has-sidebar" : "")">
    <!-- Skip to main content link for keyboard/screen-reader users -->
    <a href="#mainContent" class="skip-to-content">Skip to main content</a>

    @if (SignInManager.IsSignedIn(User))
    {
        <button class="mobile-nav-toggle" id="mobileNavToggle" aria-label="Toggle navigation menu">
            <i class="bi bi-list" id="mobileNavIcon"></i>
        </button>
        <div class="sidebar-overlay" id="sidebarOverlay" aria-hidden="true"></div>
    }
    <header role="banner">
        <nav class="navbar navbar-expand-sm navbar-light navbar-custom" aria-label="Main navigation">
            <div class="container-fluid px-3">
                @if (!SignInManager.IsSignedIn(User))
                {
                    <a class="navbar-brand fw-bold text-primary d-flex align-items-center" asp-controller="Home" asp-action="Index">
                        <img src="~/images/logo.png" alt="DairyFlow Logo" style="width:28px;height:28px;object-fit:contain;" class="me-2" />DairyFlow
                    </a>
                }
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if (!SignInManager.IsSignedIn(User))
                        {
                            <li class="nav-item">
                                <a class="nav-link px-3" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link px-3" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item d-flex align-items-center">
                                <span class="nav-portal-label px-3">DairyFlow ERP</span>
                            </li>
                               <li class="nav-item">
                                   <a class="nav-link" asp-controller="SuperAdmin" asp-action="BackfillProtectedEmails">Backfill Protected Emails</a>
                               </li>
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <div class="main-wrapper">
        @if (SignInManager.IsSignedIn(User))
        {
            if (User.IsInRole("Superadmin"))
            {
                <partial name="_SuperAdminSidebarPartial" />
            }
            else if (User.IsInRole("Admin"))
            {
                <partial name="_AdminSidebarPartial" />
            }
            else
            {
                <partial name="_SidebarPartial" />
            }
        }

        <main role="main" id="mainContent" tabindex="-1">
            @RenderBody()

            @if (!SignInManager.IsSignedIn(User))
            {
                <footer class="footer-custom">
                    <div class="container text-center">
                        <span>&copy; 2026 - DairyFlow ERP</span>
                    </div>
                </footer>
            }
        </main>
    </div>

    <!-- Global Confirm Modal -->
    <div class="modal fade" id="globalConfirmModal" tabindex="-1" aria-hidden="true" aria-labelledby="globalConfirmTitle" role="dialog">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content">
                <div class="modal-header border-0 pb-0">
                    <h6 class="modal-title fw-bold" id="globalConfirmTitle">
                        <i class="bi bi-exclamation-triangle text-warning me-2"></i>Confirm Action
                    </h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close dialog"></button>
                </div>
                <div class="modal-body pt-2">
                    <p class="mb-0 text-muted" id="globalConfirmMessage">Are you sure?</p>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary btn-sm" id="globalConfirmBtn">Confirm</button>
                </div>
            </div>
        </div>
    </div>

    @if (SignInManager.IsSignedIn(User))
    {
        @Html.AntiForgeryToken()
    }

    <!-- Global Error Toast Container -->
    <div id="globalToastContainer" class="position-fixed top-0 end-0 p-3" style="z-index: 9999;" role="status" aria-live="polite"></div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js" defer></script>
    <script src="~/js/signalr-client.js" asp-append-version="true" defer></script>
    <script>
        // Global confirm modal helper
        function showConfirmModal(message, onConfirm, title) {
            const modalEl = document.getElementById('globalConfirmModal');
            document.getElementById('globalConfirmMessage').textContent = message;
            if (title) {
                document.getElementById('globalConfirmTitle').innerHTML =
                    '<i class="bi bi-exclamation-triangle text-warning me-2"></i>' + title;
            }
            const confirmBtn = document.getElementById('globalConfirmBtn');
            const newBtn = confirmBtn.cloneNode(true);
            confirmBtn.parentNode.replaceChild(newBtn, confirmBtn);
            newBtn.addEventListener('click', function () {
                bootstrap.Modal.getInstance(modalEl).hide();
                onConfirm();
            });
            new bootstrap.Modal(modalEl).show();
        }

        // Global showToast helper
        function showGlobalToast(type, message) {
            const container = document.getElementById('globalToastContainer');
            const alertClass = type === 'success' ? 'alert-success' : 'alert-danger';
            const icon = type === 'success' ? 'bi-check-circle' : 'bi-exclamation-circle';
            const toast = document.createElement('div');
            toast.className = `alert ${alertClass} d-flex align-items-center shadow-sm mb-2 py-2 px-3`;
            toast.style.minWidth = '250px';
            toast.style.animation = 'fadeIn 0.3s ease';
            toast.innerHTML = `<i class="bi ${icon} me-2"></i><span>${message}</span>`;
            container.appendChild(toast);
            setTimeout(() => {
                toast.style.transition = 'opacity 0.3s ease';
                toast.style.opacity = '0';
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }

        // Global unhandled error handlers
        window.addEventListener('unhandledrejection', function (event) {
            console.error('Unhandled promise rejection:', event.reason);
            showGlobalToast('error', 'An unexpected error occurred. Please try again.');
        });

        // ─── Debounce utility (available globally) ───
        function debounce(fn, delay) {
            let timer;
            return function (...args) {
                clearTimeout(timer);
                timer = setTimeout(() => fn.apply(this, args), delay);
            };
        }

        // ─── Mobile sidebar toggle ───
        (function () {
            const toggle = document.getElementById('mobileNavToggle');
            const overlay = document.getElementById('sidebarOverlay');
            const sidebar = document.querySelector('.sidebar');
            const icon = document.getElementById('mobileNavIcon');
            if (!toggle || !sidebar) return;

            function openSidebar() {
                sidebar.classList.add('mobile-open');
                overlay?.classList.add('show');
                if (icon) { icon.className = 'bi bi-x-lg'; }
            }

            function closeSidebar() {
                sidebar.classList.remove('mobile-open');
                overlay?.classList.remove('show');
                if (icon) { icon.className = 'bi bi-list'; }
            }

            toggle.addEventListener('click', function () {
                sidebar.classList.contains('mobile-open') ? closeSidebar() : openSidebar();
            });
            overlay?.addEventListener('click', closeSidebar);

            // Close sidebar on nav link click (mobile)
            sidebar.querySelectorAll('a[href]').forEach(function (link) {
                link.addEventListener('click', function () {
                    if (window.innerWidth < 768) closeSidebar();
                });
            });
        })();
    </script>
    <script src="~/js/table-pagination.js" asp-append-version="true"></script>
    <script src="~/js/password-criteria.js" asp-append-version="true"></script>
    <script src="~/js/notifications.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>