@{
    string currentController = ViewContext.RouteData.Values["Controller"]?.ToString() ?? "";
    string currentAction = ViewContext.RouteData.Values["Action"]?.ToString() ?? "";
}

<style>
    .sidebar {
        min-width: 280px;
        max-width: 280px;
        background: #ffffff;
        border-right: 1px solid #eef2f7;
        height: 100vh;
        position: fixed;
        top: 0;
        left: 0;
        display: flex;
        flex-direction: column;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        z-index: 1040;
        box-shadow: 2px 0 8px rgba(0,0,0,0.05);
    }

    .sidebar-scroll-container {
        flex: 1;
        overflow-y: auto;
        padding: 1rem 0;
        -ms-overflow-style: none;
        scrollbar-width: none;
    }

        .sidebar-scroll-container::-webkit-scrollbar {
            display: none;
        }

    .sidebar-section-label {
        font-size: 0.7rem;
        text-transform: uppercase;
        font-weight: 700;
        color: #94a3b8;
        padding: 1.25rem 1.5rem 0.5rem;
        letter-spacing: 0.05em;
    }

    .sidebar-link {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.7rem 1.5rem;
        color: #475569;
        text-decoration: none !important;
        font-weight: 500;
        font-size: 0.9rem;
        transition: all 0.2s;
        border-left: 4px solid transparent;
    }

        .sidebar-link i:first-child {
            font-size: 1.1rem;
            width: 25px;
            color: #64748b;
        }

        .sidebar-link:hover {
            background: #f8fbff;
            color: #0d6efd;
        }

            .sidebar-link:hover i {
                color: #0d6efd;
            }

        .sidebar-link.active {
            background: #f0f7ff;
            color: #0d6efd;
            border-left-color: #0d6efd;
            font-weight: 600;
        }
</style>

<div class="sidebar d-none d-md-flex">
    <!-- Brand / Logo -->
    <div style="display:flex;align-items:center;padding:1rem 1.5rem;border-bottom:1px solid #eef2f7;min-height:70px;background:linear-gradient(135deg,#6610f2 0%,#4c0eb8 100%);">
        <div style="width:40px;height:40px;background:rgba(255,255,255,0.2);border-radius:10px;display:flex;align-items:center;justify-content:center;margin-right:12px;">
            <i class="bi bi-stars" style="font-size:1.5rem;color:#fff;"></i>
        </div>
        <div>
            <div style="color:#fff;font-weight:700;font-size:1.25rem;letter-spacing:-0.5px;">DairyFlow</div>
            <div style="color:rgba(255,255,255,0.7);font-size:0.7rem;text-transform:uppercase;letter-spacing:1px;">SuperAdmin</div>
        </div>
    </div>

    <div class="sidebar-scroll-container">
        <div class="sidebar-section-label">Platform</div>

        <a class="sidebar-link @(currentController == "SuperAdmin" && currentAction == "Dashboard" ? "active" : "")" asp-controller="SuperAdmin" asp-action="Dashboard">
            <span><i class="bi bi-speedometer2 me-2"></i> Dashboard</span>
        </a>
        <a class="sidebar-link @(currentController == "SuperAdmin" && currentAction == "Companies" ? "active" : "")" asp-controller="SuperAdmin" asp-action="Companies">
            <span><i class="bi bi-buildings me-2"></i> Companies</span>
        </a>
        <a class="sidebar-link @(currentController == "SuperAdmin" && currentAction == "Subscriptions" ? "active" : "")" asp-controller="SuperAdmin" asp-action="Subscriptions">
            <span><i class="bi bi-receipt-cutoff me-2"></i> Subscriptions</span>
        </a>
        <a class="sidebar-link @(currentController == "SuperAdmin" && currentAction == "Analytics" ? "active" : "")" asp-controller="SuperAdmin" asp-action="Analytics">
            <span><i class="bi bi-bar-chart me-2"></i> Usage Analytics</span>
        </a>

        <div class="sidebar-section-label">Administration</div>

        <a class="sidebar-link @(currentController == "SuperAdmin" && (currentAction == "Users" || currentAction == "UserRoles") ? "active" : "")" asp-controller="SuperAdmin" asp-action="Users">
            <span><i class="bi bi-people me-2"></i> User Management</span>
        </a>
        <a class="sidebar-link @(currentController == "SuperAdmin" && (currentAction == "Roles" || currentAction == "CreateRole" || currentAction == "EditRole") ? "active" : "")" asp-controller="SuperAdmin" asp-action="Roles">
            <span><i class="bi bi-shield-lock me-2"></i> Role Management</span>
        </a>

        <div class="sidebar-section-label">Monitoring</div>
        <a class="sidebar-link @(currentController == "SuperAdmin" && currentAction == "Logs" ? "active" : "")" asp-controller="SuperAdmin" asp-action="Logs">
            <span><i class="bi bi-journal-text me-2"></i> Audit Logs</span>
        </a>
    </div>
</div>
