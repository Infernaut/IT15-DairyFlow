@{
    string currentController = ViewContext.RouteData.Values["Controller"]?.ToString() ?? "";
    string currentAction = ViewContext.RouteData.Values["Action"]?.ToString() ?? "";
}

<div class="sidebar" role="navigation" aria-label="Admin navigation">
    <!-- Brand / Logo -->
    <div class="sidebar-brand" style="background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%);">
        <div class="sidebar-brand-icon">
            <img src="~/images/logo.png" alt="DairyFlow Logo" style="width:36px;height:36px;object-fit:contain;" />
        </div>
        <div>
            <div class="sidebar-brand-text">DairyFlow</div>
            <div class="sidebar-brand-subtitle">Admin Panel</div>
        </div>
    </div>

    <div class="sidebar-scroll-container">
        <div class="sidebar-section-label">Administration</div>

        <a class="sidebar-link @(currentController == "Admin" && currentAction == "Dashboard" ? "active" : "")" asp-controller="Admin" asp-action="Dashboard">
            <span><i class="bi bi-speedometer2 me-2"></i> Dashboard</span>
        </a>

        <a class="sidebar-link @(currentController == "Admin" && (currentAction == "Users" || currentAction == "CreateUser") ? "active" : "")" asp-controller="Admin" asp-action="Users">
            <span><i class="bi bi-people me-2"></i> User Management</span>
        </a>
        <a class="sidebar-link @(currentController == "Admin" && (currentAction == "Roles" || currentAction == "CreateRole" || currentAction == "EditRole") ? "active" : "")" asp-controller="Admin" asp-action="Roles">
            <span><i class="bi bi-shield-lock me-2"></i> Role Management</span>
        </a>

        <div class="sidebar-section-label">Operations</div>

        <a class="sidebar-link @(currentController == "PLM" && currentAction == "Approvals" ? "active" : "")" asp-controller="PLM" asp-action="Approvals">
            <span><i class="bi bi-check2-square me-2"></i> Product Approval</span>
        </a>
        
        <a class="sidebar-link @(currentController == "Equipment" ? "active" : "")" asp-controller="Equipment" asp-action="Index">
            <span><i class="bi bi-gear-fill me-2"></i> Equipment</span>
        </a>

        <div class="sidebar-section-label">Monitoring</div>
        <a class="sidebar-link @(currentController == "Admin" && currentAction == "Logs" ? "active" : "")" asp-controller="Admin" asp-action="Logs">
            <span><i class="bi bi-journal-text me-2"></i> Audit Logs</span>
        </a>

        <div class="sidebar-section-label">Configuration</div>
        <a class="sidebar-link @(currentController == "Admin" && currentAction == "Settings" ? "active" : "")" asp-controller="Admin" asp-action="Settings">
            <span><i class="bi bi-gear me-2"></i> Company Settings</span>
        </a>
        <a class="sidebar-link @(currentController == "Subscription" && currentAction == "ChangePlan" ? "active" : "")" asp-controller="Subscription" asp-action="ChangePlan">
            <span><i class="bi bi-credit-card me-2"></i> Subscription Plan</span>
        </a>

        <div class="sidebar-section-label">Support</div>
        <a class="sidebar-link @(currentAction == "HelpSupport" ? "active" : "")" asp-controller="Home" asp-action="HelpSupport">
            <span><i class="bi bi-question-circle me-2"></i> Help & Support</span>
        </a>
    </div>
</div>
