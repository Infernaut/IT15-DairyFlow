@{
    string currentController = ViewContext.RouteData.Values["Controller"]?.ToString() ?? "";
    string currentAction = ViewContext.RouteData.Values["Action"]?.ToString() ?? "";
}

<style>
    .sidebar {
        min-width: 280px;
        max-width: 280px;
        background: #ffffff;
        border-right: 1px solid #eef2f7;
        height: calc(100vh - 70px);
        position: sticky;
        top: 70px;
        display: flex;
        flex-direction: column;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        z-index: 1020;
    }

    .sidebar-scroll-container {
        flex: 1;
        overflow-y: auto;
        padding: 1rem 0;
        -ms-overflow-style: none;
        scrollbar-width: none;
    }

        .sidebar-scroll-container::-webkit-scrollbar {
            display: none;
        }

    .sidebar-section-label {
        font-size: 0.7rem;
        text-transform: uppercase;
        font-weight: 700;
        color: #94a3b8;
        padding: 1.25rem 1.5rem 0.5rem;
        letter-spacing: 0.05em;
    }

    .sidebar-link {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.7rem 1.5rem;
        color: #475569;
        text-decoration: none !important;
        font-weight: 500;
        font-size: 0.9rem;
        transition: all 0.2s;
        border-left: 4px solid transparent;
    }

        .sidebar-link i:first-child {
            font-size: 1.1rem;
            width: 25px;
            color: #64748b;
        }

        .sidebar-link:hover {
            background: #f8fbff;
            color: #0d6efd;
        }

            .sidebar-link:hover i {
                color: #0d6efd;
            }

        .sidebar-link.active {
            background: #f0f7ff;
            color: #0d6efd;
            border-left-color: #0d6efd;
            font-weight: 600;
        }
</style>

<div class="sidebar d-none d-md-flex">
    <div class="sidebar-scroll-container">
        <div class="sidebar-section-label">Administration</div>

        <a class="sidebar-link @(currentController == "Home" && currentAction == "Index" ? "active" : "")" asp-controller="Home" asp-action="Index">
            <span><i class="bi bi-speedometer2 me-2"></i> Dashboard</span>
        </a>

        <a class="sidebar-link @(currentController == "Admin" && (currentAction == "Users" || currentAction == "CreateUser") ? "active" : "")" asp-controller="Admin" asp-action="Users">
            <span><i class="bi bi-people me-2"></i> User Management</span>
        </a>
        <a class="sidebar-link @(currentController == "Admin" && (currentAction == "Roles" || currentAction == "CreateRole" || currentAction == "EditRole") ? "active" : "")" asp-controller="Admin" asp-action="Roles">
            <span><i class="bi bi-shield-lock me-2"></i> Role Management</span>
        </a>
        <a class="sidebar-link @(currentController == "Admin" && currentAction == "UserRoles" ? "active" : "")" asp-controller="Admin" asp-action="Users">
            <span><i class="bi bi-person-gear me-2"></i> User Roles</span>
        </a>

        <div class="sidebar-section-label">Monitoring</div>
        <a class="sidebar-link @(currentController == "Admin" && currentAction == "Logs" ? "active" : "")" asp-controller="Admin" asp-action="Logs">
            <span><i class="bi bi-journal-text me-2"></i> Audit Logs</span>
        </a>
    </div>
</div>
