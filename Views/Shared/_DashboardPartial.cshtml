@using Microsoft.AspNetCore.Identity
@inject UserManager<IdentityUser> UserManager

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="fw-bold text-dark h3 mb-1">Operational Overview</h1>
        <p class="text-muted small mb-0">Real-time metrics for @User.Identity?.Name's Facility</p>
    </div>
    <div class="dropdown">
        <button class="btn btn-white border shadow-sm btn-sm dropdown-toggle px-3" type="button" data-bs-toggle="dropdown">
            <i class="bi bi-calendar3 me-2"></i>Last 30 Days
        </button>
        <ul class="dropdown-menu shadow-sm">
            <li><a class="dropdown-item" href="#">Last 7 Days</a></li>
            <li><a class="dropdown-item" href="#">Quarter to Date</a></li>
        </ul>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm p-3 bg-white h-100">
            <div class="d-flex justify-content-between">
                <div>
                    <p class="text-muted small fw-bold text-uppercase mb-1">Active Products</p>
                    <h2 class="fw-bold mb-0">124</h2>
                    <span class="text-success small fw-medium"><i class="bi bi-arrow-up-short"></i>+3.2%</span>
                </div>
                <div class="module-icon bg-blue-sky text-primary"><i class="bi bi-droplet"></i></div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm p-3 bg-white h-100">
            <div class="d-flex justify-content-between">
                <div>
                    <p class="text-muted small fw-bold text-uppercase mb-1">Ongoing Batches</p>
                    <h2 class="fw-bold mb-0">18</h2>
                    <span class="text-primary small fw-medium">4 Ending Today</span>
                </div>
                <div class="module-icon bg-blue-sky text-primary"><i class="bi bi-layers"></i></div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm p-3 bg-white h-100">
            <div class="d-flex justify-content-between">
                <div>
                    <p class="text-muted small fw-bold text-uppercase mb-1">Stock Status</p>
                    <h2 class="fw-bold mb-0 text-success">Healthy</h2>
                    <span class="text-danger small fw-medium"><i class="bi bi-exclamation-triangle"></i> 2 Low Items</span>
                </div>
                <div class="module-icon bg-blue-sky text-primary"><i class="bi bi-box-seam"></i></div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm p-3 bg-white h-100">
            <div class="d-flex justify-content-between">
                <div>
                    <p class="text-muted small fw-bold text-uppercase mb-1">Prod. Cost (MTD)</p>
                    <h2 class="fw-bold mb-0">$42.5k</h2>
                    <span class="text-muted small fw-medium">-$1.2k vs Budget</span>
                </div>
                <div class="module-icon bg-blue-sky text-primary"><i class="bi bi-currency-dollar"></i></div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm p-4 h-100">
            <h6 class="fw-bold mb-3">Production Volume vs. Targets</h6>
            <div style="height: 250px;">
                <canvas id="productionChart"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm p-4 h-100">
            <h6 class="fw-bold mb-3">Quality Assurance Yield</h6>
            <div style="height: 180px;">
                <canvas id="qualityPieChart"></canvas>
            </div>
            <div class="mt-3">
                <div class="d-flex justify-content-between mb-1 small">
                    <span>Passed</span><span class="fw-bold text-success">98.2%</span>
                </div>
                <div class="progress" style="height: 6px;">
                    <div class="progress-bar bg-success" style="width: 98%"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="p-4 border-bottom d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0">Inventory Expiry Alerts</h6>
                <span class="badge bg-soft-danger text-danger">High Priority</span>
            </div>
            <div class="p-0">
                <ul class="list-group list-group-flush">
                    <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                        <div>
                            <div class="fw-bold mb-0">Raw Milk - Tank A</div>
                            <small class="text-muted">Batch #RM-990</small>
                        </div>
                        <span class="text-danger fw-bold">Expires in 12h</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                        <div>
                            <div class="fw-bold mb-0">Skimmed Milk Powder</div>
                            <small class="text-muted">Warehouse Section B</small>
                        </div>
                        <span class="text-warning fw-bold">Low Stock (20kg)</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm p-4 h-100">
            <h6 class="fw-bold mb-3">Cost Breakdown</h6>
            <div class="d-flex align-items-center h-100">
                <div class="flex-grow-1">
                    <div class="mb-3">
                        <small class="text-muted d-block">Raw Materials (65%)</small>
                        <div class="progress" style="height: 8px;"><div class="progress-bar bg-primary" style="width: 65%"></div></div>
                    </div>
                    <div class="mb-3">
                        <small class="text-muted d-block">Labor & Logistics (25%)</small>
                        <div class="progress" style="height: 8px;"><div class="progress-bar bg-info" style="width: 25%"></div></div>
                    </div>
                    <div>
                        <small class="text-muted d-block">Overheads (10%)</small>
                        <div class="progress" style="height: 8px;"><div class="progress-bar bg-secondary" style="width: 10%"></div></div>
                    </div>
                </div>
                <div class="ps-4 text-center">
                    <h3 class="fw-bold text-primary mb-0">$28.1k</h3>
                    <small class="text-muted">Direct Cost</small>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm overflow-hidden">
    <div class="p-4 border-bottom bg-white">
        <h6 class="fw-bold mb-0">Live Audit Trail</h6>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr class="small text-uppercase text-muted">
                    <th class="ps-4">Activity</th>
                    <th>Staff</th>
                    <th>Module</th>
                    <th>Time</th>
                    <th class="text-end pe-4">Status</th>
                </tr>
            </thead>
            <tbody class="small">
                <tr>
                    <td class="ps-4 fw-bold">Sterilization Temperature Check</td>
                    <td>S. Miller</td>
                    <td>Quality</td>
                    <td>10 mins ago</td>
                    <td class="text-end pe-4"><span class="badge rounded-pill bg-soft-success text-success px-3">Passed</span></td>
                </tr>
                <tr>
                    <td class="ps-4 fw-bold">Batch #DF-202-A Start</td>
                    <td>A. Chen</td>
                    <td>Production</td>
                    <td>45 mins ago</td>
                    <td class="text-end pe-4"><span class="badge rounded-pill bg-soft-primary text-primary px-3">Active</span></td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<style>
    .bg-blue-sky {
        background-color: #f0f7ff;
    }

    .bg-soft-success {
        background-color: #e6fcf5;
    }

    .bg-soft-danger {
        background-color: #fff5f5;
    }

    .bg-soft-primary {
        background-color: #f0f7ff;
    }

    .module-icon {
        width: 42px;
        height: 42px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
    }
</style>