@model IT15_DairyFlow.Controllers.RawMaterialPageViewModel

@{
    ViewData["Title"] = "Raw Materials";
}

<div class="container-fluid p-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1 fw-bold">Raw Materials Inventory</h2>
            <p class="text-muted mb-0">Manage raw materials, track stock levels, and link to product formulations.</p>
        </div>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addMaterialModal">
            <i class="bi bi-plus-lg me-1"></i> Add Raw Material
        </button>
    </div>

    <!-- Summary Cards -->
    <div class="row g-4 mb-4">
        <div class="col-lg-3 col-md-6">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="rounded-circle bg-primary bg-opacity-10 p-3 me-3">
                            <i class="bi bi-box-seam text-primary fs-4"></i>
                        </div>
                        <div>
                            <h6 class="text-muted mb-1 small text-uppercase">Total Materials</h6>
                            <h3 class="mb-0 fw-bold">@Model.Summary.TotalMaterials</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="rounded-circle bg-warning bg-opacity-10 p-3 me-3">
                            <i class="bi bi-exclamation-triangle text-warning fs-4"></i>
                        </div>
                        <div>
                            <h6 class="text-muted mb-1 small text-uppercase">Low Stock</h6>
                            <h3 class="mb-0 fw-bold text-warning">@Model.Summary.LowStockCount</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="rounded-circle bg-danger bg-opacity-10 p-3 me-3">
                            <i class="bi bi-x-circle text-danger fs-4"></i>
                        </div>
                        <div>
                            <h6 class="text-muted mb-1 small text-uppercase">Out of Stock</h6>
                            <h3 class="mb-0 fw-bold text-danger">@Model.Summary.OutOfStockCount</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="rounded-circle bg-success bg-opacity-10 p-3 me-3">
                            <i class="bi bi-currency-dollar text-success fs-4"></i>
                        </div>
                        <div>
                            <h6 class="text-muted mb-1 small text-uppercase">Total Value</h6>
                            <h3 class="mb-0 fw-bold text-success">₱@Model.Summary.TotalValue.ToString("N2")</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Materials Table -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center py-3">
            <div class="d-flex align-items-center">
                <i class="bi bi-box-seam text-primary me-2"></i>
                <h6 class="mb-0 fw-semibold">Raw Materials</h6>
            </div>
            <div>
                <select id="statusFilter" class="form-select form-select-sm" style="width: auto;">
                    <option value="">All Status</option>
                    <option value="In Stock">In Stock</option>
                    <option value="Low Stock">Low Stock</option>
                    <option value="Out of Stock">Out of Stock</option>
                </select>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="materialsTable">
                    <thead class="table-light">
                        <tr>
                            <th class="px-4">Material</th>
                            <th>Supplier</th>
                            <th>Unit Cost</th>
                            <th>Stock</th>
                            <th>Status</th>
                            <th>Used In</th>
                            <th>Last Restock</th>
                            <th class="text-end px-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Materials.Any())
                        {
                            @foreach (var item in Model.Materials)
                            {
                                var statusClass = item.StockStatus switch
                                {
                                    "In Stock" => "bg-success",
                                    "Low Stock" => "bg-warning",
                                    "Out of Stock" => "bg-danger",
                                    _ => "bg-secondary"
                                };
                                <tr data-status="@item.StockStatus">
                                    <td class="px-4">
                                        <div class="d-flex align-items-center">
                                            <div class="rounded-circle bg-primary bg-opacity-10 p-2 me-2">
                                                <i class="bi bi-droplet-fill text-primary"></i>
                                            </div>
                                            <span class="fw-semibold">@item.MaterialName</span>
                                        </div>
                                    </td>
                                    <td>@item.SupplierName</td>
                                    <td>₱@item.UnitCost.ToString("N2") / @item.Unit</td>
                                    <td>
                                        <span class="fw-semibold">@item.CurrentStock</span> @item.Unit
                                        <br />
                                        <small class="text-muted">Min: @item.MinimumStock</small>
                                    </td>
                                    <td>
                                        <span class="badge @statusClass">@item.StockStatus</span>
                                    </td>
                                    <td>
                                        @if (item.UsedInProductCount > 0)
                                        {
                                            <span class="badge bg-info">@item.UsedInProductCount product(s)</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.LastRestockDate.HasValue)
                                        {
                                            @item.LastRestockDate.Value.ToString("MMM dd, yyyy")
                                        }
                                        else
                                        {
                                            <span class="text-muted">Never</span>
                                        }
                                    </td>
                                    <td class="text-end px-4">
                                        <div class="btn-group">
                                            <button class="btn btn-sm btn-outline-success" onclick="restockMaterial(@item.RawMaterialID, '@item.MaterialName', '@item.Unit')" title="Restock">
                                                <i class="bi bi-plus-circle"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-warning" onclick="consumeMaterial(@item.RawMaterialID, '@item.MaterialName', '@item.Unit', @item.CurrentStock)" title="Consume">
                                                <i class="bi bi-dash-circle"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-primary" onclick="editMaterial(@item.RawMaterialID)" title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-danger" onclick="deleteMaterial(@item.RawMaterialID, '@item.MaterialName')" title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-4 text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                    No raw materials found. Add your first material to get started.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Add Material Modal -->
<div class="modal fade" id="addMaterialModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold">Add Raw Material</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="addMaterialForm">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Material Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="add_materialName" required maxlength="256">
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Supplier <span class="text-danger">*</span></label>
                        <select class="form-select" id="add_supplierID" required>
                            <option value="">Select Supplier</option>
                            @foreach (var supplier in Model.Suppliers)
                            {
                                <option value="@supplier.SupplierID">@supplier.SupplierName</option>
                            }
                        </select>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">Unit Cost (₱)</label>
                            <input type="number" class="form-control" id="add_unitCost" step="0.01" min="0">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">Unit</label>
                            <select class="form-select" id="add_unit">
                                <option value="kg">Kilogram (kg)</option>
                                <option value="L">Liter (L)</option>
                                <option value="pcs">Pieces (pcs)</option>
                                <option value="g">Gram (g)</option>
                                <option value="mL">Milliliter (mL)</option>
                            </select>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">Initial Stock</label>
                            <input type="number" class="form-control" id="add_currentStock" min="0" value="0">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">Minimum Stock</label>
                            <input type="number" class="form-control" id="add_minimumStock" min="0" value="10">
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="submitAddMaterial()">
                    <i class="bi bi-plus-lg me-1"></i> Add Material
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Edit Material Modal -->
<div class="modal fade" id="editMaterialModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold">Edit Raw Material</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="editMaterialForm">
                    <input type="hidden" id="edit_rawMaterialID">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Material Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="edit_materialName" required maxlength="256">
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Supplier <span class="text-danger">*</span></label>
                        <select class="form-select" id="edit_supplierID" required>
                            <option value="">Select Supplier</option>
                            @foreach (var supplier in Model.Suppliers)
                            {
                                <option value="@supplier.SupplierID">@supplier.SupplierName</option>
                            }
                        </select>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">Unit Cost (₱)</label>
                            <input type="number" class="form-control" id="edit_unitCost" step="0.01" min="0">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">Unit</label>
                            <select class="form-select" id="edit_unit">
                                <option value="kg">Kilogram (kg)</option>
                                <option value="L">Liter (L)</option>
                                <option value="pcs">Pieces (pcs)</option>
                                <option value="g">Gram (g)</option>
                                <option value="mL">Milliliter (mL)</option>
                            </select>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Minimum Stock</label>
                        <input type="number" class="form-control" id="edit_minimumStock" min="0">
                    </div>
                </form>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="submitEditMaterial()">
                    <i class="bi bi-check-lg me-1"></i> Save Changes
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Restock Modal -->
<div class="modal fade" id="restockModal" tabindex="-1">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold">Restock Material</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted mb-3">Restocking: <strong id="restock_materialName"></strong></p>
                <form id="restockForm">
                    <input type="hidden" id="restock_rawMaterialID">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Quantity <span id="restock_unit"></span></label>
                        <input type="number" class="form-control" id="restock_quantity" min="1" required>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="restock_createExpense" checked>
                        <label class="form-check-label" for="restock_createExpense">
                            Record as expense
                        </label>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success" onclick="submitRestock()">
                    <i class="bi bi-plus-circle me-1"></i> Restock
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Consume Modal -->
<div class="modal fade" id="consumeModal" tabindex="-1">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold">Consume Material</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted mb-3">Consuming: <strong id="consume_materialName"></strong></p>
                <p class="small">Available: <strong id="consume_available"></strong> <span id="consume_unit2"></span></p>
                <form id="consumeForm">
                    <input type="hidden" id="consume_rawMaterialID">
                    <input type="hidden" id="consume_maxStock">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Quantity <span id="consume_unit"></span></label>
                        <input type="number" class="form-control" id="consume_quantity" min="1" required>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-warning" onclick="submitConsume()">
                    <i class="bi bi-dash-circle me-1"></i> Consume
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const csrfToken = '@Html.AntiForgeryToken()'.match(/value="([^"]+)"/)[1];

        // Filter by status
        document.getElementById('statusFilter').addEventListener('change', function() {
            const filterValue = this.value;
            const rows = document.querySelectorAll('#materialsTable tbody tr[data-status]');
            rows.forEach(row => {
                if (!filterValue || row.dataset.status === filterValue) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        });

        // Add Material
        function submitAddMaterial() {
            const data = {
                materialName: document.getElementById('add_materialName').value,
                supplierID: parseInt(document.getElementById('add_supplierID').value),
                unitCost: parseFloat(document.getElementById('add_unitCost').value) || null,
                unit: document.getElementById('add_unit').value,
                currentStock: parseInt(document.getElementById('add_currentStock').value) || 0,
                minimumStock: parseInt(document.getElementById('add_minimumStock').value) || 10
            };

            if (!data.materialName || !data.supplierID) {
                showGlobalToast('error', 'Please fill in all required fields.');
                return;
            }

            fetch('/Inventory/CreateRawMaterial', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': csrfToken
                },
                body: JSON.stringify(data)
            })
            .then(response => response.json())
            .then(result => {
                if (result.success) {
                    location.reload();
                } else {
                    showGlobalToast('error', result.message || 'Error creating material.');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                showGlobalToast('error', 'Error creating material.');
            });
        }

        // Edit Material
        function editMaterial(id) {
            fetch(`/Inventory/GetRawMaterialDetail/${id}`)
            .then(response => response.json())
            .then(data => {
                document.getElementById('edit_rawMaterialID').value = data.rawMaterialID;
                document.getElementById('edit_materialName').value = data.materialName;
                document.getElementById('edit_supplierID').value = data.supplierID;
                document.getElementById('edit_unitCost').value = data.unitCost || '';
                document.getElementById('edit_unit').value = data.unit || 'kg';
                document.getElementById('edit_minimumStock').value = data.minimumStock || 10;
                
                new bootstrap.Modal(document.getElementById('editMaterialModal')).show();
            })
            .catch(error => {
                console.error('Error:', error);
                showGlobalToast('error', 'Error loading material details.');
            });
        }

        function submitEditMaterial() {
            const data = {
                rawMaterialID: parseInt(document.getElementById('edit_rawMaterialID').value),
                materialName: document.getElementById('edit_materialName').value,
                supplierID: parseInt(document.getElementById('edit_supplierID').value),
                unitCost: parseFloat(document.getElementById('edit_unitCost').value) || null,
                unit: document.getElementById('edit_unit').value,
                minimumStock: parseInt(document.getElementById('edit_minimumStock').value) || 10
            };

            fetch('/Inventory/UpdateRawMaterial', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': csrfToken
                },
                body: JSON.stringify(data)
            })
            .then(response => response.json())
            .then(result => {
                if (result.success) {
                    location.reload();
                } else {
                    showGlobalToast('error', result.message || 'Error updating material.');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                showGlobalToast('error', 'Error updating material.');
            });
        }

        // Restock
        function restockMaterial(id, name, unit) {
            document.getElementById('restock_rawMaterialID').value = id;
            document.getElementById('restock_materialName').textContent = name;
            document.getElementById('restock_unit').textContent = `(${unit})`;
            document.getElementById('restock_quantity').value = '';
            
            new bootstrap.Modal(document.getElementById('restockModal')).show();
        }

        function submitRestock() {
            const data = {
                rawMaterialID: parseInt(document.getElementById('restock_rawMaterialID').value),
                quantity: parseInt(document.getElementById('restock_quantity').value),
                createExpense: document.getElementById('restock_createExpense').checked
            };

            if (!data.quantity || data.quantity < 1) {
                showGlobalToast('error', 'Please enter a valid quantity.');
                return;
            }

            fetch('/Inventory/RestockRawMaterial', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': csrfToken
                },
                body: JSON.stringify(data)
            })
            .then(response => response.json())
            .then(result => {
                if (result.success) {
                    location.reload();
                } else {
                    showGlobalToast('error', result.message || 'Error restocking material.');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                showGlobalToast('error', 'Error restocking material.');
            });
        }

        // Consume
        function consumeMaterial(id, name, unit, currentStock) {
            document.getElementById('consume_rawMaterialID').value = id;
            document.getElementById('consume_materialName').textContent = name;
            document.getElementById('consume_unit').textContent = `(${unit})`;
            document.getElementById('consume_unit2').textContent = unit;
            document.getElementById('consume_available').textContent = currentStock;
            document.getElementById('consume_maxStock').value = currentStock;
            document.getElementById('consume_quantity').value = '';
            document.getElementById('consume_quantity').max = currentStock;
            
            new bootstrap.Modal(document.getElementById('consumeModal')).show();
        }

        function submitConsume() {
            const maxStock = parseInt(document.getElementById('consume_maxStock').value);
            const quantity = parseInt(document.getElementById('consume_quantity').value);

            if (!quantity || quantity < 1) {
                showGlobalToast('error', 'Please enter a valid quantity.');
                return;
            }

            if (quantity > maxStock) {
                showGlobalToast('error', `Cannot consume more than available stock (${maxStock}).`);
                return;
            }

            const data = {
                rawMaterialID: parseInt(document.getElementById('consume_rawMaterialID').value),
                quantity: quantity
            };

            fetch('/Inventory/ConsumeRawMaterial', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': csrfToken
                },
                body: JSON.stringify(data)
            })
            .then(response => response.json())
            .then(result => {
                if (result.success) {
                    location.reload();
                } else {
                    showGlobalToast('error', result.message || 'Error consuming material.');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                showGlobalToast('error', 'Error consuming material.');
            });
        }

        // Delete Material
        function deleteMaterial(id, name) {
            showConfirmModal(`Are you sure you want to delete "${name}"? This action cannot be undone.`, () => {
                fetch(`/Inventory/DeleteRawMaterial/${id}`, {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': csrfToken
                    }
                })
                .then(response => response.json())
                .then(result => {
                    if (result.success) {
                        location.reload();
                    } else {
                        showGlobalToast('error', result.message || 'Error deleting material.');
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    showGlobalToast('error', 'Error deleting material.');
                });
            });
        }
    </script>
}
