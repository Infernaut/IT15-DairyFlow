@model IT15_DairyFlow.Models.InventoryVM.InventoryPageViewModel

@{
    ViewData["Title"] = "Inventory Management";
}

<div class="container-fluid p-4">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1 fw-bold">Inventory Management</h2>
            <p class="text-muted mb-0">Track stock levels, expiration dates, and inventory movements.</p>
        </div>
    </div>

    <!-- Summary Cards -->
    <div class="row g-4 mb-4">
        <div class="col-md-3 col-sm-6">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="rounded-circle bg-primary bg-opacity-10 p-3 me-3">
                            <i class="bi bi-box-seam-fill text-primary fs-4"></i>
                        </div>
                        <div>
                            <h6 class="text-muted mb-1 small text-uppercase">Total Items</h6>
                            <h3 class="mb-0 fw-bold">@Model.Summary.TotalItems</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="rounded-circle bg-success bg-opacity-10 p-3 me-3">
                            <i class="bi bi-boxes text-success fs-4"></i>
                        </div>
                        <div>
                            <h6 class="text-muted mb-1 small text-uppercase">Total Quantity</h6>
                            <h3 class="mb-0 fw-bold">@Model.Summary.TotalQuantity</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="rounded-circle bg-warning bg-opacity-10 p-3 me-3">
                            <i class="bi bi-exclamation-triangle-fill text-warning fs-4"></i>
                        </div>
                        <div>
                            <h6 class="text-muted mb-1 small text-uppercase">Low Stock</h6>
                            <h3 class="mb-0 fw-bold">@Model.Summary.LowStockItems</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="rounded-circle bg-danger bg-opacity-10 p-3 me-3">
                            <i class="bi bi-clock-history text-danger fs-4"></i>
                        </div>
                        <div>
                            <h6 class="text-muted mb-1 small text-uppercase">Expiring Soon</h6>
                            <h3 class="mb-0 fw-bold">@Model.Summary.ExpiringSoonItems</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filters -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                        <input type="text" class="form-control" id="searchInput" placeholder="Search products...">
                    </div>
                </div>
                <div class="col-md-3">
                    <select class="form-select" id="typeFilter">
                        <option value="">All Types</option>
                        <option value="Dairy">Dairy</option>
                        <option value="Beverage">Beverage</option>
                        <option value="Cheese">Cheese</option>
                        <option value="Yogurt">Yogurt</option>
                        <option value="Other">Other</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <select class="form-select" id="stockFilter">
                        <option value="">All Stock Levels</option>
                        <option value="instock">In Stock</option>
                        <option value="lowstock">Low Stock</option>
                        <option value="outofstock">Out of Stock</option>
                        <option value="expiring">Expiring Soon</option>
                        <option value="expired">Expired</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button class="btn btn-outline-secondary w-100" onclick="clearFilters()">
                        <i class="bi bi-x-circle me-1"></i> Clear
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Inventory Table -->
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="inventoryTable">
                    <thead class="table-light">
                        <tr>
                            <th class="px-4">Product</th>
                            <th>Type</th>
                            <th>Quantity</th>
                            <th>Unit Price</th>
                            <th>Stock Status</th>
                            <th>Expiry Date</th>
                            <th class="text-end px-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Items.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-5">
                                    <i class="bi bi-inbox display-4 d-block mb-3 opacity-25"></i>
                                    <p class="mb-0">No inventory items found. Add your first item to get started!</p>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model.Items)
                            {
                                var stockBadgeClass = item.StockStatus switch
                                {
                                    "In Stock" => "bg-success",
                                    "Low Stock" => "bg-warning",
                                    "Out of Stock" => "bg-danger",
                                    _ => "bg-secondary"
                                };
                                var expiryBadgeClass = item.IsExpired ? "bg-danger" : (item.IsExpiringSoon ? "bg-warning" : "bg-light text-dark");
                                <tr class="inventory-row" 
                                    data-inventory-id="@item.InventoryID"
                                    data-product-type="@item.ProductType"
                                    data-stock-status="@item.StockStatus.ToLower().Replace(" ", "")"
                                    data-is-expiring="@item.IsExpiringSoon.ToString().ToLower()"
                                    data-is-expired="@item.IsExpired.ToString().ToLower()">
                                    <td class="px-4">
                                        <div class="fw-semibold">@item.ProductName</div>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">@item.ProductType</span>
                                    </td>
                                    <td>
                                        <span class="fw-semibold">@item.Quantity</span>
                                        <span class="text-muted">units</span>
                                    </td>
                                    <td>
                                        @if (item.UnitPrice > 0)
                                        {
                                            <span class="fw-semibold text-success">₱@item.UnitPrice.ToString("N2")</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted fst-italic">Not set</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge @stockBadgeClass">@item.StockStatus</span>
                                    </td>
                                    <td>
                                        @if (item.Expiry.HasValue)
                                        {
                                            <span class="badge @expiryBadgeClass">
                                                @item.Expiry.Value.ToString("MMM dd, yyyy")
                                                @if (item.IsExpired)
                                                {
                                                    <text> (Expired)</text>
                                                }
                                                else if (item.IsExpiringSoon)
                                                {
                                                    <text> (@item.DaysUntilExpiry days)</text>
                                                }
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">â€”</span>
                                        }
                                    </td>
                                    <td class="text-end px-4">
                                        <button class="btn btn-sm btn-outline-primary me-1" onclick="event.stopPropagation(); openSetPriceModal(@item.ProductID, '@item.ProductName')" title="Set Unit Price">
                                            <i class="bi bi-tag"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger" onclick="event.stopPropagation(); deleteInventory(@item.InventoryID, '@item.ProductName')">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Add Inventory Modal -->
<div class="modal fade" id="addInventoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-plus-circle text-primary me-2"></i>Add Stock
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="addInventoryForm">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Product <span class="text-danger">*</span></label>
                        <select class="form-select" id="addProductId" required>
                            <option value="">Select product...</option>
                            @foreach (var product in Model.Products)
                            {
                                <option value="@product.Id">@product.Name (@product.Type)</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Quantity <span class="text-danger">*</span></label>
                        <input type="number" class="form-control" id="addQuantity" min="1" value="1" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Expiry Date</label>
                        <input type="date" class="form-control" id="addExpiry">
                        <div class="form-text">Leave blank if product doesn't expire</div>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="addInventory()">
                    <i class="bi bi-check-lg me-1"></i>Add Stock
                </button>
            </div>
        </div>
    </div>
</div>

<!-- View/Edit Inventory Modal -->
<div class="modal fade" id="inventoryDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-box-seam text-primary me-2"></i>Inventory Details
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="editInventoryForm">
                    <input type="hidden" id="editInventoryId">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Product</label>
                        <input type="text" class="form-control" id="editProductName" readonly>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Product Type</label>
                        <input type="text" class="form-control" id="editProductType" readonly>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Quantity <span class="text-danger">*</span></label>
                        <input type="number" class="form-control" id="editQuantity" min="0" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Expiry Date</label>
                        <input type="date" class="form-control" id="editExpiry">
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Last Updated By</label>
                        <input type="text" class="form-control" id="editUserName" readonly>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="updateInventory()">
                    <i class="bi bi-check-lg me-1"></i>Save Changes
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Set Unit Price Modal -->
<div class="modal fade" id="setPriceModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-tag text-primary me-2"></i>Set Unit Price
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="setPriceForm">
                    <input type="hidden" id="priceProductId">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Product</label>
                        <input type="text" class="form-control" id="priceProductName" readonly>
                    </div>

                    <!-- Ingredient Cost Breakdown -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Ingredient Cost Breakdown</label>
                        <div id="ingredientBreakdown" class="border rounded p-2" style="max-height: 180px; overflow-y: auto;">
                            <div class="text-muted text-center py-2">Loading...</div>
                        </div>
                    </div>

                    <!-- Minimum Price Info -->
                    <div class="alert alert-info py-2 mb-3" id="minPriceAlert">
                        <i class="bi bi-info-circle me-1"></i>
                        Minimum price (ingredient cost): <strong id="minPriceDisplay">₱0.00</strong>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Unit Price <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text">₱</span>
                            <input type="number" class="form-control" id="priceUnitPrice" min="0.01" step="0.01" required
                                   oninput="validatePriceInput()">
                        </div>
                        <div class="form-text" id="priceValidationMsg"></div>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="savePriceBtn" onclick="saveUnitPrice()">
                    <i class="bi bi-check-lg me-1"></i>Save Price
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Filter functionality
        document.getElementById('searchInput').addEventListener('input', debounce(filterTable, 250));
        document.getElementById('typeFilter').addEventListener('change', filterTable);
        document.getElementById('stockFilter').addEventListener('change', filterTable);

        function filterTable() {
            const searchTerm = document.getElementById('searchInput').value.toLowerCase();
            const typeFilter = document.getElementById('typeFilter').value.toLowerCase();
            const stockFilter = document.getElementById('stockFilter').value.toLowerCase();

            document.querySelectorAll('.inventory-row').forEach(row => {
                const productName = row.querySelector('td:first-child').textContent.toLowerCase();
                const productType = row.dataset.productType.toLowerCase();
                const stockStatus = row.dataset.stockStatus;
                const isExpiring = row.dataset.isExpiring === 'true';
                const isExpired = row.dataset.isExpired === 'true';

                let show = true;

                if (searchTerm && !productName.includes(searchTerm)) show = false;
                if (typeFilter && productType !== typeFilter) show = false;
                if (stockFilter) {
                    if (stockFilter === 'expiring' && !isExpiring) show = false;
                    if (stockFilter === 'expired' && !isExpired) show = false;
                    if (stockFilter === 'instock' && stockStatus !== 'instock') show = false;
                    if (stockFilter === 'lowstock' && stockStatus !== 'lowstock') show = false;
                    if (stockFilter === 'outofstock' && stockStatus !== 'outofstock') show = false;
                }

                row.style.display = show ? '' : 'none';
            });
        }

        function clearFilters() {
            document.getElementById('searchInput').value = '';
            document.getElementById('typeFilter').value = '';
            document.getElementById('stockFilter').value = '';
            filterTable();
        }

        // Add inventory
        async function addInventory() {
            const form = document.getElementById('addInventoryForm');
            if (!form.checkValidity()) {
                form.classList.add('was-validated');
                return;
            }

            const data = {
                productID: parseInt(document.getElementById('addProductId').value),
                quantity: parseInt(document.getElementById('addQuantity').value),
                expiry: document.getElementById('addExpiry').value || null
            };

            try {
                const response = await fetch('@Url.Action("Create", "Inventory")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify(data)
                });

                if (response.ok) {
                    const result = await response.json();
                    showToast('success', result.message);
                    setTimeout(() => window.location.reload(), 300);
                } else {
                    const error = await response.text();
                    showToast('error', error || 'Failed to add inventory');
                }
            } catch (error) {
                showToast('error', 'An error occurred');
                console.error(error);
            }
        }

        // View inventory detail
        async function viewInventoryDetail(id) {
            try {
                const response = await fetch(`@Url.Action("GetDetail", "Inventory")/${id}`);
                if (response.ok) {
                    const data = await response.json();
                    document.getElementById('editInventoryId').value = data.inventoryID;
                    document.getElementById('editProductName').value = data.productName;
                    document.getElementById('editProductType').value = data.productType;
                    document.getElementById('editQuantity').value = data.quantity;
                    document.getElementById('editExpiry').value = data.expiry ? data.expiry.split('T')[0] : '';
                    document.getElementById('editUserName').value = data.userName;
                    new bootstrap.Modal(document.getElementById('inventoryDetailModal')).show();
                }
            } catch (error) {
                showToast('error', 'Failed to load inventory details');
                console.error(error);
            }
        }

        // Update inventory
        async function updateInventory() {
            const form = document.getElementById('editInventoryForm');
            if (!form.checkValidity()) {
                form.classList.add('was-validated');
                return;
            }

            const data = {
                inventoryID: parseInt(document.getElementById('editInventoryId').value),
                quantity: parseInt(document.getElementById('editQuantity').value),
                expiry: document.getElementById('editExpiry').value || null
            };

            try {
                const response = await fetch('@Url.Action("Update", "Inventory")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify(data)
                });

                if (response.ok) {
                    const result = await response.json();
                    showToast('success', result.message);
                    setTimeout(() => window.location.reload(), 300);
                } else {
                    showToast('error', 'Failed to update inventory');
                }
            } catch (error) {
                showToast('error', 'An error occurred');
                console.error(error);
            }
        }

        // =====================================================
        // SET UNIT PRICE
        // =====================================================
        let currentMinPrice = 0;

        async function openSetPriceModal(productId, productName) {
            document.getElementById('priceProductId').value = productId;
            document.getElementById('priceProductName').value = productName;
            document.getElementById('priceUnitPrice').value = '';
            document.getElementById('priceValidationMsg').textContent = '';
            document.getElementById('savePriceBtn').disabled = false;
            document.getElementById('ingredientBreakdown').innerHTML = '<div class="text-muted text-center py-2">Loading...</div>';
            currentMinPrice = 0;

            new bootstrap.Modal(document.getElementById('setPriceModal')).show();

            // Fetch price info
            try {
                const response = await fetch(`@Url.Action("GetProductPriceInfo", "Inventory")/${productId}`);
                if (response.ok) {
                    const data = await response.json();
                    currentMinPrice = data.minUnitPrice;
                    document.getElementById('minPriceDisplay').textContent = '₱' + data.minUnitPrice.toFixed(2);
                    document.getElementById('priceUnitPrice').value = data.currentUnitPrice.toFixed(2);
                    document.getElementById('priceUnitPrice').min = data.minUnitPrice.toFixed(2);

                    // Build ingredient breakdown
                    if (data.ingredients && data.ingredients.length > 0) {
                        let html = '<table class="table table-sm table-borderless mb-0" style="font-size: 0.85rem;">';
                        html += '<thead><tr><th>Ingredient</th><th class="text-end">Qty</th><th class="text-end">Cost/Unit</th><th class="text-end">Total</th></tr></thead><tbody>';
                        data.ingredients.forEach(ing => {
                            html += `<tr>
                                <td>${ing.materialName}</td>
                                <td class="text-end">${ing.quantity} ${ing.unit}</td>
                                <td class="text-end">₱${ing.unitCost.toFixed(2)}</td>
                                <td class="text-end fw-semibold">₱${ing.totalCost.toFixed(2)}</td>
                            </tr>`;
                        });
                        html += `<tr class="border-top"><td colspan="3" class="fw-bold">Total Ingredient Cost</td><td class="text-end fw-bold text-primary">₱${data.minUnitPrice.toFixed(2)}</td></tr>`;
                        html += '</tbody></table>';
                        document.getElementById('ingredientBreakdown').innerHTML = html;
                    } else {
                        document.getElementById('ingredientBreakdown').innerHTML = '<div class="text-muted text-center py-2"><i class="bi bi-info-circle me-1"></i>No ingredients/formulation found for this product.</div>';
                    }

                    validatePriceInput();
                }
            } catch (error) {
                console.error('Failed to load price info:', error);
                document.getElementById('ingredientBreakdown').innerHTML = '<div class="text-danger text-center py-2">Failed to load ingredient data.</div>';
            }
        }

        function validatePriceInput() {
            const price = parseFloat(document.getElementById('priceUnitPrice').value) || 0;
            const msgEl = document.getElementById('priceValidationMsg');
            const btn = document.getElementById('savePriceBtn');

            if (currentMinPrice > 0 && price < currentMinPrice) {
                msgEl.textContent = `Price cannot be lower than ingredient cost (₱${currentMinPrice.toFixed(2)})`;
                msgEl.className = 'form-text text-danger';
                btn.disabled = true;
            } else if (price <= 0) {
                msgEl.textContent = 'Enter a valid price';
                msgEl.className = 'form-text text-danger';
                btn.disabled = true;
            } else {
                const margin = currentMinPrice > 0 ? ((price - currentMinPrice) / currentMinPrice * 100).toFixed(1) : 0;
                msgEl.textContent = currentMinPrice > 0 ? `Margin: ${margin}% above ingredient cost` : 'No ingredient cost data — any price accepted';
                msgEl.className = 'form-text text-success';
                btn.disabled = false;
            }
        }

        async function saveUnitPrice() {
            const form = document.getElementById('setPriceForm');
            if (!form.checkValidity()) {
                form.classList.add('was-validated');
                return;
            }

            const price = parseFloat(document.getElementById('priceUnitPrice').value);
            if (currentMinPrice > 0 && price < currentMinPrice) {
                showToast('error', `Price cannot be lower than ingredient cost (₱${currentMinPrice.toFixed(2)})`);
                return;
            }

            const data = {
                productID: parseInt(document.getElementById('priceProductId').value),
                unitPrice: price
            };

            try {
                const response = await fetch('@Url.Action("SetUnitPrice", "Inventory")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify(data)
                });

                if (response.ok) {
                    const result = await response.json();
                    showToast('success', result.message);
                    bootstrap.Modal.getInstance(document.getElementById('setPriceModal'))?.hide();
                    setTimeout(() => window.location.reload(), 300);
                } else {
                    const errorData = await response.json().catch(() => null);
                    showToast('error', errorData?.error || 'Failed to set unit price');
                }
            } catch (error) {
                showToast('error', 'An error occurred');
                console.error(error);
            }
        }

        // Delete inventory
        async function deleteInventory(id, productName) {
            showConfirmModal(`Are you sure you want to delete inventory for "${productName}"?`, async () => {
                try {
                    const response = await fetch(`@Url.Action("Delete", "Inventory")/${id}`, {
                        method: 'POST',
                        headers: {
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                        }
                    });

                    if (response.ok) {
                        const result = await response.json();
                        showToast('success', result.message);
                        setTimeout(() => window.location.reload(), 300);
                    } else {
                        showToast('error', 'Failed to delete inventory');
                    }
                } catch (error) {
                    showToast('error', 'An error occurred');
                    console.error(error);
                }
            });
        }

        // Row click to view inventory detail
        document.querySelectorAll('.inventory-row').forEach(row => {
            row.style.cursor = 'pointer';
            row.addEventListener('click', function () {
                const inventoryId = this.dataset.inventoryId;
                viewInventoryDetail(inventoryId);
            });
        });

        function showToast(type, message) {
            showGlobalToast(type, message);
        }
    </script>
}
