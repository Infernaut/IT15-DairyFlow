@model IT15_DairyFlow.Models.QM.NonConformancePageViewModel

@{
    ViewData["Title"] = "Non-conformance Reports";
}

<div class="container-fluid p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1 fw-bold">Non-conformance Reports</h2>
            <p class="text-muted mb-0">Document and track quality non-conformance issues and corrective actions.</p>
        </div>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createReportModal">
            <i class="bi bi-plus-lg me-1"></i> Create Report
        </button>
    </div>

    <!-- Statistics Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-2">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="bg-danger bg-opacity-10 text-danger rounded p-2 me-3">
                            <i class="bi bi-exclamation-triangle fs-4"></i>
                        </div>
                        <div>
                            <h6 class="text-muted mb-0 small">Open</h6>
                            <h4 class="mb-0 fw-bold">@Model.Summary.TotalOpen</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="bg-warning bg-opacity-10 text-warning rounded p-2 me-3">
                            <i class="bi bi-clock-history fs-4"></i>
                        </div>
                        <div>
                            <h6 class="text-muted mb-0 small">In Progress</h6>
                            <h4 class="mb-0 fw-bold">@Model.Summary.TotalInProgress</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="bg-info bg-opacity-10 text-info rounded p-2 me-3">
                            <i class="bi bi-hourglass-split fs-4"></i>
                        </div>
                        <div>
                            <h6 class="text-muted mb-0 small">Pending</h6>
                            <h4 class="mb-0 fw-bold">@Model.Summary.PendingVerification</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="bg-success bg-opacity-10 text-success rounded p-2 me-3">
                            <i class="bi bi-check-circle fs-4"></i>
                        </div>
                        <div>
                            <h6 class="text-muted mb-0 small">Closed</h6>
                            <h4 class="mb-0 fw-bold">@Model.Summary.ClosedThisMonth</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="bg-secondary bg-opacity-10 text-secondary rounded p-2 me-3">
                            <i class="bi bi-alarm fs-4"></i>
                        </div>
                        <div>
                            <h6 class="text-muted mb-0 small">Overdue</h6>
                            <h4 class="mb-0 fw-bold text-danger">@Model.Summary.OverdueCount</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="bg-primary bg-opacity-10 text-primary rounded p-2 me-3">
                            <i class="bi bi-cash-stack fs-4"></i>
                        </div>
                        <div>
                            <h6 class="text-muted mb-0 small">Cost Impact</h6>
                            <h5 class="mb-0 fw-bold">₱@Model.Summary.TotalCostImpact.ToString("N0")</h5>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filters -->
    <div class="card shadow-sm mb-4 border-0">
        <div class="card-body py-3">
            <div class="row g-3 align-items-center">
                <div class="col-md-4">
                    <div class="input-group">
                        <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                        <input type="text" class="form-control" id="searchInput" placeholder="Search NCR..." onkeyup="filterTable()">
                    </div>
                </div>
                <div class="col-md-2">
                    <select class="form-select" id="statusFilter" onchange="filterTable()">
                        <option value="">All Statuses</option>
                        <option value="Open">Open</option>
                        <option value="InProgress">In Progress</option>
                        <option value="PendingVerification">Pending Verification</option>
                        <option value="Closed">Closed</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <select class="form-select" id="severityFilter" onchange="filterTable()">
                        <option value="">All Severities</option>
                        <option value="Critical">Critical</option>
                        <option value="Major">Major</option>
                        <option value="Minor">Minor</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <select class="form-select" id="categoryFilter" onchange="filterTable()">
                        <option value="">All Categories</option>
                        <option value="Material">Material</option>
                        <option value="Process">Process</option>
                        <option value="Equipment">Equipment</option>
                        <option value="Product">Product</option>
                        <option value="Packaging">Packaging</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button class="btn btn-outline-secondary w-100" onclick="clearFilters()">
                        <i class="bi bi-x-circle me-1"></i> Clear
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- NCR Table -->
    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="ncrTable">
                <thead class="table-light">
                    <tr>
                        <th class="px-4">NCR #</th>
                        <th>Title</th>
                        <th>Category</th>
                        <th>Severity</th>
                        <th>Status</th>
                        <th>Reported</th>
                        <th>Due Date</th>
                        <th>Assigned</th>
                        <th class="text-end px-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.NonConformances.Any())
                    {
                        @foreach (var ncr in Model.NonConformances)
                        {
                            var severityClass = ncr.Severity switch
                            {
                                "Critical" => "bg-danger",
                                "Major" => "bg-warning text-dark",
                                _ => "bg-info"
                            };
                            var statusClass = ncr.Status switch
                            {
                                "Open" => "bg-danger",
                                "InProgress" => "bg-warning text-dark",
                                "PendingVerification" => "bg-info",
                                "Closed" => "bg-success",
                                _ => "bg-secondary"
                            };
                            var isOverdue = ncr.DueDate.HasValue && ncr.DueDate.Value.Date < DateTime.UtcNow.Date && ncr.Status != "Closed";
                            <tr data-id="@ncr.NonConformanceID" data-status="@ncr.Status" data-severity="@ncr.Severity" data-category="@ncr.Category"
                                style="cursor: pointer;" onclick="viewNCRDetail(@ncr.NonConformanceID)">
                                <td class="px-4 fw-semibold">@ncr.NCRNumber</td>
                                <td>
                                    @ncr.Title
                                    @if (!string.IsNullOrEmpty(ncr.BatchCode))
                                    {
                                        <br /><small class="text-muted">Batch: @ncr.BatchCode</small>
                                    }
                                </td>
                                <td><span class="badge bg-secondary">@ncr.Category</span></td>
                                <td><span class="badge @severityClass">@ncr.Severity</span></td>
                                <td><span class="badge @statusClass">@ncr.Status</span></td>
                                <td>@ncr.ReportedDate.ToString("MMM dd, yyyy")</td>
                                <td class="@(isOverdue ? "text-danger fw-bold" : "")">
                                    @(ncr.DueDate?.ToString("MMM dd, yyyy") ?? "-")
                                    @if (isOverdue)
                                    {
                                        <i class="bi bi-exclamation-circle ms-1"></i>
                                    }
                                </td>
                                <td>@(ncr.AssignedTo ?? "-")</td>
                                <td class="text-end px-4">
                                    @if (ncr.Status != "Closed")
                                    {
                                        <button class="btn btn-sm btn-outline-secondary me-1" onclick="event.stopPropagation(); editNCR(@ncr.NonConformanceID)" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-success" onclick="event.stopPropagation(); closeNCR(@ncr.NonConformanceID)" title="Close">
                                            <i class="bi bi-check-lg"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox display-4"></i>
                                <p class="mt-2">No non-conformance reports found.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Create NCR Modal -->
<div class="modal fade" id="createReportModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form id="createNCRForm">
                <div class="modal-header border-0">
                    <h5 class="modal-title fw-bold"><i class="bi bi-plus-circle text-primary me-2"></i>Create Non-conformance Report</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Category <span class="text-danger">*</span></label>
                            <select class="form-select" id="createCategory" required>
                                <option value="">Select category...</option>
                                <option value="Material">Material</option>
                                <option value="Process">Process</option>
                                <option value="Equipment">Equipment</option>
                                <option value="Product">Product</option>
                                <option value="Packaging">Packaging</option>
                                <option value="Labeling">Labeling</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Severity <span class="text-danger">*</span></label>
                            <select class="form-select" id="createSeverity" required>
                                <option value="">Select severity...</option>
                                <option value="Critical">Critical</option>
                                <option value="Major">Major</option>
                                <option value="Minor">Minor</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Title <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="createTitle" maxlength="200" required placeholder="Brief description of the issue">
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Description</label>
                            <textarea class="form-control" id="createDescription" rows="3" placeholder="Detailed description of the non-conformance..."></textarea>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Production Batch</label>
                            <select class="form-select" id="createBatchId">
                                <option value="">Select batch (optional)...</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Affected Quantity</label>
                            <input type="number" class="form-control" id="createAffectedQty" min="0" placeholder="0">
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Immediate Action Taken</label>
                            <textarea class="form-control" id="createImmediateAction" rows="2" placeholder="Describe any immediate actions taken..."></textarea>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Assign To</label>
                            <select class="form-select" id="createAssignedTo">
                                <option value="">Select assignee...</option>
                                @foreach (var user in Model.Users)
                                {
                                    <option value="@user.Id">@user.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Due Date</label>
                            <input type="date" class="form-control" id="createDueDate">
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Create Report</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- View/Edit NCR Modal -->
<div class="modal fade" id="ncrDetailModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form id="editNCRForm">
                <div class="modal-header border-0">
                    <h5 class="modal-title fw-bold"><i class="bi bi-file-earmark-text text-primary me-2"></i>NCR Details - <span id="detailNCRNumber"></span></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="editNCRId">
                    
                    <!-- Summary Row -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-3">
                            <label class="form-label text-muted small">Category</label>
                            <div class="fw-bold" id="detailCategory"></div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label text-muted small">Severity</label>
                            <div id="detailSeverityBadge"></div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label text-muted small">Status</label>
                            <select class="form-select form-select-sm" id="editStatus">
                                <option value="Open">Open</option>
                                <option value="InProgress">In Progress</option>
                                <option value="PendingVerification">Pending Verification</option>
                                <option value="Closed">Closed</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label text-muted small">Reported</label>
                            <div id="detailReportedDate"></div>
                        </div>
                    </div>

                    <hr />

                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label fw-semibold">Title</label>
                            <div class="form-control-plaintext border-bottom" id="detailTitle"></div>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Description</label>
                            <div class="form-control-plaintext text-muted" id="detailDescription"></div>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Root Cause Analysis</label>
                            <textarea class="form-control" id="editRootCause" rows="2" placeholder="Enter root cause analysis..."></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Corrective Action</label>
                            <textarea class="form-control" id="editCorrectiveAction" rows="2" placeholder="Enter corrective actions..."></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Preventive Action</label>
                            <textarea class="form-control" id="editPreventiveAction" rows="2" placeholder="Enter preventive measures..."></textarea>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Disposition</label>
                            <select class="form-select" id="editDisposition">
                                <option value="">Select...</option>
                                <option value="UseAsIs">Use As Is</option>
                                <option value="Rework">Rework</option>
                                <option value="Scrap">Scrap</option>
                                <option value="Return">Return</option>
                                <option value="Hold">Hold</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Cost Impact (₱)</label>
                            <input type="number" class="form-control" id="editCostImpact" step="0.01" min="0">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Due Date</label>
                            <input type="date" class="form-control" id="editDueDate">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Assigned To</label>
                            <select class="form-select" id="editAssignedTo">
                                <option value="">Unassigned</option>
                                @foreach (var user in Model.Users)
                                {
                                    <option value="@user.Id">@user.Name</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const antiForgeryToken = $('input[name="__RequestVerificationToken"]').val();

        // Load batches for create form
        $(document).ready(function() {
            $.get('@Url.Action("GetBatches", "QM")', function(data) {
                data.forEach(function(batch) {
                    $('#createBatchId').append(`<option value="${batch.id}">${batch.code}</option>`);
                });
            });
        });

        // Filter table
        function filterTable() {
            const search = $('#searchInput').val().toLowerCase();
            const status = $('#statusFilter').val();
            const severity = $('#severityFilter').val();
            const category = $('#categoryFilter').val();

            $('#ncrTable tbody tr').each(function() {
                const row = $(this);
                const rowStatus = row.data('status');
                const rowSeverity = row.data('severity');
                const rowCategory = row.data('category');
                const text = row.text().toLowerCase();

                const matchSearch = !search || text.includes(search);
                const matchStatus = !status || rowStatus === status;
                const matchSeverity = !severity || rowSeverity === severity;
                const matchCategory = !category || rowCategory === category;

                row.toggle(matchSearch && matchStatus && matchSeverity && matchCategory);
            });
        }

        function clearFilters() {
            $('#searchInput').val('');
            $('#statusFilter').val('');
            $('#severityFilter').val('');
            $('#categoryFilter').val('');
            filterTable();
        }

        // Create NCR
        $('#createNCRForm').on('submit', function(e) {
            e.preventDefault();

            const data = {
                Category: $('#createCategory').val(),
                Severity: $('#createSeverity').val(),
                Title: $('#createTitle').val(),
                Description: $('#createDescription').val(),
                ProductionBatchID: $('#createBatchId').val() ? parseInt($('#createBatchId').val()) : null,
                AffectedQuantity: $('#createAffectedQty').val() ? parseInt($('#createAffectedQty').val()) : null,
                ImmediateAction: $('#createImmediateAction').val(),
                AssignedToUserId: $('#createAssignedTo').val() || null,
                DueDate: $('#createDueDate').val() || null
            };

            $.ajax({
                url: '@Url.Action("CreateNonConformance", "QM")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(data),
                headers: { 'RequestVerificationToken': antiForgeryToken },
                success: function(response) {
                    if (response.success) {
                        showGlobalToast('success', 'NCR created: ' + response.ncrNumber);
                        location.reload();
                    }
                },
                error: function(xhr) {
                    showGlobalToast('error', 'Error creating NCR');
                }
            });
        });

        // View NCR Detail
        function viewNCRDetail(id) {
            $.get('@Url.Action("GetNonConformanceDetail", "QM")/' + id, function(data) {
                $('#editNCRId').val(data.nonConformanceID);
                $('#detailNCRNumber').text(data.ncrNumber);
                $('#detailCategory').text(data.category);
                
                const severityClass = data.severity === 'Critical' ? 'bg-danger' : data.severity === 'Major' ? 'bg-warning text-dark' : 'bg-info';
                $('#detailSeverityBadge').html(`<span class="badge ${severityClass}">${data.severity}</span>`);
                
                $('#editStatus').val(data.status);
                $('#detailReportedDate').text(new Date(data.reportedDate).toLocaleDateString());
                $('#detailTitle').text(data.title);
                $('#detailDescription').text(data.description || 'No description provided');
                $('#editRootCause').val(data.rootCause || '');
                $('#editCorrectiveAction').val(data.correctiveAction || '');
                $('#editPreventiveAction').val(data.preventiveAction || '');
                $('#editDisposition').val(data.disposition || '');
                $('#editCostImpact').val(data.costImpact || '');
                $('#editDueDate').val(data.dueDate ? data.dueDate.split('T')[0] : '');
                $('#editAssignedTo').val(data.assignedToId || '');

                new bootstrap.Modal($('#ncrDetailModal')).show();
            });
        }

        function editNCR(id) {
            viewNCRDetail(id);
        }

        // Update NCR
        $('#editNCRForm').on('submit', function(e) {
            e.preventDefault();

            const data = {
                NonConformanceID: parseInt($('#editNCRId').val()),
                RootCause: $('#editRootCause').val() || null,
                CorrectiveAction: $('#editCorrectiveAction').val() || null,
                PreventiveAction: $('#editPreventiveAction').val() || null,
                Disposition: $('#editDisposition').val() || null,
                CostImpact: $('#editCostImpact').val() ? parseFloat($('#editCostImpact').val()) : null,
                DueDate: $('#editDueDate').val() || null,
                AssignedToUserId: $('#editAssignedTo').val() || null,
                Status: $('#editStatus').val()
            };

            $.ajax({
                url: '@Url.Action("UpdateNonConformance", "QM")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(data),
                headers: { 'RequestVerificationToken': antiForgeryToken },
                success: function(response) {
                    if (response.success) {
                        location.reload();
                    }
                },
                error: function(xhr) {
                    showGlobalToast('error', 'Error updating NCR');
                }
            });
        });

        // Close NCR
        function closeNCR(id) {
            showConfirmModal('Close this non-conformance report?', () => {
                $.ajax({
                    url: '@Url.Action("CloseNonConformance", "QM")/' + id,
                    type: 'POST',
                    headers: { 'RequestVerificationToken': antiForgeryToken },
                    success: function(response) {
                        if (response.success) {
                            location.reload();
                        }
                    },
                    error: function(xhr) {
                        showGlobalToast('error', 'Error closing NCR');
                    }
                });
            });
        }
    </script>
}
