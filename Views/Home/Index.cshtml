@{
    ViewData["Title"] = "DairyFlow ERP | Integrated Dairy Manufacturing System";
}

<style>
    /* ── Reset for landing page ───────────────────────────────── */
    :root {
        --df-primary: #0d6efd;
        --df-primary-dark: #0b5ed7;
        --df-accent: #20c997;
        --df-accent-dark: #0ca678;
        --df-navy: #0f172a;
        --df-slate: #334155;
        --df-muted: #64748b;
        --df-light: #f8fafc;
        --df-border: #e2e8f0;
        --df-card: #ffffff;
        --df-radius: 16px;
        --df-shadow: 0 1px 3px rgba(0,0,0,.06), 0 4px 12px rgba(0,0,0,.04);
        --df-shadow-lg: 0 4px 24px rgba(0,0,0,.08);
    }

    body { background: var(--df-light) !important; }

    /* ── Hero ─────────────────────────────────────────────────── */
    .df-hero {
        position: relative;
        overflow: hidden;
        background: linear-gradient(160deg, #0f172a 0%, #1e293b 40%, #0f172a 100%);
        padding: 6rem 0 5rem;
    }

    .df-hero::before {
        content: '';
        position: absolute; inset: 0;
        background:
            radial-gradient(ellipse 80% 60% at 70% 30%, rgba(13,110,253,.18) 0%, transparent 60%),
            radial-gradient(ellipse 50% 50% at 20% 80%, rgba(32,201,151,.10) 0%, transparent 50%);
        pointer-events: none;
    }

    .df-hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: rgba(255,255,255,.08);
        border: 1px solid rgba(255,255,255,.12);
        backdrop-filter: blur(12px);
        padding: 6px 16px;
        border-radius: 100px;
        font-size: .8rem;
        font-weight: 600;
        color: rgba(255,255,255,.85);
        letter-spacing: .02em;
        margin-bottom: 1.5rem;
    }

    .df-hero-badge .dot {
        width: 7px; height: 7px;
        border-radius: 50%;
        background: var(--df-accent);
        animation: pulse-dot 2s ease-in-out infinite;
    }

    @@keyframes pulse-dot {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: .5; transform: scale(1.4); }
    }

    .df-hero h1 {
        font-size: clamp(2.2rem, 5vw, 3.5rem);
        font-weight: 800;
        color: #fff;
        line-height: 1.15;
        letter-spacing: -0.03em;
        margin-bottom: 1.25rem;
    }

    .df-hero h1 .gradient-text {
        background: linear-gradient(135deg, var(--df-primary), var(--df-accent));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .df-hero p.lead {
        color: rgba(255,255,255,.6);
        font-size: clamp(1rem, 2vw, 1.15rem);
        line-height: 1.7;
        max-width: 540px;
    }

    .df-hero-cta { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 2rem; }

    .btn-df-primary {
        background: linear-gradient(135deg, var(--df-primary), var(--df-primary-dark));
        color: #fff; border: none;
        padding: 12px 28px; border-radius: 12px;
        font-weight: 600; font-size: .95rem;
        transition: all .25s ease;
        box-shadow: 0 4px 14px rgba(13,110,253,.3);
    }
    .btn-df-primary:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(13,110,253,.4); color: #fff; }

    .btn-df-accent {
        background: linear-gradient(135deg, var(--df-accent), var(--df-accent-dark));
        color: #fff; border: none;
        padding: 12px 28px; border-radius: 12px;
        font-weight: 600; font-size: .95rem;
        transition: all .25s ease;
        box-shadow: 0 4px 14px rgba(32,201,151,.3);
    }
    .btn-df-accent:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(32,201,151,.4); color: #fff; }

    .btn-df-ghost {
        background: transparent; border: 1px solid rgba(255,255,255,.2);
        color: rgba(255,255,255,.85);
        padding: 12px 28px; border-radius: 12px;
        font-weight: 600; font-size: .95rem;
        transition: all .25s ease;
    }
    .btn-df-ghost:hover { background: rgba(255,255,255,.08); color: #fff; border-color: rgba(255,255,255,.3); }

    /* Hero visual */
    .df-hero-visual {
        position: relative;
        display: flex; align-items: center; justify-content: center;
    }

    .df-hero-glow {
        width: 280px; height: 280px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(13,110,253,.15), transparent 70%);
        position: absolute;
        animation: hero-float 6s ease-in-out infinite;
    }

    @@keyframes hero-float {
        0%, 100% { transform: translateY(0) scale(1); }
        50% { transform: translateY(-12px) scale(1.05); }
    }

    .df-hero-icon-grid {
        display: grid;
        grid-template-columns: repeat(3, 64px);
        gap: 14px;
        position: relative;
        z-index: 1;
    }

    .df-hero-icon-item {
        width: 64px; height: 64px;
        border-radius: 16px;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.5rem; color: #fff;
        background: rgba(255,255,255,.06);
        border: 1px solid rgba(255,255,255,.08);
        backdrop-filter: blur(8px);
        transition: all .3s ease;
    }
    .df-hero-icon-item:hover { background: rgba(255,255,255,.12); transform: translateY(-3px); }

    /* ── Stats ribbon ─────────────────────────────────────────── */
    .df-stats {
        margin-top: -2.5rem;
        position: relative;
        z-index: 2;
    }

    .df-stats-card {
        background: var(--df-card);
        border-radius: var(--df-radius);
        padding: 1.5rem 1.75rem;
        border: 1px solid var(--df-border);
        box-shadow: var(--df-shadow-lg);
        display: flex;
        align-items: center;
        gap: 1rem;
        transition: transform .2s ease;
    }
    .df-stats-card:hover { transform: translateY(-3px); }

    .df-stats-icon {
        width: 48px; height: 48px;
        border-radius: 12px;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.3rem; color: #fff; flex-shrink: 0;
    }

    .df-stats-text h6 { font-size: .78rem; color: var(--df-muted); font-weight: 600; text-transform: uppercase; letter-spacing: .04em; margin-bottom: 2px; }
    .df-stats-text p { font-size: .95rem; color: var(--df-navy); font-weight: 700; margin: 0; }

    /* ── Section commons ──────────────────────────────────────── */
    .df-section { padding: 5rem 0; }
    .df-section-label {
        display: inline-block;
        font-size: .75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .08em;
        color: var(--df-primary);
        background: rgba(13,110,253,.08);
        padding: 5px 14px;
        border-radius: 100px;
        margin-bottom: 1rem;
    }
    .df-section-title {
        font-size: clamp(1.6rem, 3.5vw, 2.25rem);
        font-weight: 800;
        color: var(--df-navy);
        letter-spacing: -0.02em;
        line-height: 1.25;
    }
    .df-section-sub {
        color: var(--df-muted);
        font-size: 1.05rem;
        line-height: 1.7;
        max-width: 560px;
    }

    /* ── Module cards ─────────────────────────────────────────── */
    .df-module {
        background: var(--df-card);
        border: 1px solid var(--df-border);
        border-radius: var(--df-radius);
        padding: 2rem;
        transition: all .3s ease;
        height: 100%;
        position: relative;
        overflow: hidden;
    }
    .df-module:hover {
        transform: translateY(-4px);
        box-shadow: var(--df-shadow-lg);
        border-color: rgba(13,110,253,.2);
    }

    .df-module-icon {
        width: 52px; height: 52px;
        border-radius: 14px;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.5rem; color: #fff;
        margin-bottom: 1.25rem;
    }

    .df-module h5 { font-weight: 700; color: var(--df-navy); font-size: 1.1rem; margin-bottom: .5rem; }
    .df-module p { color: var(--df-muted); font-size: .9rem; line-height: 1.65; margin-bottom: 1rem; }

    .df-module-features {
        list-style: none; padding: 0; margin: 0;
    }
    .df-module-features li {
        font-size: .82rem; color: var(--df-slate);
        padding: 3px 0;
        display: flex; align-items: center; gap: 6px;
    }
    .df-module-features li i { color: var(--df-accent); font-size: .75rem; }

    .df-module-watermark {
        position: absolute; bottom: -14px; right: -14px;
        font-size: 6.5rem; opacity: .04; pointer-events: none; color: var(--df-navy);
    }

    /* ── Why section ──────────────────────────────────────────── */
    .df-why-item {
        display: flex;
        gap: 1rem;
        padding: 1.25rem 0;
    }
    .df-why-bullet {
        width: 40px; height: 40px; flex-shrink: 0;
        border-radius: 12px;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.1rem; color: #fff;
        background: linear-gradient(135deg, var(--df-primary), var(--df-primary-dark));
    }
    .df-why-item h6 { font-weight: 700; color: var(--df-navy); margin-bottom: 2px; font-size: .95rem; }
    .df-why-item p { color: var(--df-muted); font-size: .88rem; margin: 0; line-height: 1.6; }

    /* ── CTA banner ───────────────────────────────────────────── */
    .df-cta-banner {
        background: linear-gradient(135deg, var(--df-navy), #1e293b);
        border-radius: 24px;
        padding: 3.5rem;
        position: relative;
        overflow: hidden;
    }
    .df-cta-banner::before {
        content: '';
        position: absolute; inset: 0;
        background:
            radial-gradient(ellipse 50% 60% at 80% 50%, rgba(13,110,253,.15), transparent),
            radial-gradient(ellipse 40% 50% at 10% 50%, rgba(32,201,151,.10), transparent);
        pointer-events: none;
    }
    .df-cta-banner h3 { color: #fff; font-weight: 800; font-size: 1.8rem; letter-spacing: -0.02em; }
    .df-cta-banner p { color: rgba(255,255,255,.6); font-size: 1rem; }

    /* ── Footer ───────────────────────────────────────────────── */
    .df-footer {
        background: var(--df-navy);
        padding: 2.5rem 0;
        margin-top: 0;
    }
    .df-footer p { color: rgba(255,255,255,.4); font-size: .85rem; margin: 0; }
    .df-footer a { color: rgba(255,255,255,.6); text-decoration: none; transition: color .2s; }
    .df-footer a:hover { color: var(--df-accent); }

    /* ── Responsive ───────────────────────────────────────────── */
    @@media (max-width: 767.98px) {
        .df-hero { padding: 4rem 0 3.5rem; text-align: center; }
        .df-hero p.lead { margin-left: auto; margin-right: auto; }
        .df-hero-cta { justify-content: center; }
        .df-hero-visual { margin-top: 2.5rem; }
        .df-hero-icon-grid { grid-template-columns: repeat(3, 56px); gap: 10px; }
        .df-hero-icon-item { width: 56px; height: 56px; font-size: 1.3rem; }
        .df-stats-card { padding: 1.15rem 1.25rem; }
        .df-section { padding: 3rem 0; }
        .df-cta-banner { padding: 2.5rem 1.5rem; text-align: center; }
        .df-cta-banner .d-flex { justify-content: center !important; }
        .df-section-sub { margin-left: auto; margin-right: auto; }
    }
</style>

<!-- ═══════════════ HERO ═══════════════ -->
<section class="df-hero">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-7">
                <div class="df-hero-badge">
                    <span class="dot"></span>
                    Dairy Manufacturing ERP Platform
                </div>
                <h1>
                    Streamline Your<br>
                    Dairy Operations with<br>
                    <span class="gradient-text">DairyFlow</span>
                </h1>
                <p class="lead">
                    A unified ERP platform purpose-built for dairy manufacturers — integrating
                    product lifecycle management, quality assurance, production scheduling, and
                    financial control with full batch traceability.
                </p>
                <div class="df-hero-cta">
                    <a asp-controller="Subscription" asp-action="Register" class="btn btn-df-accent">
                        <i class="bi bi-rocket-takeoff me-2"></i>Get Started Free
                    </a>
                    <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-df-ghost">
                        <i class="bi bi-box-arrow-in-right me-2"></i>Sign In
                    </a>
                </div>
            </div>
            <div class="col-lg-5 df-hero-visual d-none d-lg-flex">
                <div class="df-hero-glow"></div>
                <div class="df-hero-icon-grid">
                    <div class="df-hero-icon-item"><i class="bi bi-droplet-half"></i></div>
                    <div class="df-hero-icon-item"><i class="bi bi-clipboard2-pulse"></i></div>
                    <div class="df-hero-icon-item"><i class="bi bi-calculator"></i></div>
                    <div class="df-hero-icon-item"><i class="bi bi-box-seam"></i></div>
                    <div class="df-hero-icon-item"><i class="bi bi-graph-up-arrow"></i></div>
                    <div class="df-hero-icon-item"><i class="bi bi-shield-check"></i></div>
                    <div class="df-hero-icon-item"><i class="bi bi-gear-wide-connected"></i></div>
                    <div class="df-hero-icon-item"><i class="bi bi-people"></i></div>
                    <div class="df-hero-icon-item"><i class="bi bi-bar-chart-line"></i></div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ═══════════════ STATS RIBBON ═══════════════ -->
<div class="container df-stats">
    <div class="row g-3">
        <div class="col-md-4">
            <div class="df-stats-card">
                <div class="df-stats-icon" style="background: linear-gradient(135deg,#6366f1,#4f46e5);">
                    <i class="bi bi-boxes"></i>
                </div>
                <div class="df-stats-text">
                    <h6>Production Control</h6>
                    <p>End-to-End Batch Tracking</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="df-stats-card">
                <div class="df-stats-icon" style="background: linear-gradient(135deg,var(--df-accent),var(--df-accent-dark));">
                    <i class="bi bi-patch-check-fill"></i>
                </div>
                <div class="df-stats-text">
                    <h6>Quality Compliance</h6>
                    <p>Automated Inspection Workflows</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="df-stats-card">
                <div class="df-stats-icon" style="background: linear-gradient(135deg,var(--df-primary),var(--df-primary-dark));">
                    <i class="bi bi-pie-chart-fill"></i>
                </div>
                <div class="df-stats-text">
                    <h6>Financial Transparency</h6>
                    <p>Cost &amp; Yield Monitoring</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ═══════════════ MODULES ═══════════════ -->
<section class="df-section" id="modules">
    <div class="container">
        <div class="text-center mb-5">
            <span class="df-section-label">Core Modules</span>
            <h2 class="df-section-title">Everything You Need to Run<br>Your Dairy Business</h2>
            <p class="df-section-sub mx-auto mt-2">Six integrated modules designed specifically for dairy manufacturing workflows — from formulation to financials.</p>
        </div>
        <div class="row g-4">
            <!-- PLM -->
            <div class="col-md-6 col-lg-4">
                <div class="df-module">
                    <div class="df-module-icon" style="background: linear-gradient(135deg,#6366f1,#4f46e5);">
                        <i class="bi bi-droplet-half"></i>
                    </div>
                    <h5>Product Lifecycle</h5>
                    <p>Define dairy products, manage formulations with BOM structures, and track lifecycle stages from development to production.</p>
                    <ul class="df-module-features">
                        <li><i class="bi bi-check-circle-fill"></i> Product record management</li>
                        <li><i class="bi bi-check-circle-fill"></i> Formulation &amp; BOM builder</li>
                        <li><i class="bi bi-check-circle-fill"></i> Stage-gate lifecycle tracking</li>
                    </ul>
                    <i class="bi bi-arrow-left-right df-module-watermark"></i>
                </div>
            </div>
            <!-- Production -->
            <div class="col-md-6 col-lg-4">
                <div class="df-module">
                    <div class="df-module-icon" style="background: linear-gradient(135deg,#f59e0b,#d97706);">
                        <i class="bi bi-gear-wide-connected"></i>
                    </div>
                    <h5>Production</h5>
                    <p>Schedule production batches, track raw material consumption, manage suppliers, and monitor real-time batch progress.</p>
                    <ul class="df-module-features">
                        <li><i class="bi bi-check-circle-fill"></i> Batch scheduling &amp; tracking</li>
                        <li><i class="bi bi-check-circle-fill"></i> Supplier management</li>
                        <li><i class="bi bi-check-circle-fill"></i> Raw material consumption</li>
                    </ul>
                    <i class="bi bi-gear-fill df-module-watermark"></i>
                </div>
            </div>
            <!-- QM -->
            <div class="col-md-6 col-lg-4">
                <div class="df-module">
                    <div class="df-module-icon" style="background: linear-gradient(135deg,var(--df-accent),var(--df-accent-dark));">
                        <i class="bi bi-clipboard2-pulse-fill"></i>
                    </div>
                    <h5>Quality Management</h5>
                    <p>Run quality inspections on every batch, log non-conformances, and enforce compliance standards before release.</p>
                    <ul class="df-module-features">
                        <li><i class="bi bi-check-circle-fill"></i> Batch-level inspections</li>
                        <li><i class="bi bi-check-circle-fill"></i> Non-conformance logging</li>
                        <li><i class="bi bi-check-circle-fill"></i> Pass/fail compliance gates</li>
                    </ul>
                    <i class="bi bi-patch-check-fill df-module-watermark"></i>
                </div>
            </div>
            <!-- Inventory -->
            <div class="col-md-6 col-lg-4">
                <div class="df-module">
                    <div class="df-module-icon" style="background: linear-gradient(135deg,#ec4899,#db2777);">
                        <i class="bi bi-box-seam-fill"></i>
                    </div>
                    <h5>Inventory</h5>
                    <p>Track finished goods stock levels in real time. Monitor quantities, manage warehouse visibility, and prevent shortfalls.</p>
                    <ul class="df-module-features">
                        <li><i class="bi bi-check-circle-fill"></i> Real-time stock levels</li>
                        <li><i class="bi bi-check-circle-fill"></i> Product-level tracking</li>
                        <li><i class="bi bi-check-circle-fill"></i> Low-stock alerts</li>
                    </ul>
                    <i class="bi bi-box-seam df-module-watermark"></i>
                </div>
            </div>
            <!-- Finance -->
            <div class="col-md-6 col-lg-4">
                <div class="df-module">
                    <div class="df-module-icon" style="background: linear-gradient(135deg,var(--df-primary),var(--df-primary-dark));">
                        <i class="bi bi-calculator-fill"></i>
                    </div>
                    <h5>Finance</h5>
                    <p>Manage budgets, track expenses, generate invoices, and monitor cost performance across all production operations.</p>
                    <ul class="df-module-features">
                        <li><i class="bi bi-check-circle-fill"></i> Budget &amp; expense tracking</li>
                        <li><i class="bi bi-check-circle-fill"></i> Invoice generation</li>
                        <li><i class="bi bi-check-circle-fill"></i> Journal entries &amp; reporting</li>
                    </ul>
                    <i class="bi bi-pie-chart-fill df-module-watermark"></i>
                </div>
            </div>
            <!-- Equipment -->
            <div class="col-md-6 col-lg-4">
                <div class="df-module">
                    <div class="df-module-icon" style="background: linear-gradient(135deg,#64748b,#475569);">
                        <i class="bi bi-wrench-adjustable"></i>
                    </div>
                    <h5>Equipment</h5>
                    <p>Maintain an equipment registry, schedule preventive maintenance, and track operational status of all plant assets.</p>
                    <ul class="df-module-features">
                        <li><i class="bi bi-check-circle-fill"></i> Equipment registry</li>
                        <li><i class="bi bi-check-circle-fill"></i> Maintenance scheduling</li>
                        <li><i class="bi bi-check-circle-fill"></i> Status &amp; cost tracking</li>
                    </ul>
                    <i class="bi bi-wrench df-module-watermark"></i>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ═══════════════ WHY DAIRYFLOW ═══════════════ -->
