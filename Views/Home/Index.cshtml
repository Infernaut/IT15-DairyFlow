                    <div class="df-why-bullet" style="background: linear-gradient(135deg,#f59e0b,#d97706);">
                        <i class="bi bi-graph-up-arrow"></i>
                    </div>
                    <div>
                        <h6>Integrated Financial Visibility</h6>
                        <p>See production costs, expenses, and revenue in one place. Make data-driven decisions with unified reporting.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ═══════════════ CTA BANNER ═══════════════ -->
<section class="df-section">
    <div class="container">
        <div class="df-cta-banner">
            <div class="row align-items-center position-relative" style="z-index:1;">
                <div class="col-lg-7 mb-3 mb-lg-0">
                    <h3 class="mb-2">Ready to modernize your dairy operations?</h3>
                    <p class="mb-0">Start with a 14-day free trial — no credit card required. Full access to all modules.</p>
                </div>
                <div class="col-lg-5">
                    <div class="d-flex gap-3 justify-content-lg-end">
