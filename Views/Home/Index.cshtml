@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager

@{
    ViewData["Title"] = "DairyFlow ERP | Integrated Dairy Manufacturing System";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>
    :root {
        --blue-main: #0d6efd;
        --blue-soft: #4dabf7;
        --blue-sky: #e7f3ff;
        --blue-deep: #0b5ed7;
        --border-soft: #dbe7f3;
        --text-muted: #6c757d;
    }

    /* Hide scrollbars but allow scrolling */
    main[role="main"]::-webkit-scrollbar {
        display: none;
    }

    main[role="main"] {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }

    body {
        background: linear-gradient(180deg, #f8fbff, #eef6ff);
    }

    /* GUEST VIEW STYLES */
    .erp-header {
        background: linear-gradient(135deg, #ffffff, var(--blue-sky));
        border-radius: 24px;
        border: 1px solid var(--border-soft);
        position: relative;
        overflow: hidden;
    }

    .float-soft {
        animation: floatSoft 5s ease-in-out infinite;
    }

    @@keyframes floatSoft {
        0%, 100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(6px);
        }
    }

    .erp-stat {
        background: linear-gradient(180deg, #ffffff, #f4f9ff);
        border-left: 5px solid var(--blue-soft);
        border-radius: 14px;
        position: relative;
        overflow: hidden;
    }

    .module-card {
        border: 1px solid var(--border-soft);
        border-radius: 18px;
        background: linear-gradient(180deg, #ffffff, #f6fbff);
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }

    .module-icon {
        width: 58px;
        height: 58px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.8rem;
        background: linear-gradient(135deg, var(--blue-soft), var(--blue-main));
        color: white !important;
    }

    .module-watermark {
        position: absolute;
        bottom: -12px;
        right: -12px;
        font-size: 7rem;
        opacity: 0.06;
        pointer-events: none;
    }
</style>

<div class="container py-5">
    @if (SignInManager.IsSignedIn(User))
    {
        <partial name="_DashboardPartial" />
    }
    else
    {
        <div class="erp-header p-5 mb-5 shadow-sm">
            <div class="row align-items-center">
                <div class="col-lg-8">
                    <span class="badge bg-primary mb-3 px-3 py-2 rounded-pill text-white">
                        Enterprise Resource Planning v3.0
                    </span>
                    <h1 class="fw-bold display-5 text-primary mb-3">DairyFlow ERP</h1>
                    <p class="fs-5 text-muted mb-4">
                        A centralized ERP platform for dairy manufacturers integrating
                        lifecycle management, quality assurance, and financial control
                        with full batch traceability.
                    </p>
                    <div class="d-flex gap-3">
                        <a href="#modules" class="btn btn-primary btn-lg px-4">Explore Modules</a>
                        <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-outline-primary btn-lg px-4">Login to System</a>
                    </div>
                </div>
                <div class="col-lg-4 text-center mt-4 mt-lg-0">
                    <div class="float-soft">
                        <i class="bi bi-diagram-3-fill text-primary" style="font-size:7.5rem;"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4 mb-5">
            <div class="col-md-4">
                <div class="erp-stat p-4 shadow-sm">
                    <h6 class="text-muted">Production Control</h6>
                    <p class="fw-semibold mb-0 text-primary">End-to-End Batch Tracking</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="erp-stat p-4 shadow-sm">
                    <h6 class="text-muted">Quality Compliance</h6>
                    <p class="fw-semibold mb-0 text-primary">Inspection Workflows</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="erp-stat p-4 shadow-sm">
                    <h6 class="text-muted">Financial Transparency</h6>
                    <p class="fw-semibold mb-0 text-primary">Cost & Yield Monitoring</p>
                </div>
            </div>
        </div>

        <div id="modules">
            <h2 class="fw-bold text-primary mb-4">Core ERP Modules</h2>
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="module-card h-100 p-4">
                        <div class="module-icon mb-3"><i class="bi bi-droplet-half"></i></div>
                        <h5 class="fw-semibold">PLM</h5>
                        <p class="text-muted small">Product records and BOM structures.</p>
                        <i class="bi bi-arrow-left-right module-watermark"></i>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="module-card h-100 p-4">
                        <div class="module-icon mb-3"><i class="bi bi-clipboard2-pulse-fill"></i></div>
                        <h5 class="fw-semibold">Quality</h5>
                        <p class="text-muted small">Batch approvals and compliance.</p>
                        <i class="bi bi-patch-check-fill module-watermark"></i>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="module-card h-100 p-4">
                        <div class="module-icon mb-3"><i class="bi bi-calculator-fill"></i></div>
                        <h5 class="fw-semibold">Finance</h5>
                        <p class="text-muted small">Costing and performance reporting.</p>
                        <i class="bi bi-pie-chart-fill module-watermark"></i>
                    </div>
                </div>
            </div>
        </div>
    }
</div>