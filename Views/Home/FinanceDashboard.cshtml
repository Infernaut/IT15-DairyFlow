@model IT15_DairyFlow.Models.Admin.FinanceDashboardViewModel

@{
    ViewData["Title"] = "Finance Dashboard";
}

<style>
    .bg-soft-success { background-color: #e6fcf5; }
    .bg-soft-danger { background-color: #fff5f5; }
    .bg-soft-warning { background-color: #fff8e1; }
    .bg-soft-primary { background-color: #f0f7ff; }
    .bg-soft-info { background-color: #e8f4fd; }
    .fin-stat {
        border-radius: 14px; border: 1px solid #dbe7f3;
        background: #fff; transition: transform 0.2s ease;
    }
    .fin-stat:hover { transform: translateY(-3px); }
    .fin-icon {
        width: 42px; height: 42px; border-radius: 10px;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.2rem;
    }
</style>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">Finance Dashboard</h2>
            <p class="text-muted small mb-0">Revenue, expenses, budget utilization, and financial trends for @User.Identity?.Name</p>
        </div>
        <span class="badge bg-light text-info border border-info px-3 py-2">
            <i class="bi bi-calculator me-1"></i> Finance Control
        </span>
    </div>

    <!-- KPI Cards Row 1: Revenue & Profit -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="fin-stat p-3 shadow-sm" style="border-left: 5px solid #198754;">
                <div class="d-flex justify-content-between">
                    <div>
                        <p class="text-muted small fw-bold text-uppercase mb-1">Total Revenue</p>
                        <h2 class="fw-bold text-success mb-0">₱@Model.TotalRevenue.ToString("N0")</h2>
                        <span class="text-muted small">Paid invoices</span>
                    </div>
                    <div class="fin-icon bg-soft-success text-success"><i class="bi bi-cash-stack"></i></div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="fin-stat p-3 shadow-sm" style="border-left: 5px solid #dc3545;">
                <div class="d-flex justify-content-between">
                    <div>
                        <p class="text-muted small fw-bold text-uppercase mb-1">Total Expenses</p>
                        <h2 class="fw-bold text-danger mb-0">₱@Model.TotalExpenses.ToString("N0")</h2>
                        <span class="text-muted small">All categories</span>
                    </div>
                    <div class="fin-icon bg-soft-danger text-danger"><i class="bi bi-receipt-cutoff"></i></div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="fin-stat p-3 shadow-sm" style="border-left: 5px solid @(Model.NetProfit >= 0 ? "#198754" : "#dc3545");">
                <div class="d-flex justify-content-between">
                    <div>
                        <p class="text-muted small fw-bold text-uppercase mb-1">Net Profit</p>
                        <h2 class="fw-bold mb-0 @(Model.NetProfit >= 0 ? "text-success" : "text-danger")">₱@Model.NetProfit.ToString("N0")</h2>
                        <span class="@(Model.NetProfit >= 0 ? "text-success" : "text-danger") small fw-medium">
                            <i class="bi @(Model.NetProfit >= 0 ? "bi-arrow-up-short" : "bi-arrow-down-short")"></i>
                            Revenue − Expenses
                        </span>
                    </div>
                    <div class="fin-icon @(Model.NetProfit >= 0 ? "bg-soft-success text-success" : "bg-soft-danger text-danger")"><i class="bi bi-graph-up-arrow"></i></div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="fin-stat p-3 shadow-sm" style="border-left: 5px solid #0d6efd;">
                <div class="d-flex justify-content-between">
                    <div>
                        <p class="text-muted small fw-bold text-uppercase mb-1">Budget Utilization</p>
                        <h2 class="fw-bold text-primary mb-0">@Model.BudgetUtilization%</h2>
                        <span class="text-muted small">₱@Model.ExpensesMTD.ToString("N0") of ₱@Model.TotalBudget.ToString("N0")</span>
                    </div>
                    <div class="fin-icon bg-soft-primary text-primary"><i class="bi bi-pie-chart-fill"></i></div>
                </div>
            </div>
        </div>
    </div>

    <!-- KPI Cards Row 2: Invoices -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="fin-stat p-3 shadow-sm" style="border-left: 5px solid #6610f2;">
                <div class="d-flex justify-content-between">
                    <div>
                        <p class="text-muted small fw-bold text-uppercase mb-1">Total Invoices</p>
                        <h2 class="fw-bold mb-0" style="color: #6610f2;">@Model.TotalInvoices</h2>
                        <span class="text-muted small">All invoices</span>
                    </div>
                    <div class="fin-icon" style="background: #f3eeff; color: #6610f2;"><i class="bi bi-file-earmark-text"></i></div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="fin-stat p-3 shadow-sm" style="border-left: 5px solid #20c997;">
                <div class="d-flex justify-content-between">
                    <div>
                        <p class="text-muted small fw-bold text-uppercase mb-1">Paid Invoices</p>
                        <h2 class="fw-bold mb-0" style="color: #20c997;">@Model.PaidInvoices</h2>
                        <span class="text-muted small">Completed payments</span>
                    </div>
                    <div class="fin-icon" style="background: #e6fcf5; color: #20c997;"><i class="bi bi-check2-circle"></i></div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="fin-stat p-3 shadow-sm" style="border-left: 5px solid #fd7e14;">
                <div class="d-flex justify-content-between">
                    <div>
                        <p class="text-muted small fw-bold text-uppercase mb-1">Pending Invoices</p>
                        <h2 class="fw-bold mb-0" style="color: #fd7e14;">@Model.PendingInvoices</h2>
                        <span class="text-muted small">Awaiting payment</span>
                    </div>
                    <div class="fin-icon" style="background: #fff4e6; color: #fd7e14;"><i class="bi bi-hourglass-split"></i></div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="fin-stat p-3 shadow-sm" style="border-left: 5px solid #dc3545;">
                <div class="d-flex justify-content-between">
                    <div>
                        <p class="text-muted small fw-bold text-uppercase mb-1">Pending Amount</p>
                        <h2 class="fw-bold text-danger mb-0">₱@Model.PendingAmount.ToString("N0")</h2>
                        <span class="text-danger small fw-medium">Outstanding receivables</span>
                    </div>
                    <div class="fin-icon bg-soft-danger text-danger"><i class="bi bi-exclamation-diamond"></i></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Row -->
    <div class="row g-4 mb-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm p-4 h-100">
                <h6 class="fw-bold mb-3">Revenue vs Expenses (Last 6 Months)</h6>
                <div style="height: 280px;">
                    <canvas id="finTrendChart"></canvas>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm p-4 h-100">
                <h6 class="fw-bold mb-3">Expense Breakdown</h6>
                <div style="height: 200px;">
                    <canvas id="finExpenseChart"></canvas>
                </div>
                <div class="mt-3">
                    @{
                        var expTotal = Model.SupplierExpenses + Model.EquipmentCosts + Model.OtherExpenses;
                        var supplierPct = expTotal > 0 ? Math.Round(Model.SupplierExpenses / expTotal * 100, 0) : 0;
                        var equipPct = expTotal > 0 ? Math.Round(Model.EquipmentCosts / expTotal * 100, 0) : 0;
                        var otherPct = expTotal > 0 ? (100 - supplierPct - equipPct) : 0;
                    }
                    <div class="mb-2">
                        <small class="text-muted d-block">Supplier (@supplierPct%)</small>
                        <div class="progress" style="height: 6px;"><div class="progress-bar bg-primary" style="width: @supplierPct%"></div></div>
                    </div>
                    <div class="mb-2">
                        <small class="text-muted d-block">Equipment (@equipPct%)</small>
                        <div class="progress" style="height: 6px;"><div class="progress-bar bg-info" style="width: @equipPct%"></div></div>
                    </div>
                    <div>
                        <small class="text-muted d-block">Other (@otherPct%)</small>
                        <div class="progress" style="height: 6px;"><div class="progress-bar bg-secondary" style="width: @otherPct%"></div></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Budget Overview -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-4 text-center h-100">
                <p class="text-muted small fw-bold text-uppercase mb-1">Monthly Budget</p>
                <h3 class="fw-bold text-primary mb-1">₱@Model.TotalBudget.ToString("N0")</h3>
                <small class="text-muted">Allocated this period</small>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-4 text-center h-100">
                <p class="text-muted small fw-bold text-uppercase mb-1">Spent (MTD)</p>
                <h3 class="fw-bold text-danger mb-1">₱@Model.ExpensesMTD.ToString("N0")</h3>
                <small class="text-muted">Month-to-date expenses</small>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-4 text-center h-100">
                <p class="text-muted small fw-bold text-uppercase mb-1">Budget Remaining</p>
                <h3 class="fw-bold @(Model.BudgetRemaining >= 0 ? "text-success" : "text-danger") mb-1">₱@Model.BudgetRemaining.ToString("N0")</h3>
                <small class="text-muted">@(Model.BudgetRemaining >= 0 ? "Available to spend" : "Over budget")</small>
            </div>
        </div>
    </div>

    <!-- Finance Audit Trail -->
    <div class="card border-0 shadow-sm overflow-hidden">
        <div class="p-4 border-bottom bg-white">
            <h6 class="fw-bold mb-0">Finance Audit Trail</h6>
        </div>
        @if (Model.RecentAuditLogs.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr class="small text-uppercase text-muted">
                            <th class="ps-4">Activity</th>
                            <th>Staff</th>
                            <th>Module</th>
                            <th>Time</th>
                            <th class="text-end pe-4">Status</th>
                        </tr>
                    </thead>
                    <tbody class="small">
                        @foreach (var log in Model.RecentAuditLogs)
                        {
                            <tr>
                                <td class="ps-4 fw-bold">@log.Activity</td>
                                <td>@log.Staff</td>
                                <td>@log.Module</td>
                                <td>@log.TimeAgo</td>
                                <td class="text-end pe-4"><span class="badge rounded-pill @log.StatusClass px-3">@log.StatusLabel</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center text-muted py-5">
                <i class="bi bi-journal display-4 d-block mb-3 opacity-25"></i>
                <p class="mb-0">No finance-related activity yet.</p>
            </div>
        }
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
    // Revenue vs Expenses Line Chart
    (function () {
        const ctx = document.getElementById('finTrendChart');
        if (!ctx) return;
        new Chart(ctx, {
            type: 'line',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TrendLabels)),
                datasets: [
                    { label: 'Revenue', data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TrendRevenue)), borderColor: '#198754', backgroundColor: 'rgba(25,135,84,0.1)', fill: true, tension: 0.4, pointRadius: 4, pointBackgroundColor: '#198754' },
                    { label: 'Expenses', data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TrendExpenses)), borderColor: '#dc3545', backgroundColor: 'rgba(220,53,69,0.1)', fill: true, tension: 0.4, pointRadius: 4, pointBackgroundColor: '#dc3545' }
                ]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                plugins: { legend: { position: 'bottom', labels: { font: { size: 11 } } } },
                scales: { y: { beginAtZero: true } }
            }
        });
    })();

    // Expense Breakdown Doughnut
    (function () {
        const ctx = document.getElementById('finExpenseChart');
        if (!ctx) return;
        new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: ['Supplier', 'Equipment', 'Other'],
                datasets: [{ data: [@Model.SupplierExpenses, @Model.EquipmentCosts, @Model.OtherExpenses], backgroundColor: ['#0d6efd', '#0dcaf0', '#6c757d'], borderWidth: 0 }]
            },
            options: { responsive: true, maintainAspectRatio: false, cutout: '65%', plugins: { legend: { display: false } } }
        });
    })();
</script>
