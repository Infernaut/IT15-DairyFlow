@using IT15_DairyFlow.Models.Admin
@model List<SuperAdminUserListItemViewModel>

@{
    ViewData["Title"] = "All Users";
    Layout = "_Layout";
}

<div class="container-fluid p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1 fw-bold">All Users</h2>
            <p class="text-muted mb-0">Global user management across all companies.</p>
        </div>
        <span class="badge bg-primary fs-6">@Model.Count Users</span>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="px-4">User</th>
                            <th>Company</th>
                            <th>Roles</th>
                            <th class="text-center">Status</th>
                            <th class="text-end px-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            var isSuperadmin = user.Roles.Contains("Superadmin");
                            <tr>
                                <td class="px-4">
                                    <div class="fw-semibold">@user.UserName</div>
                                    <small class="text-muted">@user.Email</small>
                                </td>
                                <td><span class="badge bg-light text-dark">@user.CompanyName</span></td>
                                <td>
                                    @foreach (var role in user.Roles.Split(',', StringSplitOptions.TrimEntries))
                                    {
                                        var roleBadge = role switch
                                        {
                                            "Superadmin" => "bg-danger",
                                            "Admin" => "bg-warning text-dark",
                                            "None" => "bg-secondary",
                                            _ => "bg-primary"
                                        };
                                        <span class="badge @roleBadge me-1">@role</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (user.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactive</span>
                                    }
                                </td>
                                <td class="text-end px-4">
                                    <div class="d-flex gap-1 justify-content-end">
                                        <a href="@Url.Action("UserRoles", new { id = user.Id })" class="btn btn-sm btn-outline-primary" title="Manage Roles">
                                            <i class="bi bi-person-gear"></i>
                                        </a>
                                        @if (!isSuperadmin)
                                        {
                                            <form asp-action="ToggleUserStatus" asp-route-id="@user.Id" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm @(user.IsActive ? "btn-outline-danger" : "btn-outline-success")" title="@(user.IsActive ? "Deactivate" : "Activate")">
                                                    <i class="bi @(user.IsActive ? "bi-person-dash" : "bi-person-check")"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
