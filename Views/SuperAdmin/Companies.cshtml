@using IT15_DairyFlow.Models.Admin
@model CompaniesPageViewModel

@{
    ViewData["Title"] = "Companies";
    Layout = "_Layout";
}

<div class="container-fluid p-4">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1 fw-bold">Companies</h2>
            <p class="text-muted mb-0">Customer roster and tenant lifecycle management.</p>
        </div>
        <div class="d-flex gap-2 align-items-center">
            <span class="badge bg-primary fs-6">@Model.Companies.Count Companies</span>
            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addCompanyModal">
                <i class="bi bi-plus-circle me-1"></i> Add Company
            </button>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            @if (Model.Companies.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" aria-label="Companies list">
                        <thead class="table-light">
                            <tr>
                                <th class="px-4" scope="col">Company</th>
                                <th scope="col">Status</th>
                                <th scope="col">Plan</th>
                                <th scope="col">Billing</th>
                                <th class="text-end" scope="col">Price</th>
                                <th class="text-center" scope="col">Users</th>
                                <th class="text-center" scope="col">Days Left</th>
                                <th class="text-end px-4" scope="col">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var company in Model.Companies)
                            {
                                var statusBadge = company.Status switch
                                {
                                    "Active" => "bg-success",
                                    "Trial" => "bg-warning text-dark",
                                    "FreeTrial" => "bg-warning text-dark",
                                    "Inactive" => "bg-secondary",
                                    _ => "bg-light text-dark"
                                };
                                <tr>
                                    <td class="px-4">
                                        <div class="fw-semibold">@company.CompanyName</div>
                                        @if (company.SubscriptionStartDate.HasValue)
                                        {
                                            <small class="text-muted">Since @company.SubscriptionStartDate.Value.ToString("MMM dd, yyyy")</small>
                                        }
                                    </td>
                                    <td><span class="badge @statusBadge">@company.Status</span></td>
                                    <td>@company.SubscriptionPlan</td>
                                    <td>@company.BillingCycle</td>
                                    <td class="text-end">₱@company.Price.ToString("N2")</td>
                                    <td class="text-center"><span class="badge bg-primary-subtle text-primary">@company.UserCount</span></td>
                                    <td class="text-center">
                                        @if (company.RemainingDays.HasValue)
                                        {
                                            var daysLeft = company.RemainingDays.Value;
                                            var daysBadge = daysLeft <= 7 ? "bg-danger" : daysLeft <= 14 ? "bg-warning text-dark" : "bg-success-subtle text-success";
                                            <span class="badge @daysBadge">
                                                @(daysLeft == 0 ? "Expired" : $"{daysLeft} days")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">—</span>
                                        }
                                    </td>
                                    <td class="text-end px-4">
                                        <form asp-action="ToggleCompanyStatus" asp-route-id="@company.CompanyID" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm @(company.Status == "Active" ? "btn-outline-danger" : "btn-outline-success")" aria-label="@(company.Status == "Active" ? "Deactivate" : "Activate") @company.CompanyName">
                                                <i class="bi @(company.Status == "Active" ? "bi-pause-circle" : "bi-play-circle") me-1"></i>
                                                @(company.Status == "Active" ? "Deactivate" : "Activate")
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center text-muted py-5">
                    <i class="bi bi-buildings display-4 d-block mb-3 opacity-25"></i>
                    <p class="mb-0">No companies registered yet.</p>
                </div>
            }
        </div>
    </div>
</div>

<!-- Add Company Modal -->
<div class="modal fade" id="addCompanyModal" tabindex="-1" aria-labelledby="addCompanyModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="AddCompany" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="addCompanyModalLabel">
                        <i class="bi bi-building-add text-primary me-2"></i>Add Company Manually
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted small mb-4">Create a new company with an admin account. The admin will be able to log in immediately.</p>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="AddCompany.CompanyName" class="form-label fw-semibold">Company Name <span class="text-danger">*</span></label>
                            <input asp-for="AddCompany.CompanyName" class="form-control" placeholder="e.g. Acme Dairy Co." required />
                            <span asp-validation-for="AddCompany.CompanyName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="AddCompany.SubscriptionID" class="form-label fw-semibold">Subscription Plan</label>
                            <select asp-for="AddCompany.SubscriptionID" class="form-select">
                                <option value="">— No Plan —</option>
                                @foreach (var sub in Model.SubscriptionOptions)
                                {
                                    <option value="@sub.SubscriptionID">@sub.DisplayName</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="AddCompany.Status" class="form-label fw-semibold">Status</label>
                            <select asp-for="AddCompany.Status" class="form-select">
                                <option value="Active">Active</option>
                                <option value="Trial">Trial</option>
                                <option value="FreeTrial">Free Trial</option>
                                <option value="Inactive">Inactive</option>
                                <option value="Pending">Pending</option>
                            </select>
                        </div>
                    </div>

                    <hr class="my-4" />
                    <h6 class="fw-semibold mb-3"><i class="bi bi-person-badge me-2 text-primary"></i>Admin Account</h6>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="AddCompany.AdminUserName" class="form-label fw-semibold">Username <span class="text-danger">*</span></label>
                            <input asp-for="AddCompany.AdminUserName" class="form-control" placeholder="admin_username" required />
                            <span asp-validation-for="AddCompany.AdminUserName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="AddCompany.AdminEmail" class="form-label fw-semibold">Email <span class="text-danger">*</span></label>
                            <input asp-for="AddCompany.AdminEmail" class="form-control" placeholder="admin@company.com" type="email" required />
                            <span asp-validation-for="AddCompany.AdminEmail" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="AddCompany.Password" class="form-label fw-semibold">Password <span class="text-danger">*</span></label>
                            <input asp-for="AddCompany.Password" class="form-control" type="password" required data-password-criteria="true" />
                            <span asp-validation-for="AddCompany.Password" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="AddCompany.ConfirmPassword" class="form-label fw-semibold">Confirm Password <span class="text-danger">*</span></label>
                            <input asp-for="AddCompany.ConfirmPassword" class="form-control" type="password" required />
                            <span asp-validation-for="AddCompany.ConfirmPassword" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-plus-circle me-1"></i> Create Company
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Re-initialize password criteria for modal fields after modal is shown
        document.getElementById('addCompanyModal')?.addEventListener('shown.bs.modal', function () {
            if (window.DairyFlowPassword) {
                DairyFlowPassword.init();
            }
        });
    </script>
}
