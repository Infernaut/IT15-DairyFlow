@using IT15_DairyFlow.Models.Admin
@model SuperAdminDashboardViewModel

@{
    ViewData["Title"] = "SuperAdmin Dashboard";
    Layout = "_Layout";
}

<div class="container-fluid p-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1 fw-bold">Platform Overview</h2>
            <p class="text-muted mb-0">SuperAdmin Dashboard &mdash; Global System Metrics</p>
        </div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("Users")" class="btn btn-outline-primary"><i class="bi bi-people me-1"></i> All Users</a>
            <a href="@Url.Action("Companies")" class="btn btn-primary"><i class="bi bi-buildings me-1"></i> Companies</a>
        </div>
    </div>

    <!-- KPI Cards Row 1 - Company & Revenue -->
    <div class="row g-4 mb-4">
        <div class="col-md-3 col-sm-6">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="rounded-circle bg-primary bg-opacity-10 p-3 me-3">
                            <i class="bi bi-buildings text-primary fs-4"></i>
                        </div>
                        <div>
                            <h6 class="text-muted mb-1 small text-uppercase">Total Companies</h6>
                            <h3 class="mb-0 fw-bold">@Model.TotalCompanies</h3>
                        </div>
                    </div>
                    <div class="d-flex gap-2">
                        <span class="badge bg-success-subtle text-success">@Model.ActiveCompanies Active</span>
                        <span class="badge bg-warning-subtle text-warning">@Model.TrialCompanies Trial</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="rounded-circle bg-success bg-opacity-10 p-3 me-3">
                            <i class="bi bi-receipt-cutoff text-success fs-4"></i>
                        </div>
                        <div>
                            <h6 class="text-muted mb-1 small text-uppercase">Subscriptions</h6>
                            <h3 class="mb-0 fw-bold">@Model.ActiveSubscriptions</h3>
                        </div>
                    </div>
                    <small class="text-muted">Active subscription plans</small>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="rounded-circle bg-danger bg-opacity-10 p-3 me-3">
                            <i class="bi bi-cash-stack text-danger fs-4"></i>
                        </div>
                        <div>
                            <h6 class="text-muted mb-1 small text-uppercase">Monthly Revenue</h6>
                            <h3 class="mb-0 fw-bold">₱@Model.MonthlyRecurringRevenue.ToString("N0")</h3>
                        </div>
                    </div>
                    <small class="text-muted">Recurring subscription value</small>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="rounded-circle bg-info bg-opacity-10 p-3 me-3">
                            <i class="bi bi-people-fill text-info fs-4"></i>
                        </div>
                        <div>
                            <h6 class="text-muted mb-1 small text-uppercase">Total Users</h6>
                            <h3 class="mb-0 fw-bold">@Model.TotalUsers</h3>
                        </div>
                    </div>
                    <div class="d-flex gap-2">
                        <span class="badge bg-success-subtle text-success">@Model.ActiveUsers Active</span>
                        <span class="badge bg-info-subtle text-info">@Model.AdminUsers Admins</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- KPI Cards Row 2 - Operations -->
    <div class="row g-4 mb-4">
        <div class="col-lg-4">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-header bg-transparent border-0 pb-0">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-gear-fill text-primary me-2"></i>
                        <h6 class="mb-0 fw-semibold">Production</h6>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row text-center">
                        <div class="col-4">
                            <h4 class="fw-bold text-primary mb-1">@Model.TotalBatches</h4>
                            <small class="text-muted">Total</small>
                        </div>
                        <div class="col-4">
                            <h4 class="fw-bold text-success mb-1">@Model.CompletedBatches</h4>
                            <small class="text-muted">Done</small>
                        </div>
                        <div class="col-4">
                            <h4 class="fw-bold text-warning mb-1">@(Model.TotalBatches - Model.CompletedBatches)</h4>
                            <small class="text-muted">Active</small>
                        </div>
                    </div>
                    @if (Model.TotalBatches > 0)
                    {
                        <hr>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="text-muted">Completion Rate</span>
                            <span class="badge bg-primary-subtle text-primary">@((Model.CompletedBatches * 100.0 / Model.TotalBatches).ToString("F1"))%</span>
                        </div>
                    }
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-header bg-transparent border-0 pb-0">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-clipboard-check-fill text-success me-2"></i>
                        <h6 class="mb-0 fw-semibold">Quality Control</h6>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row text-center">
                        <div class="col-4">
                            <h4 class="fw-bold text-primary mb-1">@Model.TotalInspections</h4>
                            <small class="text-muted">Total</small>
                        </div>
                        <div class="col-4">
                            <h4 class="fw-bold text-success mb-1">@Model.PassedInspections</h4>
                            <small class="text-muted">Passed</small>
                        </div>
                        <div class="col-4">
                            <h4 class="fw-bold text-danger mb-1">@Model.FailedInspections</h4>
                            <small class="text-muted">Failed</small>
                        </div>
                    </div>
                    @if (Model.TotalInspections > 0)
                    {
                        <hr>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="text-muted">Pass Rate</span>
                            <span class="badge bg-success-subtle text-success">@((Model.PassedInspections * 100.0 / Model.TotalInspections).ToString("F1"))%</span>
                        </div>
                    }
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-header bg-transparent border-0 pb-0">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-currency-dollar text-success me-2"></i>
                        <h6 class="mb-0 fw-semibold">Financial Overview</h6>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row text-center">
                        <div class="col-4">
                            <h4 class="fw-bold text-success mb-1">₱@Model.TotalRevenue.ToString("N0")</h4>
                            <small class="text-muted">Revenue</small>
                        </div>
                        <div class="col-4">
                            <h4 class="fw-bold text-danger mb-1">₱@Model.TotalExpenses.ToString("N0")</h4>
                            <small class="text-muted">Expenses</small>
                        </div>
                        <div class="col-4">
                            <h4 class="fw-bold text-primary mb-1">@Model.TotalProducts</h4>
                            <small class="text-muted">Products</small>
                        </div>
                    </div>
                    <hr>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-muted">Inventory Items</span>
                        <span class="badge bg-info-subtle text-info">@Model.TotalInventoryItems</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Row -->
    <div class="row g-4 mb-4">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-transparent border-0 pb-0">
                    <h6 class="mb-0 fw-semibold"><i class="bi bi-bar-chart me-2 text-primary"></i>Monthly Production Batches</h6>
                </div>
                <div class="card-body">
                    <canvas id="monthlyBatchChart" height="280"></canvas>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-transparent border-0 pb-0">
                    <h6 class="mb-0 fw-semibold"><i class="bi bi-pie-chart me-2 text-success"></i>Quality Inspection Results</h6>
                </div>
                <div class="card-body d-flex align-items-center justify-content-center">
                    <canvas id="qualityPieChart" height="250"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Audit Logs -->
    <div class="row g-4">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-journal-text text-primary me-2"></i>
                        <h6 class="mb-0 fw-semibold">Recent Activity (All Companies)</h6>
                    </div>
                    <a href="@Url.Action("Logs")" class="btn btn-sm btn-outline-primary">View All</a>
                </div>
                <div class="card-body p-0">
                    @if (Model.RecentAuditLogs.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="px-4">User</th>
                                        <th>Company</th>
                                        <th>Action</th>
                                        <th class="text-end px-4">Timestamp</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var log in Model.RecentAuditLogs.Take(10))
                                    {
                                        <tr>
                                            <td class="px-4">
                                                <div class="fw-semibold">@log.UserName</div>
                                                <small class="text-muted">@log.UserEmail</small>
                                            </td>
                                            <td><span class="badge bg-light text-dark">@log.CompanyName</span></td>
                                            <td><span class="badge bg-primary-subtle text-primary">@log.Action</span></td>
                                            <td class="text-end px-4"><small class="text-muted">@log.FormattedTimeStamp</small></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center text-muted py-5">
                            <i class="bi bi-journal display-4 d-block mb-3 opacity-25"></i>
                            <p class="mb-0">No activity logs yet.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        // Monthly Batch Chart
        const batchCtx = document.getElementById('monthlyBatchChart').getContext('2d');
        new Chart(batchCtx, {
            type: 'bar',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyBatchLabels)),
                datasets: [{
                    label: 'Batches',
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyBatchCounts)),
                    backgroundColor: 'rgba(13, 110, 253, 0.7)',
                    borderColor: 'rgba(13, 110, 253, 1)',
                    borderWidth: 1,
                    borderRadius: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    y: { beginAtZero: true, ticks: { stepSize: 1 } }
                }
            }
        });

        // Quality Pie Chart
        const qualityCtx = document.getElementById('qualityPieChart').getContext('2d');
        new Chart(qualityCtx, {
            type: 'doughnut',
            data: {
                labels: ['Passed', 'Failed', 'Pending'],
                datasets: [{
                    data: [
                        @Model.PassedInspections,
                        @Model.FailedInspections,
                        @(Model.TotalInspections - Model.PassedInspections - Model.FailedInspections)
                    ],
                    backgroundColor: ['#198754', '#dc3545', '#ffc107'],
                    borderWidth: 0
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'bottom' }
                }
            }
        });
    </script>
}
