@using IT15_DairyFlow.Models.Admin
@model SuperAdminDashboardViewModel

@{
    ViewData["Title"] = "SuperAdmin Dashboard";
    Layout = "_Layout";
}

<div class="container-fluid p-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1 fw-bold">Platform Overview</h2>
            <p class="text-muted mb-0">SuperAdmin Dashboard &mdash; Subscription &amp; Company Metrics</p>
        </div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("Companies")" class="btn btn-primary"><i class="bi bi-buildings me-1"></i> Companies</a>
        </div>
    </div>

    <!-- KPI Cards -->
    <div class="row g-4 mb-4">
        <div class="col-md-3 col-sm-6">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="rounded-circle bg-primary bg-opacity-10 p-3 me-3">
                            <i class="bi bi-buildings text-primary fs-4"></i>
                        </div>
                        <div>
                            <h6 class="text-muted mb-1 small text-uppercase">Total Companies</h6>
                            <h3 class="mb-0 fw-bold">@Model.TotalCompanies</h3>
                        </div>
                    </div>
                    <div class="d-flex gap-2">
                        <span class="badge bg-success-subtle text-success">@Model.ActiveCompanies Active</span>
                        <span class="badge bg-warning-subtle text-warning">@Model.TrialCompanies Trial</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="rounded-circle bg-success bg-opacity-10 p-3 me-3">
                            <i class="bi bi-receipt-cutoff text-success fs-4"></i>
                        </div>
                        <div>
                            <h6 class="text-muted mb-1 small text-uppercase">Subscriptions</h6>
                            <h3 class="mb-0 fw-bold">@Model.ActiveSubscriptions</h3>
                        </div>
                    </div>
                    <small class="text-muted">Active subscription plans</small>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="rounded-circle bg-danger bg-opacity-10 p-3 me-3">
                            <i class="bi bi-cash-stack text-danger fs-4"></i>
                        </div>
                        <div>
                            <h6 class="text-muted mb-1 small text-uppercase">Monthly Revenue</h6>
                            <h3 class="mb-0 fw-bold">₱@Model.MonthlyRecurringRevenue.ToString("N0")</h3>
                        </div>
                    </div>
                    <small class="text-muted">Recurring subscription value</small>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="rounded-circle bg-info bg-opacity-10 p-3 me-3">
                            <i class="bi bi-people-fill text-info fs-4"></i>
                        </div>
                        <div>
                            <h6 class="text-muted mb-1 small text-uppercase">Total Users</h6>
                            <h3 class="mb-0 fw-bold">@Model.TotalUsers</h3>
                        </div>
                    </div>
                    <span class="badge bg-success-subtle text-success">@Model.ActiveUsers Active</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Row -->
    <div class="row g-4 mb-4">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-transparent border-0 pb-0">
                    <h6 class="mb-0 fw-semibold"><i class="bi bi-people me-2 text-primary"></i>Users per Company</h6>
                </div>
                <div class="card-body">
                    <canvas id="usersPerCompanyChart" height="280"></canvas>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-transparent border-0 pb-0">
                    <h6 class="mb-0 fw-semibold"><i class="bi bi-pie-chart me-2 text-success"></i>Subscription Plan Distribution</h6>
                </div>
                <div class="card-body d-flex align-items-center justify-content-center">
                    <canvas id="planDistChart" height="250"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Company Summary Table -->
    <div class="row g-4">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-transparent border-0 d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-buildings text-primary me-2"></i>
                        <h6 class="mb-0 fw-semibold">Company Overview</h6>
                    </div>
                    <a href="@Url.Action("Companies")" class="btn btn-sm btn-outline-primary">View All</a>
                </div>
                <div class="card-body p-0">
                    @if (Model.CompanyUserStats.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="px-4">Company</th>
                                        <th class="text-center">Users</th>
                                        <th>Subscription Plan</th>
                                        <th class="text-end px-4">Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var company in Model.CompanyUserStats)
                                    {
                                        var statusBadge = company.Status switch
                                        {
                                            "Active" => "bg-success",
                                            "Trial" => "bg-warning text-dark",
                                            "Inactive" => "bg-secondary",
                                            _ => "bg-light text-dark"
                                        };
                                        <tr>
                                            <td class="px-4 fw-semibold">@company.CompanyName</td>
                                            <td class="text-center">
                                                <span class="badge bg-primary-subtle text-primary">@company.UserCount</span>
                                            </td>
                                            <td>@company.SubscriptionPlan</td>
                                            <td class="text-end px-4">
                                                <span class="badge @statusBadge">@company.Status</span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center text-muted py-5">
                            <i class="bi bi-buildings display-4 d-block mb-3 opacity-25"></i>
                            <p class="mb-0">No companies registered yet.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        const companyLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CompanyUserStats.Select(c => c.CompanyName).ToList()));
        const companyUserCounts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CompanyUserStats.Select(c => c.UserCount).ToList()));
        const companyPlans = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CompanyUserStats.Select(c => c.SubscriptionPlan).ToList()));
        const colors = ['#0d6efd', '#198754', '#dc3545', '#ffc107', '#0dcaf0', '#6f42c1', '#fd7e14', '#20c997'];

        // Users per Company bar chart
        new Chart(document.getElementById('usersPerCompanyChart'), {
            type: 'bar',
            data: {
                labels: companyLabels,
                datasets: [{
                    label: 'Users',
                    data: companyUserCounts,
                    backgroundColor: colors.map(c => c + 'B3'),
                    borderColor: colors,
                    borderWidth: 1,
                    borderRadius: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } }
            }
        });

        // Subscription plan distribution doughnut
        const planCounts = {};
        companyPlans.forEach(p => { planCounts[p] = (planCounts[p] || 0) + 1; });
        new Chart(document.getElementById('planDistChart'), {
            type: 'doughnut',
            data: {
                labels: Object.keys(planCounts),
                datasets: [{
                    data: Object.values(planCounts),
                    backgroundColor: colors.slice(0, Object.keys(planCounts).length),
                    borderWidth: 0
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { position: 'bottom' } }
            }
        });
    </script>
}
