@using IT15_DairyFlow.Models.Admin
@model SuperAdminLogFilterViewModel

@{
    ViewData["Title"] = "Audit Logs";
    Layout = "_Layout";
}

<div class="container-fluid p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1 fw-bold">Audit Logs</h2>
            <p class="text-muted mb-0">Platform-wide activity tracking across all companies.</p>
        </div>
        <span class="badge bg-primary fs-6">@Model.TotalRecords Records</span>
    </div>

    <!-- Filter -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Start Date</label>
                    <input type="date" class="form-control" name="startDate" value="@Model.StartDate?.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold">End Date</label>
                    <input type="date" class="form-control" name="endDate" value="@Model.EndDate?.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Action Contains</label>
                    <input type="text" class="form-control" name="actionFilter" value="@Model.ActionFilter" placeholder="e.g. Created, Updated" />
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary"><i class="bi bi-funnel me-1"></i> Filter</button>
                    <a href="@Url.Action("Logs")" class="btn btn-outline-secondary">Reset</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Log Table -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            @if (Model.AuditLogs.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="px-4">User</th>
                                <th>Company</th>
                                <th>Action</th>
                                <th class="text-end px-4">Timestamp</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var log in Model.AuditLogs)
                            {
                                <tr>
                                    <td class="px-4">
                                        <div class="fw-semibold">@log.UserName</div>
                                        <small class="text-muted">@log.UserEmail</small>
                                    </td>
                                    <td><span class="badge bg-light text-dark">@log.CompanyName</span></td>
                                    <td><span class="badge bg-primary-subtle text-primary">@log.Action</span></td>
                                    <td class="text-end px-4"><small class="text-muted">@log.FormattedTimeStamp</small></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center text-muted py-5">
                    <i class="bi bi-journal display-4 d-block mb-3 opacity-25"></i>
                    <p class="mb-0">No audit logs found matching your criteria.</p>
                </div>
            }
        </div>
    </div>
</div>
