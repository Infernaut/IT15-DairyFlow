@using IT15_DairyFlow.Models.Admin
@model AnalyticsPageViewModel

@{
    ViewData["Title"] = "Usage Analytics";
    Layout = "_Layout";
}

<div class="container-fluid p-4">
    <div class="mb-4">
        <h2 class="mb-1 fw-bold">Usage Analytics</h2>
        <p class="text-muted mb-0">Per-company adoption, production volume, and financial comparison.</p>
    </div>

    <!-- Charts -->
    <div class="row g-4 mb-4">
        <div class="col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-transparent border-0 pb-0">
                    <h6 class="mb-0 fw-semibold"><i class="bi bi-people me-2 text-primary"></i>Users per Company</h6>
                </div>
                <div class="card-body">
                    <canvas id="userChart" height="280"></canvas>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-transparent border-0 pb-0">
                    <h6 class="mb-0 fw-semibold"><i class="bi bi-box-seam me-2 text-success"></i>Production Batches per Company</h6>
                </div>
                <div class="card-body">
                    <canvas id="batchChart" height="280"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-transparent border-0 pb-0">
                    <h6 class="mb-0 fw-semibold"><i class="bi bi-currency-dollar me-2 text-danger"></i>Revenue by Company</h6>
                </div>
                <div class="card-body">
                    <canvas id="revenueChart" height="200"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Data Table -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-transparent border-0 pb-0">
            <h6 class="mb-0 fw-semibold"><i class="bi bi-table me-2 text-primary"></i>Company Breakdown</h6>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="px-4">Company</th>
                            <th class="text-center">Users</th>
                            <th class="text-center">Products</th>
                            <th class="text-center">Batches</th>
                            <th class="text-center">Inspections</th>
                            <th class="text-center">Inventory</th>
                            <th class="text-end">Revenue</th>
                            <th class="text-end px-4">Expenses</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model.CompanyStats)
                        {
                            <tr>
                                <td class="px-4 fw-semibold">@c.CompanyName</td>
                                <td class="text-center">@c.UserCount</td>
                                <td class="text-center">@c.ProductCount</td>
                                <td class="text-center">@c.BatchCount</td>
                                <td class="text-center">@c.InspectionCount</td>
                                <td class="text-center">@c.InventoryCount</td>
                                <td class="text-end text-success">₱@c.TotalRevenue.ToString("N0")</td>
                                <td class="text-end px-4 text-danger">₱@c.TotalExpenses.ToString("N0")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        const labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CompanyLabels));
        const colors = ['#0d6efd', '#198754', '#dc3545', '#ffc107', '#0dcaf0', '#6f42c1', '#fd7e14', '#20c997'];

        new Chart(document.getElementById('userChart'), {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Users',
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CompanyUserCounts)),
                    backgroundColor: colors.map(c => c + 'B3'),
                    borderColor: colors,
                    borderWidth: 1, borderRadius: 6
                }]
            },
            options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } } }
        });

        new Chart(document.getElementById('batchChart'), {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Batches',
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CompanyBatchCounts)),
                    backgroundColor: colors.map(c => c + 'B3'),
                    borderColor: colors,
                    borderWidth: 1, borderRadius: 6
                }]
            },
            options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } } }
        });

        new Chart(document.getElementById('revenueChart'), {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Revenue (₱)',
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CompanyRevenues)),
                    backgroundColor: 'rgba(25, 135, 84, 0.7)',
                    borderColor: '#198754',
                    borderWidth: 1, borderRadius: 6
                }]
            },
            options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true } } }
        });
    </script>
}
